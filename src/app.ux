<script>
// third-party deps
import dayjs from "dayjs"

// local imports
import * as animengine from "./animation/engine"
import { BilibiliClient }  from "./bilibiliclient/client"
import * as tools from "./tools"
import * as articletools from "./articletools"
import * as funnytips from "./funnytips"
import * as settings from "./settings"
import * as jumpcheck from "./jumpcheck"
import * as htmlparser from "./htmlparser"
import * as savedcontent from "./savedcontent"
import * as downloadrecords from "./downloadrecords"
import * as bgimg from "./bgimg"
import * as usertracker from "./usertracker"
import logger from "./logger/logger"
import * as ui from "./ui/ui"
export default {
  dayjs: dayjs,
  tools: tools,
  funnytips: funnytips,
  jumpcheck: jumpcheck,
  articletools: articletools,
  htmlparser: htmlparser,
  bgimg: bgimg,
  async onCreate() {
    console.log("app created")

    console.log("create global logger")
    global.logger = logger

    console.log("create custom ui engine")
    global.ui = ui
    global.ui.Init()

    console.log("create global animengine")
    global.animengine = animengine

    console.log("appinit > loadSettings")
    // 先挂载模块对象再加载：避免冷启动 IO 慢时页面读到 undefined 的 global.settings
    // （SETTINGS 通过模块 live binding 更新，加载完成后各页面读到的即是已加载值）
    global.settings = settings
    // 框架调用 onCreate 后不会等待 async 完成，页面渲染与此处初始化是并发的；
    // 把 loadSettings 的 Promise 挂到全局，splash 等待它再判断协议同意状态
    global.settingsReady = settings.loadSettings()
    await global.settingsReady

    console.log("appinit > initSavedContentManager")
    await savedcontent.SavedContentManager.initialize()
    global.savedcontent = savedcontent

    console.log("appinit > initDownloadRecordManager")
    await downloadrecords.DownloadRecordManager.initialize()
    global.downloadrecords = downloadrecords

    console.log("appinit > initDeviceInfo")
    global.DEVICE_INFO = await tools.getDeviceInformation()
    global.DEVICE_SERIAL = await tools.getDeviceSerial()
    global.DEVICE_NETWORK_TYPE = await tools.getNetworkType()

    console.log("appinit > initBgImg")
    this.bgimg.Init()
    global.bgimg = this.bgimg

    console.log("appinit > createBiliClient")
    global.biliclient = new BilibiliClient()
  },
  onDestroy() {
    console.log("app destroyed")
  }
}
</script>