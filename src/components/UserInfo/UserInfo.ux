<template>
    <div style="flex-direction: column; align-items: center">
        <div class="profdiv">
            <image src="{{accountInfo.face}}@106w_106h" alt="/common/fullgray.png" class="profimg"></image>
            <image src="{{accountInfo.pendant.image}}@176w_176h" alt="/common/alphaimg.png" class="profpendantimg"></image>
        </div>
        <text class="{{name_text_class}}">{{ name }}</text>
        <div class="tagbar" style="margin-top: 5px">
            <image class="tagimg" src="/common/bililevel/lv{{level}}.png" style="height: 20px"></image>
            <!-- 等级入口按钮：进入等级详情页 -->
            <div class="levelentrybtn" if="{{levelEntry}}" @click="ViewLevel">
                <text class="levelentrybtn-text">›</text>
            </div>
            <image class="tagimg" if="{{is_vip}}" style="margin-left: 10px"
                src="/common/bilivip/{{vip_label_theme}}.png"></image>
            <image class="tagimg" if="{{is_senior_member}}" style="margin-left: 10px" src="/common/senior_member.png">
            </image>
        </div>
        <div class="statbar" if="{{showStat}}">
            <div class="stat-item" @click="ViewFollowings">
                <text class="stat-num">{{ followingText }}</text>
                <text class="stat-label">{{ $t("user.following") }}</text>
            </div>
            <div class="stat-item" @click="ViewFollowers">
                <text class="stat-num">{{ followerText }}</text>
                <text class="stat-label">{{ $t("user.follower") }}</text>
            </div>
            <div class="stat-item">
                <text class="stat-num">{{ likesText }}</text>
                <text class="stat-label">{{ $t("user.likes") }}</text>
            </div>
        </div>
        <!-- 硬币余额：nav 接口的 money 字段，只有登录账号自己的数据里有 -->
        <div class="coinbar" if="{{showCoin}}">
            <image class="coinicon" src="/common/vidtool_coin.png"></image>
            <text class="cointext">{{ coinText }}</text>
        </div>
    </div>
</template>

<script>
export default {
  props: ["accountInfo", "stat", "levelEntry"],
  data: {
    name_text_class: "name",
    is_vip: false,
    vip_label_theme: 1,
    is_senior_member: false,
    name: "",
    level: "",
    showStat: false,
    showCoin: false,
    coinText: "0",
    followingText: "0",
    followerText: "0",
    likesText: "0"
  },
  ViewFollowings() {
    this.$emit("viewfollowings")
  },
  ViewFollowers() {
    this.$emit("viewfollowers")
  },
  ViewLevel() {
    this.$emit("viewlevel")
  },
  UpdateShow() {
    try{
      // 大会员标识兼容两种数据源：
      // 我的页（nav 接口）：vip_pay_type / vip_label.label_theme
      // 他人主页（space acc/info 接口）：vip.vipStatus / vip.label.label_theme
      const spaceVip = this.accountInfo.vip || {}
      this.is_vip = !!this.accountInfo.vip_pay_type || spaceVip.vipStatus === 1
      this.vip_label_theme =
        (this.accountInfo.vip_label && this.accountInfo.vip_label.label_theme) ||
        (spaceVip.label && spaceVip.label.label_theme) ||
        1
      this.name_text_class = this.is_vip ? "vipname" : "name"

      this.is_senior_member = !!this.accountInfo.is_senior_member


      console.log(this.accountInfo.level_info?.current_level)
      console.log(this.accountInfo.level)
      this.level = this.accountInfo.level_info?.current_level || this.accountInfo.level

      this.name = this.accountInfo.uname || this.accountInfo.name

      const fmt = this.$app.$def.tools.formatNumber
      if(this.stat && (this.stat.following !== undefined || this.stat.follower !== undefined || this.stat.likes !== undefined)){
        this.showStat = true
        this.followingText = fmt(this.stat.following || 0)
        this.followerText = fmt(this.stat.follower || 0)
        this.likesText = fmt(this.stat.likes || 0)
      }

      // 硬币余额（money 可能带小数如 334.3，整数时不显示小数位）
      if(this.accountInfo.money !== undefined && this.accountInfo.money !== null){
        this.showCoin = true
        const money = Number(this.accountInfo.money)
        this.coinText = (money % 1 === 0) ? String(money) : money.toFixed(1)
      }
    }
    catch(error){
      global.logger.error("Error when updating show:", error.toString())
    }
  },
  onStatChange(newV, oldV) {
    if(newV && (newV.following !== undefined || newV.follower !== undefined || newV.likes !== undefined)){
      const fmt = this.$app.$def.tools.formatNumber
      this.showStat = true
      this.followingText = fmt(newV.following || 0)
      this.followerText = fmt(newV.follower || 0)
      this.likesText = fmt(newV.likes || 0)
    }
  },
  onInit() {
    this.UpdateShow()
    this.$watch("stat", "onStatChange")
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./UserInfo.less";
</style>