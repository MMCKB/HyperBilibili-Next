                  <input class="calbtn02" type="button" value="{{item}}" @click="onRsSelect(item)" />
                </div>
              </list-item>
            </list>
          </div>
          <img static style="margin-top:5px" src="./assets/horizontal/up2.png" @click="onBtnClick('down')" />
        </div>
        <!-- 方屏键盘切换面板：仅中部的 scroll 响应横向滚动，左右各留 12px 边缘让出系统右滑返回手势。 -->
        <div class="rect-overlay" if="{{rectPanel==='switch'}}">
          <scroll id="rectModeScroll" class="rect-mode-scroll" scroll-x="{{true}}" style="width:{{screenWidth - 24}}px;">
            <div class="rect-mode-menu">
              <text class="rect-mode-button" style="background-color:{{lang==='cn' && rectKeyboardtype!=='T9' ? 'rgb(13,132,255)' : 'rgb(38,38,38)'}}" @click="selectRectKeyboard('cn')">中</text>
              <text class="rect-mode-button" style="background-color:{{lang==='en' && rectKeyboardtype!=='T9' ? 'rgb(13,132,255)' : 'rgb(38,38,38)'}}" @click="selectRectKeyboard('en')">英</text>
              <text class="rect-mode-button" style="background-color:{{rectKeyboardtype==='T9' ? 'rgb(13,132,255)' : 'rgb(38,38,38)'}}" @click="selectRectKeyboard('t9')">九</text>
              <text class="rect-mode-button" style="font-size:22px" @click="openRectPanel('settings')">设置</text>
            </div>
          </scroll>
        </div>
        <!-- 方屏新增设置功能：当前提供按键振动和候选词数量两项即时生效的设置。 -->
        <div class="rect-overlay rect-settings-overlay" if="{{rectPanel==='settings'}}">
          <div class="rect-settings-header">
            <text class="rect-settings-title">设置</text>
            <text class="rect-panel-close" @click="closeRectPanel">完成</text>
          </div>
          <div class="rect-settings-row">
            <text class="rect-settings-label">按键振动</text>
            <text class="rect-settings-option" style="background-color:{{rectVibrateMode==='' ? 'rgb(13,132,255)' : 'rgb(38,38,38)'}}" @click="setRectVibrateMode('')">关</text>
            <text class="rect-settings-option" style="background-color:{{rectVibrateMode==='short' ? 'rgb(13,132,255)' : 'rgb(38,38,38)'}}" @click="setRectVibrateMode('short')">短</text>
            <text class="rect-settings-option" style="background-color:{{rectVibrateMode==='long' ? 'rgb(13,132,255)' : 'rgb(38,38,38)'}}" @click="setRectVibrateMode('long')">长</text>
          </div>
          <div class="rect-settings-row">
            <text class="rect-settings-label">候选词</text>
            <text class="rect-settings-option" style="background-color:{{rectCandidateCount===3 ? 'rgb(13,132,255)' : 'rgb(38,38,38)'}}" @click="setRectCandidateCount(3)">3</text>
            <text class="rect-settings-option" style="background-color:{{rectCandidateCount===5 ? 'rgb(13,132,255)' : 'rgb(38,38,38)'}}" @click="setRectCandidateCount(5)">5</text>
          </div>
        </div>
