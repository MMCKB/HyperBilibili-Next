<template>
  <div class="time-comp" style="{{compStyle}}">
    <!-- 顶部常驻胶囊：仅矩形屏且由首页开启。离开播放页后若仍在播放，显示「正在播放」 -->
    <div if="{{showPill && useRectTime}}" class="top-pill" @click="TogglePlayPopup">
      <text if="{{nowPlaying}}" class="pill-playing">正在播放</text>
    </div>
    <div if="{{!useRectTime}}">
      <div class="circle-time">
        <text class="timetxt">{{ hourHigh }}</text>
        <text class="timetxt">{{ hourLow }}</text>
        <text class="timetxt">:</text>
        <text class="timetxt">{{ minuteHigh }}</text>
        <text class="timetxt">{{ minuteLow }}</text>
      </div>
    </div>
    <div if="{{useRectTime}}" class="rect">
      <text class="timetxt rect-txt">{{ hourHigh }}{{ hourLow }}:{{ minuteHigh }}{{ minuteLow }}</text>
    </div>
  </div>
</template>

<script>
import prompt from "@system.prompt"

export default {
  props: ["showPill"],
  data: {
    hourHigh: "",
    hourLow: "",
    minuteHigh: "",
    minuteLow: "",
    compStyle: {},
    useRectTime: false,
    // 播放页已退出但音频仍在播放
    nowPlaying: false,
    playTimer: null
  },
  SyncPlayStatus() {
    const status = global.playStatus
    this.nowPlaying = !!(status && status.playing && !status.pageVisible)
  },
  TogglePlayPopup(e) {
    if (e && e.stopPropagation) e.stopPropagation()
    const status = global.playStatus
    if (!status || !status.hasTrack) {
      prompt.showToast({ message: "当前没有正在播放的内容" })
      return
    }
    status.popupOpen = !status.popupOpen
  },
  onDestroy() {
    if (this.playTimer) {
      clearInterval(this.playTimer)
      this.playTimer = null
    }
  },
  UpdateTime() {
    const hour = this.$app.$def.dayjs().hour()
    const minute = this.$app.$def.dayjs().minute()

    this.hourHigh = Math.floor(hour / 10).toString()
    this.hourLow = (hour % 10).toString()

    this.minuteHigh = Math.floor(minute / 10).toString()
    this.minuteLow = (minute % 10).toString()
  },
  onInit() {
    this.UpdateTime()

    setInterval(() => {
      this.UpdateTime()
    }, 2000)

    const deviceInfo = global.DEVICE_INFO
    if (deviceInfo.screenShape == "rect") {
      this.compStyle["top"] = "0px"
      this.compStyle["right"] = "100px"
      this.useRectTime = true
    }

    // 仅首页顶栏需要感知「正在播放」
    if (this.showPill) {
      this.SyncPlayStatus()
      this.playTimer = setInterval(() => {
        this.SyncPlayStatus()
      }, 500)
    }
  }
}
</script>

<style lang="less">
@import "@less/global.less";

.time-comp {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: 3.5px;
}

.circle-time {
  justify-content: flex-start;
}

.timetxt {
  font-size: 25px;
  font-weight: 600;
  top: 2px;
}

// 常驻胶囊：空闲时占位，离开播放页后显示「正在播放」
.top-pill {
  width: 88px;
  height: 40px;
  border-radius: 24px;
  background-color: rgba(0, 0, 0, 0.28);
  margin-right: 6px;
  align-items: center;
  justify-content: center;
}

.pill-playing {
  font-size: 14px;
  font-weight: 500;
  color: #ffffff;
  lines: 1;
}

.rect-txt {
  font-size: 30px;
  padding: 0px;
}
</style>