<template>
  <div class="time-comp" style="{{compStyle}}">
    <!-- 视频缓存进度：仅缓存进行中显示，位于占位胶囊左侧。
         环形进度条内嵌下载图标，右侧显示数字百分比 -->
    <div if="{{showPill && useRectTime && cacheActive}}" class="cache-indicator">
      <div class="cache-ringwrap">
        <progress class="cache-ring" type="arc" percent="{{cachePercent}}"></progress>
        <image class="cache-icon" src="/common/icon/download.png"></image>
      </div>
      <text class="cache-percent">{{cachePercent}}%</text>
    </div>
    <!-- 顶部占位胶囊：仅矩形屏且由首页开启时显示。
         与时间同处一行并垂直居中，紧贴时间左侧；无任何交互与功能 -->
    <div if="{{showPill && useRectTime}}" class="top-pill"></div>
    <div if="{{!useRectTime}}">
      <div class="circle-time">
        <text class="timetxt">{{ hourHigh }}</text>
        <text class="timetxt">{{ hourLow }}</text>
        <text class="timetxt">:</text>
        <text class="timetxt">{{ minuteHigh }}</text>
        <text class="timetxt">{{ minuteLow }}</text>
      </div>
    </div>
    <div if="{{useRectTime}}" class="rect">
      <text class="timetxt rect-txt">{{ hourHigh }}{{ hourLow }}:{{ minuteHigh }}{{ minuteLow }}</text>
    </div>
  </div>
</template>

<script>
export default {
  props: ["showPill"],
  data: {
    hourHigh: "",
    hourLow: "",
    minuteHigh: "",
    minuteLow: "",
    compStyle: {},
    useRectTime: false,
    // 视频缓存进度（轮询 global.downloadrecords.cacheProgress）
    cacheActive: false,
    cachePercent: 0,
    cacheTimer: null
  },
  // 同步缓存进度：仅在缓存进行中显示环形进度
  SyncCacheProgress() {
    const progress = global.downloadrecords && global.downloadrecords.cacheProgress
    if (!progress || !progress.active) {
      this.cacheActive = false
      return
    }
    this.cacheActive = true
    this.cachePercent = Math.max(0, Math.min(99, Math.round(progress.percent || 0)))
  },
  onDestroy() {
    if (this.cacheTimer) {
      clearInterval(this.cacheTimer)
      this.cacheTimer = null
    }
  },
  UpdateTime() {
    const hour = this.$app.$def.dayjs().hour()
    const minute = this.$app.$def.dayjs().minute()

    this.hourHigh = Math.floor(hour / 10).toString()
    this.hourLow = (hour % 10).toString()

    this.minuteHigh = Math.floor(minute / 10).toString()
    this.minuteLow = (minute % 10).toString()
  },
  onInit() {
    this.UpdateTime()

    setInterval(() => {
      this.UpdateTime()
    }, 2000)

    const deviceInfo = global.DEVICE_INFO
    if (deviceInfo.screenShape == "rect") {
      this.compStyle["top"] = "0px"
      this.compStyle["right"] = "100px"
      this.useRectTime = true
    }

    // 仅首页顶栏（showPill）需要展示缓存进度，其他页面的时钟不轮询
    if (this.showPill) {
      this.SyncCacheProgress()
      this.cacheTimer = setInterval(() => {
        this.SyncCacheProgress()
      }, 500)
    }
  }
}
</script>

<style lang="less">
@import "@less/global.less";

.time-comp {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: 3.5px;
}

.circle-time {
  justify-content: flex-start;
}

.timetxt {
  font-size: 25px;
  font-weight: 600;
  top: 2px;
}

// 占位胶囊：半透明白色，圆角全高，高度与时间字号视觉一致
.top-pill {
  width: 60px;
  height: 28px;
  border-radius: 14px;
  background-color: rgba(255, 255, 255, 0.18);
  margin-right: 6px;
}

// 缓存进度：环形进度条 + 内嵌下载图标 + 右侧百分比
.cache-indicator {
  flex-direction: row;
  align-items: center;
  margin-right: 6px;
}

.cache-ringwrap {
  width: 22px;
  height: 22px;
  align-items: center;
  justify-content: center;
  position: relative;
}

.cache-ring {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 22px;
  height: 22px;
  radius: 9px;
  stroke-width: 4px;
  start-angle: 270deg;
  total-angle: 360deg;
  color: #ffffff;
  layer-color: rgba(255, 255, 255, 0.3);
}

.cache-icon {
  width: 11px;
  height: 11px;
  object-fit: scale-down;
}

.cache-percent {
  font-size: 15px;
  font-weight: 600;
  color: #ffffff;
  margin-left: 3px;
  width: 36px;
  text-align: center;
}

.rect-txt {
  font-size: 30px;
  padding: 0px;
}
</style>