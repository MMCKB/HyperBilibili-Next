<template>
  <div class="favpicker">
    <!-- 顶部标题与关闭 -->
    <div class="header">
      <text class="title">收藏</text>
      <div class="closebtn" @click="Close">
        <image class="closebtn_img" src="/common/textinput_back.png"></image>
      </div>
    </div>

    <!-- 收藏夹列表：已收藏的夹显示粉色高亮，点击收藏/取消 -->
    <scroll class="folderscroll" scroll-y="true" bounces="true" if="{{loaded}}">
      <div class="folderitem" for="{{folders}}" @click="DealFolder($index, $item)">
        <text class="foldername {{$item.fav_state ? 'foldername-active' : ''}}">{{$item.title}}</text>
        <text class="folderstate">{{$item.fav_state ? "已收藏" : ""}}</text>
      </div>
      <div class="empty" if="{{folders.length === 0}}">
        <text class="emptytext">没有可用的收藏夹</text>
      </div>
      <div style="height: 20px"></div>
    </scroll>
    <text class="loadingtip" if="{{!loaded}}">加载中...</text>
  </div>
</template>

<script>
import prompt from "@system.prompt"
export default {
  props: ["aid"],
  private: {
    folders: [],
    loaded: false
  },
  // 收藏/取消当前视频到点击的收藏夹（就地翻转状态，关闭时由父页面刷新总状态）
  // 注意：快应用不观测对象内部属性的直接修改，需用 splice 替换元素触发视图更新
  async DealFolder(index, folder) {
    try {
      const aid = this.aid
      let result
      if (folder.fav_state) {
        result = await global.biliclient.unstarVideoFromFavFolders(aid, [folder.id])
        if (result === 0) {
          this.folders.splice(index, 1, {...folder, fav_state: 0})
          prompt.showToast({message: `已从「${folder.title}」移除`})
        } else {
          prompt.showToast({message: "取消收藏失败", duration: 3000})
        }
      } else {
        result = await global.biliclient.starVideoToFavFolders(aid, [folder.id])
        if (result === 0) {
          this.folders.splice(index, 1, {...folder, fav_state: 1})
          prompt.showToast({message: `已收藏到「${folder.title}」`})
        } else {
          prompt.showToast({message: "收藏失败", duration: 3000})
        }
      }
    } catch (e) {
      global.logger.error("[FavFolderPicker] deal error:", e.toString())
      prompt.showToast({message: "操作失败，请重试", duration: 3000})
    }
  },
  Close() {
    this.$emit("close")
  },
  async onInit() {
    try {
      // list-all 带 rid：返回的每个收藏夹含 fav_state（当前视频是否已在该夹）
      const data = await global.biliclient.getUserFavouriteFoldersWithVideoState(
        global.biliclient.accountInfo.mid,
        this.aid
      )
      this.folders = (data && data.list) || []
    } catch (e) {
      global.logger.error("[FavFolderPicker] load folders error:", e.toString())
      this.folders = []
    }
    this.loaded = true
  }
}
</script>

<style lang="less">
@import '@less/global.less';

.favpicker {
  position: absolute;
  width: @screenWidth;
  height: @screenHeight;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.header {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 85px;
  margin-top: 15px;
}

.title {
  font-size: 26px;
  font-weight: 600;
  color: #ffffff;
}

.closebtn {
  position: absolute;
  left: 20px;
  width: 50px;
  height: 50px;
  justify-content: center;
  align-items: center;
}

.closebtn_img {
  width: 35px;
  height: 35px;
  object-fit: scale-down;
}

.folderscroll {
  width: 88%;
  flex-size: 1;
}

.folderitem {
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: 88px;
  border-radius: 24px;
  background-color: #262626;
  border-width: 2px;
  border-color: rgba(255, 255, 255, 0.08);
  margin-top: 12px;
  padding: 10px 24px;
}

.foldername {
  font-size: 24px;
  font-weight: 600;
  color: #ffffff;
  lines: 1;
  flex-size: 1;
}

.foldername-active {
  color: #FF7DA8;
}

.folderstate {
  font-size: 20px;
  color: #FF7DA8;
  margin-left: 12px;
}

.empty {
  width: 100%;
  height: 200px;
  justify-content: center;
  align-items: center;
}

.emptytext {
  font-size: 24px;
  color: #9e9e9e;
}

.loadingtip {
  font-size: 22px;
  color: #9e9e9e;
  margin-top: 40px;
}
</style>
