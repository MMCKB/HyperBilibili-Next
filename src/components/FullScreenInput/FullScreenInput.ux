<import name="input-method" src="@components/InputMethod/InputMethod.ux"></import>
<import name="emoji-picker" src="@components/EmojiPicker/EmojiPicker.ux"></import>

<template>
    <div class="inputpanel">
        <input-method if="{{global_show && !emojimode}}" style="position: absolute" hide={{keyboardHide}} @complete="InputEvent" @delete="InputDelete" @cursor="InputCursor" screentype="{{screentype}}" keyboardtype="{{keyboardtype}}" traditional="{{traditional}}" vibratemode="{{vibratemode}}" maxlength="{{maxlength}}" keyboardtheme="{{keyboardtheme}}"></input-method>
        <div class="inputactions">
            <div style="margin-left: 35px" @click="ExitInput">
                <image class="inputaction_img" src="/common/textinput_back.png"></image>
            </div>
            <div style="margin-left: 75px" @click="InputFinish">
                <image class="inputaction_img" src="/common/textinput_finish.png"></image>
            </div>
            <!-- 表情按钮 -->
            <div class="emojibtn" @click="OpenEmoji">
                <text class="emojibtn_text">表情</text>
            </div>
        </div>
        <div class="inputshow">
            <text class="inputshow_text">{{ input_display }}</text>
        </div>
        <!-- 表情选择面板 -->
        <emoji-picker if="{{emojimode}}" @selectemoji="AppendEmoji" @close="CloseEmoji"></emoji-picker>
    </div>
</template>

<script>
export default {
    props: {
        keyboardHide: {
            default: false
        },
        // 初始文本（用于在已有内容基础上继续编辑）
        initialText: {
            default: ""
        }
    },
    data: {
        global_show: false,
        input_text: "",
        // 仅保存当前会话的编辑位置；显示光标不会写入发送内容。
        cursorIndex: 0,
        input_display: "│",
        screentype: "",
        keyboardtype: "QWERTY",
        traditional: false,
        vibratemode: "short",
        maxlength: 5,
        keyboardtheme: "dark",
        emojimode: false
    },
    NormalizeCursor(index){
        const length = this.input_text.length
        let normalized = Math.max(0, Math.min(length, index))
        // 避免光标停在表情等代理对中间。
        if (normalized > 0 && normalized < length) {
            const previous = this.input_text.charCodeAt(normalized - 1)
            const current = this.input_text.charCodeAt(normalized)
            if (previous >= 0xD800 && previous <= 0xDBFF && current >= 0xDC00 && current <= 0xDFFF) {
                normalized++
            }
        }
        return normalized
    },
    RefreshInputDisplay(){
        this.cursorIndex = this.NormalizeCursor(this.cursorIndex)
        this.input_display = this.input_text.slice(0, this.cursorIndex) + "│" + this.input_text.slice(this.cursorIndex)
    },
    InsertAtCursor(content){
        if (!content) {
            return
        }
        this.cursorIndex = this.NormalizeCursor(this.cursorIndex)
        this.input_text = this.input_text.slice(0, this.cursorIndex) + content + this.input_text.slice(this.cursorIndex)
        this.cursorIndex += content.length
        this.RefreshInputDisplay()
    },
    InputEvent(evt){
        this.InsertAtCursor(evt.detail.content)
    },
    InputDelete(){
        this.cursorIndex = this.NormalizeCursor(this.cursorIndex)
        if (this.cursorIndex <= 0) {
            return
        }
        let removeStart = this.cursorIndex - 1
        const previous = this.input_text.charCodeAt(removeStart)
        if (previous >= 0xDC00 && previous <= 0xDFFF && removeStart > 0) {
            const high = this.input_text.charCodeAt(removeStart - 1)
            if (high >= 0xD800 && high <= 0xDBFF) {
                removeStart--
            }
        }
        this.input_text = this.input_text.slice(0, removeStart) + this.input_text.slice(this.cursorIndex)
        this.cursorIndex = removeStart
        this.RefreshInputDisplay()
    },
    InputCursor(evt){
        const action = evt && evt.detail ? evt.detail.action : ""
        this.cursorIndex = this.NormalizeCursor(this.cursorIndex)
        if (action === "enter") {
            this.InsertAtCursor("\n")
            return
        }
        if (action === "left") {
            let target = this.cursorIndex - 1
            if (target > 0) {
                const low = this.input_text.charCodeAt(target)
                const high = this.input_text.charCodeAt(target - 1)
                if (low >= 0xDC00 && low <= 0xDFFF && high >= 0xD800 && high <= 0xDBFF) {
                    target--
                }
            }
            this.cursorIndex = target
        } else if (action === "right") {
            let target = this.cursorIndex + 1
            if (this.cursorIndex < this.input_text.length) {
                const high = this.input_text.charCodeAt(this.cursorIndex)
                const low = this.input_text.charCodeAt(this.cursorIndex + 1)
                if (high >= 0xD800 && high <= 0xDBFF && low >= 0xDC00 && low <= 0xDFFF) {
                    target++
                }
            }
            this.cursorIndex = target
        } else if (action === "up") {
            this.MoveCursorVertically(-1)
        } else if (action === "down") {
            this.MoveCursorVertically(1)
        }
        this.RefreshInputDisplay()
    },
    MoveCursorVertically(direction){
        const currentLineStart = this.input_text.lastIndexOf("\n", this.cursorIndex - 1) + 1
        const currentColumn = this.cursorIndex - currentLineStart
        if (direction < 0) {
            if (currentLineStart === 0) {
                return
            }
            const previousLineEnd = currentLineStart - 1
            const previousLineStart = this.input_text.lastIndexOf("\n", previousLineEnd - 1) + 1
            this.cursorIndex = Math.min(previousLineStart + currentColumn, previousLineEnd)
            return
        }
        const currentLineEnd = this.input_text.indexOf("\n", this.cursorIndex)
        if (currentLineEnd < 0) {
            return
        }
        const nextLineStart = currentLineEnd + 1
        const nextLineEndIndex = this.input_text.indexOf("\n", nextLineStart)
        const nextLineEnd = nextLineEndIndex < 0 ? this.input_text.length : nextLineEndIndex
        this.cursorIndex = Math.min(nextLineStart + currentColumn, nextLineEnd)
    },
    ExitInput(){
        this.$emit("exit")
    },
    InputFinish(){
        this.$emit("send", {
            content: this.input_text
        })
    },
    OpenEmoji(){
        // 打开表情面板时隐藏键盘
        this.emojimode = true
    },
    CloseEmoji(){
        this.emojimode = false
    },
    // 选择表情后追加到输入文本
    AppendEmoji(evt){
        this.emojimode = false
        this.InsertAtCursor(evt.detail.content)
    },
    async InitScreenType(){
        this.screentype = global.DEVICE_INFO.screenShape
        const preferences = (global.settings && global.settings.SETTINGS && global.settings.SETTINGS.inputMethodSettings) || {}
        this.keyboardtype = preferences.keyboardtype === "T9" ? "T9" : "QWERTY"
        this.traditional = preferences.traditional === true
        this.vibratemode = preferences.vibratemode === "long" ? "long" : (preferences.vibratemode === "short" ? "short" : "")
        this.maxlength = Number(preferences.maxlength) === 3 ? 3 : 5
        this.keyboardtheme = preferences.keyboardtheme === "white" || preferences.keyboardtheme === "blue-gray" ? preferences.keyboardtheme : "dark"
        // 用传入的初始文本初始化输入框
        this.input_text = this.initialText || ""
        this.cursorIndex = this.input_text.length
        this.RefreshInputDisplay()
        this.global_show = true
    },
    onInit(){
        this.InitScreenType()
    }
}
</script>

<style lang="less">
@import '@less/global.less';

.inputpanel {
  position: absolute;
  width: @screenWidth;
  height: @screenHeight;
  background-color: black;
  justify-content: center;
}

.inputactions {
  flex-direction: row;
  align-items: center;
  width: 50%;
  position: absolute;
  margin-top: 30px;
  height: 65px;
  align-items: center;
}

.inputaction_img {
  width: 35px;
  height: 35px;
  object-fit: scale-down;
}

.inputshow {
  width: 65%;
  position: absolute;
  margin-top: 100px;
}

.inputshow_text {
  font-size: 24px;
}

.emojibtn {
  width: 60px;
  height: 48px;
  border-radius: 48px;
  background-color: #3D3D3D;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: 0px;
  left: 170px;
}

.emojibtn_text {
  font-size: 18px;
  font-weight: 600;
  color: #ff7da8;
  text-align: center;
}
</style>
