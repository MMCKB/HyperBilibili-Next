// 将一维数组按指定数量分组为二维数组（每行）
function chunkArray(arr, size) {
    const result = [];
    for (let i = 0; i < arr.length; i += size) {
        result.push(arr.slice(i, i + size));
    }
    return result;
}

export default {
    data: {
        rows: []
    },
    onInit() {
        // 每行5个表情
        this.rows = chunkArray(BILIBILI_EMOJI_LIST, 5);
    },
    SelectEmoji(name) {
        if (!name) {
            return;
        }
        // 发送时加上方括号，符合B站原版表情格式
        this.$emit("selectemoji", {
            content: "[" + name + "]"
        });
    },
    Close() {
        this.$emit("close");
    }
}
</script>

