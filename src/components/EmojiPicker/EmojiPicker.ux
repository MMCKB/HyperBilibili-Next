    flex-direction: column;
    align-items: center;
    width: 100%;
    flex: 1;
}

.emoji_grid {
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
    margin-top: 8px;
}

.emoji_item {
    width: 55px;
    height: 55px;
