<template>
    <div class="emojipicker">
        <div class="header">
            <text class="title">{{ $t("dmpage.selectEmoji") }}</text>
            <div class="closebtn" @click="Close">
                <image class="closebtn_img" src="/common/textinput_back.png"></image>
            </div>
        </div>
        <scroll class="emoji_scroll" scroll-y="true" bounces="true">
            <div class="emoji_grid" for="{{rows}}">
                <div class="emoji_item" for="{{row in $item}}" @click="SelectEmoji(row.name)">
                    <image class="emoji_img" if="{{row.url}}" src="{{row.url}}" alt="/common/fullgray.png"></image>
                </div>
            </div>
            <text style="height: 80px"></text>
        </scroll>
    </div>
</template>

<script>
