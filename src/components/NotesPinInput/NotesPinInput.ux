  width: 392px;
  padding-top: 54px;
  align-items: center;
  flex-direction: column;
}

.notes-pin-title {
  color: #FFFFFF;
  font-size: 28px;
  font-weight: 700;
  text-align: center;
}

.notes-pin-hint {
  color: #AFAFB6;
  font-size: 18px;
  margin-top: 10px;
  text-align: center;
}

.notes-pin-dots {
  min-width: 192px;
  color: #FF9FBE;
  font-size: 28px;
  letter-spacing: 6px;
  margin-top: 22px;
  text-align: center;
}

.notes-pin-keyboard {
  width: 342px;
  margin-top: 20px;
  flex-direction: column;
}

.notes-pin-row {
  width: 342px;
  height: 55px;
  margin-top: 10px;
  flex-direction: row;
  justify-content: space-between;
}

.notes-pin-key {
  width: 104px;
  height: 55px;
  border-radius: 17px;
  background-color: #292A30;
  align-items: center;
  justify-content: center;
}

.notes-pin-action {
  width: 104px;
  height: 55px;
  border-radius: 17px;
  background-color: #292A30;
  align-items: center;
  justify-content: center;
}

.notes-pin-key-text {
  color: #FFFFFF;
  font-size: 29px;
  font-weight: 600;
}

.notes-pin-action-text {
  color: #FFB0C9;
  font-size: 20px;
  font-weight: 600;
}

.notes-pin-cancel {
  background-color: #313238;
}

.notes-pin-delete {
  background-color: #3A2A33;
}

.notes-pin-confirm {
  width: 342px;
  height: 55px;
  border-radius: 17px;
  background-color: #FF7DA8;
  margin-top: 12px;
  align-items: center;
  justify-content: center;
}

.notes-pin-confirm-text {
  color: #FFFFFF;
