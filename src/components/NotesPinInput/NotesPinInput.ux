<template>
  <div class="notes-pin-panel">
    <div class="notes-pin-header">
      <text class="notes-pin-title">{{ _parentVM.$t(title) }}</text>
      <text class="notes-pin-hint">{{ _parentVM.$t("notes.pinHint") }}</text>
      <text class="notes-pin-dots">{{ pinDots }}</text>
    </div>
    <div class="notes-pin-keyboard">
      <div class="notes-pin-row">
        <div class="notes-pin-key" onclick="Append('1')"><text class="notes-pin-key-text">1</text></div>
        <div class="notes-pin-key" onclick="Append('2')"><text class="notes-pin-key-text">2</text></div>
        <div class="notes-pin-key" onclick="Append('3')"><text class="notes-pin-key-text">3</text></div>
      </div>
      <div class="notes-pin-row">
        <div class="notes-pin-key" onclick="Append('4')"><text class="notes-pin-key-text">4</text></div>
        <div class="notes-pin-key" onclick="Append('5')"><text class="notes-pin-key-text">5</text></div>
        <div class="notes-pin-key" onclick="Append('6')"><text class="notes-pin-key-text">6</text></div>
      </div>
      <div class="notes-pin-row">
        <div class="notes-pin-key" onclick="Append('7')"><text class="notes-pin-key-text">7</text></div>
        <div class="notes-pin-key" onclick="Append('8')"><text class="notes-pin-key-text">8</text></div>
        <div class="notes-pin-key" onclick="Append('9')"><text class="notes-pin-key-text">9</text></div>
      </div>
      <div class="notes-pin-row">
        <div class="notes-pin-action notes-pin-cancel" onclick="Exit"><text class="notes-pin-action-text">{{ _parentVM.$t("notes.pinCancel") }}</text></div>
        <div class="notes-pin-key" onclick="Append('0')"><text class="notes-pin-key-text">0</text></div>
        <div class="notes-pin-action notes-pin-delete" onclick="Delete"><text class="notes-pin-action-text">⌫</text></div>
      </div>
      <div class="notes-pin-confirm" onclick="Finish"><text class="notes-pin-confirm-text">{{ _parentVM.$t("notes.pinConfirm") }}</text></div>
    </div>
  </div>
</template>

<script>
export default {
  props: ["title"],
  data: {
    pin: "",
    pinDots: "○ ○ ○ ○"
  },
  RefreshDots() {
    const entered = "●".repeat(this.pin.length)
    const remaining = "○".repeat(Math.max(0, 4 - this.pin.length))
    this.pinDots = (entered + remaining).split("").join(" ")
  },
  Append(value) {
    if (this.pin.length >= 8) return
    this.pin += String(value || "")
    this.RefreshDots()
  },
  Delete() {
    this.pin = this.pin.slice(0, -1)
    this.RefreshDots()
  },
  Exit() {
    this.$emit("exit")
  },
  Finish() {
    this.$emit("complete", { pin: this.pin })
  }
}
</script>

<style lang="less">
