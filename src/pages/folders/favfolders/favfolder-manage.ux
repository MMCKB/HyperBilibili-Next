<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>
<import name="full-screen-input" src="@components/FullScreenInput/FullScreenInput.ux"></import>

<template>
    <div class="page">
      <scroll scroll-y="true" class="scroll {{scrclass}}" bounces="true">
        <title-bar title="favfolderManage.title"></title-bar>

        <div class="addbtn" @click="OpenCreateInput">
          <text class="addbtn-text">+ {{ $t("favfolderManage.create") }}</text>
        </div>

        <image style="position: absolute; margin-top: 245px" if="{{anims.show_loading}}" src="{{anims.loading_src.value}}"></image>

        <list class="folderlist">
          <list-item type="folder" class="folder" for="{{folders}}">
            <div class="folder-info" @click="OpenEditInput($item)">
              <text class="folder-title">{{$item.title}}</text>
              <text class="folder-meta">{{$item.media_count}} 个 · {{ $item.privacy === 10 ? $t("favfolderManage.private") : $t("favfolderManage.public") }}</text>
            </div>
            <div class="delbtn" @click="ConfirmDelete($item)">
              <text class="delbtn-text">×</text>
            </div>
          </list-item>
        </list>
        <text class="empty" if="{{!anims.show_loading && folders.length === 0}}">{{ $t("favfolderManage.empty") }}</text>
        <text style="margin-top: 25px"></text>
      </scroll>

      <!-- 新建/编辑收藏夹输入面板 -->
      <full-screen-input style="position: absolute" if="{{inputMode}}" @send="OnInputSend" @exit="ExitInput"></full-screen-input>
    </div>
</template>

<script>
import prompt from "@system.prompt"
export default {
  private: {
    folders: [],
    inputMode: false,
    editingFolder: null,
    anims: {
      show_loading: false
    },
    scrclass: ""
  },
  async LoadFolders(){
    this.anims.show_loading = true
    this.anims.loading.start()
    try {
      const folderlist = await global.biliclient.getUserFavouriteFolders(global.biliclient.accountInfo.mid)
      const list = folderlist.list || []
      const folderPromises = list.map((folder) =>
        global.biliclient.getFavouriteFolderMetadata(folder.id)
      )
      this.folders = await Promise.all(folderPromises)
    } catch (e) {
      global.logger.error("[favfolder-manage] LoadFolders error:", e.toString())
    } finally {
      this.anims.show_loading = false
      this.anims.loading.stop()
    }
  },
  OpenCreateInput(){
    this.editingFolder = null
    this.inputMode = true
  },
  OpenEditInput(folder){
    this.editingFolder = folder
    this.inputMode = true
  },
  ExitInput(){
    this.inputMode = false
    this.editingFolder = null
  },
  async OnInputSend(evt){
    const title = evt.detail.content
    this.inputMode = false
    if (!title || title.trim() === "") {
      prompt.showToast({ message: this.$t("favfolderManage.titleEmpty"), duration: 2000 })
      return
    }
    try {
      if (this.editingFolder) {
        // 编辑
        const result = await global.biliclient.editFavFolder(
          this.editingFolder.id,
          title.trim(),
          this.editingFolder.intro || "",
          this.editingFolder.privacy || 0
        )
        if (result.code === 0) {
          prompt.showToast({ message: this.$t("favfolderManage.editOk"), duration: 1500 })
        } else {
          prompt.showToast({ message: result.message || this.$t("favfolderManage.editFail"), duration: 2000 })
        }
      } else {
        // 新建
        const result = await global.biliclient.createFavFolder(title.trim(), "", 0)
        if (result.code === 0) {
          prompt.showToast({ message: this.$t("favfolderManage.createOk"), duration: 1500 })
        } else {
          prompt.showToast({ message: result.message || this.$t("favfolderManage.createFail"), duration: 2000 })
        }
      }
      await this.LoadFolders()
    } catch (e) {
      global.logger.error("[favfolder-manage] OnInputSend error:", e.toString())
      prompt.showToast({ message: this.$t("favfolderManage.editFail"), duration: 2000 })
    }
  },
  ConfirmDelete(folder){
    const msg = this.$t("favfolderManage.deleteConfirm").replace("{name}", folder.title)
    prompt.showDialog({
      title: "",
      message: msg,
      buttons: [
        { text: this.$t("favfolderManage.confirm"), color: "#FF7DA8" },
        { text: this.$t("favfolderManage.cancel"), color: "#9e9e9e" }
      ],
      success: (data) => {
        if (data.index === 0) {
          this.DeleteFolder(folder)
        }
      }
    })
  },
  async DeleteFolder(folder){
    try {
      const result = await global.biliclient.deleteFavFolder(folder.id.toString())
      if (result.code === 0) {
        prompt.showToast({ message: this.$t("favfolderManage.deleteOk"), duration: 1500 })
        await this.LoadFolders()
      } else {
        prompt.showToast({ message: result.message || this.$t("favfolderManage.deleteFail"), duration: 2000 })
      }
    } catch (e) {
      global.logger.error("[favfolder-manage] DeleteFolder error:", e.toString())
      prompt.showToast({ message: this.$t("favfolderManage.deleteFail"), duration: 2000 })
    }
  },
  onInit(){
    global.animengine.defaults.loading.CreateLoadingAnimation(this)
    this.LoadFolders()
  },
  async onShow(){
    if (this.folders.length > 0 || this.anims.show_loading === false) {
      await this.LoadFolders()
    }
  }
}
</script>

<style lang="less">
@import '@less/global.less';

.addbtn {
  width: 90%;
  height: 50px;
  background-color: #FF7DA8;
  border-radius: 25px;
  justify-content: center;
  align-items: center;
  margin-top: 10px;
}

.addbtn-text {
  font-size: 22px;
  font-weight: 600;
  color: #ffffff;
}

.folderlist {
  width: 90%;
  margin-top: 10px;
}

.folder {
  flex-direction: row;
  align-items: center;
  margin-top: 8px;
}

.folder-info {
  flex: 1;
  flex-direction: column;
  background-color: #262626;
  border-radius: 12px;
  padding: 12px;
}

.folder-title {
  font-size: 20px;
  font-weight: 600;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.folder-meta {
  font-size: 14px;
  color: #9e9e9e;
  margin-top: 4px;
}

.delbtn {
  width: 36px;
  height: 36px;
  border-radius: 18px;
  background-color: #4a4a4a;
  justify-content: center;
  align-items: center;
  margin-left: 8px;
}

.delbtn-text {
  font-size: 26px;
  color: #ffffff;
  text-align: center;
}

.empty {
  font-size: 20px;
  color: #9e9e9e;
  margin-top: 40px;
  text-align: center;
}
</style>
