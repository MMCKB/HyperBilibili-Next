<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>
<import name="full-screen-input" src="@components/FullScreenInput/FullScreenInput.ux"></import>
<import name="default-button" src="@components/DefaultButton/DefaultButton.ux"></import>
<import name="online-image" src="@components/BetterOnlineImage/BetterOnlineImage.ux"></import>
<import name="coin-picker" src="@components/CoinPicker/CoinPicker.ux"></import>

<template>
  <div class="page">
    <scroll scroll-y="true" class="zoomscroll {{scrclass}}" bounces="true">
      <title-bar title="video.title"></title-bar>
      <online-image if="{{renderingCover}}" src="{{vid.pic}}@319w_150h" margin-top="30px" lock-size="true" width="320px"
        height="150px" loading-anim="true" @loaded="GenBlur"></online-image>
      <text class="vidtitle">{{ vid.title }}</text>
      <div class="statbar">
        <div class="stat">
          <image class="statimg" src="/common/playcounticon.png" style="width: 23px; height: 25px; margin-top: 2px">
          </image>
          <text class="statext">{{ stat_view }}</text>
        </div>
        <div class="stat" style="margin-left: 10px" @click="OpenOwnerHome">
          <image class="statimg" src="/common/uploadericon.png" style="width: 27px; height: 29px"></image>
          <text class="statext">{{ vid.owner.name }}</text>
        </div>
      </div>
      <scroll scroll-x="true" class="vidtoolbar" style="margin-top: 25px" bounces="true">
        <div class="vidtool" style="margin-left: 0px" @click="OpenPlayer()">
          <image class="vidtoolimg" src="/common/vidtool_generatemanifest.png"></image>
          <text class="vidtooltext">听视频</text>
        </div>
        <div class="vidtool" @click="LikeClick">
          <image class="vidtoolimg" src="{{likesrc}}"></image>
          <text class="vidtooltext">{{ stat_like }}</text>
        </div>
        <div class="vidtool" @click="CoinClick">
          <image class="vidtoolimg" src="{{coinsrc}}"></image>
          <text class="vidtooltext">{{ stat_coin }}</text>
        </div>
        <div class="vidtool" @click="StarClick">
          <image class="vidtoolimg" src="{{starsrc}}"></image>
          <text class="vidtooltext">
            {{ stat_favorite }}
          </text>
        </div>
        <div class="vidtool" @click="ShowVideoDetail()">
          <image class="vidtoolimg" src="/common/vidtool_aisummary.png"></image>
          <text class="vidtooltext">{{ $t("video.videodetail") }}</text>
        </div>
        <div class="vidtool" @click="AddToWatchLater()">
          <image class="vidtoolimg" src="/common/vidtool_watchlater.png"></image>
          <text class="vidtooltext">{{ $t("video.showLater") }}</text>
        </div>
        <div class="vidtool" style="width: 105px" @click="WatchOnPhone()">
          <image class="vidtoolimg" src="/common/vidtool_phone.png"></image>
          <text class="vidtooltext">在手机上看</text>
        </div>
      </scroll>
      <default-button text="video.sendReply" margin-top="20px" @click="Reply"></default-button>
      <image src="/common/featurebtn_replyarea.png" style="margin-top: 15px" @click="GoReplyArea()"></image>
    </scroll>
    <full-screen-input style="position: absolute" if="{{replymode}}" @send="SendReply"
      @exit="ExitInput"></full-screen-input>
    <!-- 投币选择面板（22娘，可选投1个或2个币） -->
    <coin-picker if="{{coinpickermode}}" @select="DoCoin" @close="ExitCoinPicker"></coin-picker>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"

import {kmeansCircleGradientImage} from "@src/image/jpegkmeans.ts"

export default {
  public: {
    bvid: 1 // 视频BVID
  },
  private: {
    vid: {},
    liked: false,
    coined: false,
    stared: false,
    likesrc: "/common/vidtool_like.png",
    coinsrc: "/common/vidtool_coin.png",
    starsrc: "/common/vidtool_star.png",
    replymode: false,
    coinpickermode: false,
    renderingCover: false,
    scrclass: ""
  },
  computed: {
    stat_view() {
      return this.$app.$def.tools.formatNumber(this.vid.stat.view)
    },
    stat_like() {
      return this.$app.$def.tools.formatNumber(this.vid.stat.like)
    },
    stat_coin() {
      return this.$app.$def.tools.formatNumber(this.vid.stat.coin)
    },
    stat_favorite() {
      return this.$app.$def.tools.formatNumber(this.vid.stat.favorite)
    }
  },
  onInit() {
    global.logger.log("[videodetail] load bvid: " + this.bvid)
    this.GetVideoDetail()
    this.UpdateVideoToolbarStatus()
  },
  WIPTips() {
    prompt.showToast({
      message: "该功能仍在开发中"
    })
  },
  async AddToWatchLater() {
    try {
      const result = await global.biliclient.addToWatchLater(this.bvid)
      let message = ""
      switch (result.code) {
        case 0:
          message = "已添加到稍后再看"
          break
        case 90001:
          message = "稍后再看列表已满（最多100个）"
          break
        case 90003:
          message = "稿件已被删除"
          break
        case -101:
          message = "账号未登录"
          break
        default:
          message = `添加失败：${result.message || result.code}`
      }
      prompt.showToast({ message, duration: result.code === 0 ? 2000 : 4000 })
    } catch (error) {
      global.logger.error("[AddToWatchLater] error:", error.toString())
      prompt.showToast({ message: "添加失败", duration: 2000 })
    }
  },
  // 在手机上看：跳转独立页展示视频链接二维码，手机APP扫码观看
  // 独立路由页走标准 scroll/scrclass 动画机制，进出动画与其他页一致
  WatchOnPhone() {
    router.push({
      uri: "pages/video/watchonphone",
      params: {
        bvid: this.bvid
      }
    })
  },
  async OpenPlayer() {
    const exists = await global.savedcontent.SavedContentManager.checkVideoAudioExists(this.bvid)
    if (exists) {
      const contents = await global.savedcontent.SavedContentManager.listAllContent()
      const cachedItem = contents.find((ct) => ct.bvid === this.bvid && ct.type === 'videoAudio')
      if (cachedItem) {
        prompt.showToast({ message: '正在加载缓存...', duration: 1000 })
        router.push({
          uri: "pages/video/player",
          params: {
            bvid: this.bvid,
            cachedAudioUri: cachedItem.fileUri,
            cachedTitle: cachedItem.title,
            cachedCoverUrl: cachedItem.coverUrl,
            cachedAuthor: cachedItem.author
          }
        })
        return
      }
    }
    router.push({
      uri: "pages/video/player",
      params: {
        bvid: this.bvid
      }
    })
  },
  OpenOwnerHome() {
    router.push({
      uri: "pages/user",
      params: {
        uid: this.vid.owner.mid
      }
    })
  },
  async GetVideoDetail() {
    this.vid = await global.biliclient.getVideoInfoByBVID(this.bvid)
    this.renderingCover = true
  },
  async UpdateVideoToolbarStatus() {
    this.stared = await global.biliclient.isVideoStaredByBVID(this.bvid)
    this.liked = await global.biliclient.isVideoLikedByBVID(this.bvid)
    this.coined = await global.biliclient.isVideoCoinedByBVID(this.bvid)
    this.UpdateToolBarIconSrc()
  },
  UpdateToolBarIconSrc() {
    this.likesrc = this.liked ? "/common/vidtool_liked.png" : "/common/vidtool_like.png"
    this.coinsrc = this.coined ? "/common/vidtool_coined.png" : "/common/vidtool_coin.png"
    this.starsrc = this.stared ? "/common/vidtool_stared.png" : "/common/vidtool_star.png"
  },
  async LikeClick() {
    // 已点赞则取消点赞（B站接口 like=2 为取消），未点赞则点赞（like=1）
    const action = this.liked ? 2 : 1
    const result = await global.biliclient.LikeVideo(this.vid.bvid, action)
    const successMessage = action === 2 ? "已取消点赞" : "点赞成功"
    const failMessage = `${action === 2 ? "取消点赞失败" : "点赞失败"}，错误代码：${result.code} 原因：${result.message}`
    prompt.showToast({
      message: result.code === 0 ? successMessage : failMessage,
      duration: result.code === 0 ? 2000 : 4000
    })
    this.UpdateVideoToolbarStatus()
  },
  CoinClick() {
    // 打开投币选择面板（22娘，可选投1个或2个币）
    this.coinpickermode = true
  },
  async StarClick() {
    // 已收藏则取消收藏（从默认收藏夹移除），未收藏则收藏到默认收藏夹
    if (this.stared) {
      var unstarResult = await global.biliclient.unstarVideoFromDefaultFavFolderByBVID(this.vid.bvid)
      const unstarMessage =
        unstarResult === 0 ? "已取消收藏" : `取消收藏失败，原因：${unstarResult}`
      prompt.showToast({
        message: unstarMessage,
        duration: unstarResult === 0 ? 2000 : 4000
      })
    } else {
      var starResult = await global.biliclient.starVideoToDefaultFavFolderByBVID(this.vid.bvid)
      const starMessage =
        starResult === 0 ? "收藏成功" : `收藏失败，原因：${starResult}`
      prompt.showToast({
        message: starMessage,
        duration: starResult === 0 ? 2000 : 4000
      })
    }
    this.UpdateVideoToolbarStatus()
  },
  ExitCoinPicker() {
    this.coinpickermode = false
  },
  async DoCoin(evt) {
    // CoinPicker 选择回调：evt.detail.multiply 为 1 或 2
    this.coinpickermode = false
    const multiply = evt.detail.multiply
    await this.DoCoinVideo(multiply)
  },
  async DoCoinVideo(multiply) {
    var result = await global.biliclient.CoinVideo(this.vid.bvid, multiply)
    const message =
      result.code === 0 ? `投币成功（${multiply}个）` : `投币失败，错误代码：${result.code} 原因：${result.message}`
    prompt.showToast({
      message,
      duration: result.code === 0 ? 2000 : 4000
    })
    this.UpdateVideoToolbarStatus()
  },
  async SendReply(evt) {
    this.replymode = false
    if (evt.detail.content.length === 0) {
      return prompt.showToast({
        message: "评论内容不得为空！",
        duration: 2000
      })
    }

    const result = await global.biliclient.GiveReply(1, this.vid.aid, evt.detail.content)
    const message =
      result.code === 0 ? "发送成功" : `发送失败，错误代码：${result.code} 原因：${result.message}`
    prompt.showToast({
      message,
      duration: result.code === 0 ? 2000 : 4000
    })
  },
  ExitInput() {
    this.replymode = false
  },
  Reply() {
    this.replymode = true
  },
  DisabledFeaturesWarning() {
    prompt.showToast({
      message: "由于B站风控，该功能暂不可用"
    })
  },
  // 视频发布时间格式化（vid.pubdate 为秒级时间戳），精确到 年月日 时分秒
  formatPubdate(timestamp) {
    if (!timestamp) return "未知"
    const date = new Date(timestamp * 1000)
    const Y = date.getFullYear()
    const M = (date.getMonth() + 1).toString().padStart(2, "0")
    const D = date.getDate().toString().padStart(2, "0")
    const h = date.getHours().toString().padStart(2, "0")
    const m = date.getMinutes().toString().padStart(2, "0")
    const s = date.getSeconds().toString().padStart(2, "0")
    return `${Y}-${M}-${D} ${h}:${m}:${s}`
  },
  // 视频详情：基础信息 + 简介 + AI总结（含分段大纲）合并一页展示
  async ShowVideoDetail() {
    prompt.showToast({message: "正在生成详情...", duration: 1500})

    const duration = Number(this.vid.duration) || 0
    const minutes = Math.floor(duration / 60)
    const seconds = Math.floor(duration % 60)
    const durationStr = `${minutes}:${seconds.toString().padStart(2, "0")}`
    const upName = this.vid.staff && this.vid.staff.length > 0
      ? `${this.vid.owner.name} 等${this.vid.staff.length}位UP主`
      : this.vid.owner.name
    const pubdateStr = this.formatPubdate(this.vid.pubdate)
    const viewCountStr = this.$app.$def.tools.formatNumber(this.vid.stat.view)

    let text =
      `标题：${this.vid.title || "未知"}\n` +
      `发布时间：${pubdateStr}\n` +
      `播放量：${viewCountStr}\n` +
      `时长：${durationStr}\n` +
      `UP主：${upName}\n\n` +
      `简介：\n${this.vid.desc || "暂无简介"}`

    // AI总结部分：请求失败不阻塞详情展示，页面末尾给出提示
    try {
      const modelResult = await global.biliclient.getVideoAISummaryByBVID(
        this.vid.bvid,
        this.vid.cid,
        this.vid.owner.mid
      )
      if (modelResult && modelResult.summary) {
        text += `\n\n【AI总结】\n${modelResult.summary}`
        const outline = modelResult.outline || []
        if (outline.length > 0) {
          text += "\n\n【分段大纲】"
          outline.forEach((o) => {
            const t = Number(o.timestamp) || 0
            const mm = Math.floor(t / 60)
            const ss = Math.floor(t % 60)
            text += `\n${mm}:${ss.toString().padStart(2, "0")} ${o.title || ""}`
            ;(o.part_outline || []).forEach((p) => {
              if (p.text) text += `\n· ${p.text}`
            })
          })
        }
      } else {
        text += `\n\n【AI总结】\n该视频没有摘要，可能是其内容中包含敏感信息或没有可识别的音频`
      }
    } catch (e) {
      global.logger.error("获取AI总结失败: " + e.toString())
      text += `\n\n【AI总结】\n获取失败，请稍后再试`
    }

    router.push({
      uri: "pages/tools/textdetail",
      params: {text: text, titletext: "视频详情"}
    })
  },
  async AddToFav() {
    if (this.stared) {
      var result = await global.biliclient.unstarVideoFromDefaultFavFolderByBVID(this.vid.bvid)
      var message = result === 0 ? "取消收藏成功" : "取消收藏失败"
      prompt.showToast({message: message})
    } else {
      var result = await global.biliclient.starVideoToDefaultFavFolderByBVID(this.vid.bvid)
      var message = result === 0 ? "收藏成功" : "收藏失败"
      prompt.showToast({message: message})
    }
    this.UpdateVideoToolbarStatus()
  },
  async GenBlur(evt) {
    // 该Feature在现在任何设备上运行都会卡死，故注释
    /*
      global.logger.log(`\n[GenBlur] 开始处理封面取色模糊`);
      await kmeansCircleGradientImage(evt.detail.uri)
    */
  },
  GoReplyArea() {
    router.push({
      uri: "pages/reply/replys",
      params: {
        type: 1,
        oid: this.vid.aid,
        replycount: this.vid.stat.reply
      }
    })
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./videodetail.less";
</style>
