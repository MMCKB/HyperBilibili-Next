<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>
<import name="default-button" src="@components/DefaultButton/DefaultButton.ux"></import>

<template>
  <div class="page">
    <title-bar title="frameviewer.title"></title-bar>

    <!-- 加载中 -->
    <div if="{{ loading }}" class="status">
      <text class="statustext">{{ loadingText }}</text>
      <text class="loadinghint">{{ $t("frameviewer.hint") }}</text>
    </div>

    <!-- 加载失败 -->
    <div if="{{ loadFailed }}" class="status">
      <image class="failicon" src="/common/warning_icon.png"></image>
      <text class="statustext failtext">{{ failText }}</text>
      <text if="{{ failDetail }}" class="faildetail">{{ failDetail }}</text>
      <default-button text="frameviewer.retry" margin-top="30px" @click="Retry"></default-button>
    </div>

    <!-- 帧播放器 -->
    <div if="{{ ready }}" class="viewer">
      <div class="framearea" @click="TogglePlay">
        <div class="frame" style="{{ frameStyle }}"></div>
      </div>
      <div class="controls">
        <image class="ctrlicon" src="/common/icon/prev.png" @click="Step(-1)"></image>
        <image class="ctrlicon" style="width: 60px; height: 60px" src="{{ playIcon }}" @click="TogglePlay"></image>
        <image class="ctrlicon" src="/common/icon/next.png" @click="Step(1)"></image>
        <div class="speedbtn" @click="CycleSpeed">
          <text class="speedtext">{{ speed }}x</text>
        </div>
        <image class="ctrlicon" src="/common/icon/exit.png" @click="Exit"></image>
      </div>
      <progress class="frameprogress" percent="{{ progress }}"></progress>
      <text class="timetext">{{ currentTimeText }} / {{ totalTimeText }}</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import request from "@system.request"
import storage from "@system.storage"

import { asyncFile } from "../../../asyncapi/file"

// 帧显示区域尺寸（16:9）
// 注意：显示区域 × 雪碧图网格数（10x10）会得到整图显示尺寸，
// 384 * 10 = 3840 必须小于嵌入式 GPU 常见的 4096 纹理上限
const FRAME_WIDTH = 384
const FRAME_HEIGHT = 216

export default {
  public: {
    bvid: ""
  },
  private: {
    loading: true,
    loadingText: "",
    loadFailed: false,
    failText: "",
    failDetail: "",
    ready: false,
    playing: false,
    speed: 1,
    frameIndex: 0,
    frameCount: 0,
    progress: 0,
    currentTimeText: "0:00",
    totalTimeText: "0:00",
    playIcon: "/common/icon/play.png",
    // 渲染绑定：整段动态样式（项目内 picturedetail/HtmlRenderer 均采用此写法）
    frameStyle: "",
    // 内部数据
    spriteUris: [],
    timeline: [],
    imgXLen: 10,
    imgYLen: 10,
    tilesPerSprite: 100,
    totalDuration: 0,
    timerId: null
  },
  onInit() {
    global.logger.log("[frameviewer] load bvid: " + this.bvid)
    this.Load()
  },
  onHide() {
    if (this.playing) {
      this.playing = false
      this.playIcon = "/common/icon/play.png"
    }
    this.ClearTimer()
  },
  onDestroy() {
    this.ClearTimer()
  },

  // ---------- 加载 ----------
  async Load() {
    this.loading = true
    this.loadFailed = false
    this.ready = false
    this.playing = false
    this.failDetail = ""
    this.ClearTimer()
    try {
      // 优先使用本地缓存
      const cached = await this.LoadCacheManifest()
      if (cached) {
        this.ApplyData(cached)
        return
      }

      this.loadingText = this.$t("frameviewer.loadingInfo")
      const info = await global.biliclient.getVideoInfoByBVID(this.bvid)
      if (!info || !info.cid) {
        this.Fail(this.$t("frameviewer.failNoShot"), `getVideoInfo 无 cid (bvid=${this.bvid})`)
        return
      }

      this.loadingText = this.$t("frameviewer.loadingShot")
      let shot
      try {
        shot = await global.biliclient.getVideoVideoshot(this.bvid, String(info.cid))
      } catch (apiErr) {
        // 接口异常（风控/网络），把具体错误透出到诊断区
        this.Fail(this.$t("frameviewer.failShotApi"), apiErr.toString())
        return
      }
      if (!shot) {
        this.Fail(this.$t("frameviewer.failNoShot"), `cid=${info.cid} 无雪碧图数据`)
        return
      }

      const imageUrls = shot.image || []
      const localUris = []
      for (let i = 0; i < imageUrls.length; i++) {
        this.loadingText = `${this.$t("frameviewer.loadingDownload")} (${i + 1}/${imageUrls.length})`
        const uri = await this.DownloadSprite(imageUrls[i], i)
        if (!uri) {
          this.Fail(this.$t("frameviewer.failDownload"), `第 ${i + 1} 张下载失败: ${imageUrls[i]}`)
          return
        }
        localUris.push(uri)
      }

      const manifest = {
        v: 2,
        bvid: this.bvid,
        spriteUris: localUris,
        timeline: this.NormalizeTimeline(shot.index, info.duration || 0),
        imgXLen: shot.img_x_len || 10,
        imgYLen: shot.img_y_len || 10,
        totalDuration: info.duration || 0
      }
      this.SaveCacheManifest(manifest)
      this.ApplyData(manifest)
    } catch (e) {
      global.logger.error("[frameviewer] Load error: " + e.toString())
      this.Fail(this.$t("frameviewer.failGeneric"), e.toString())
    }
  },
  Retry() {
    this.Load()
  },
  Fail(message, detail) {
    this.loading = false
    this.ready = false
    this.loadFailed = true
    this.failText = message
    this.failDetail = detail || ""
    if (detail) {
      global.logger.error("[frameviewer] fail: " + detail)
    }
  },

  // 解析时间轴
  // 接口返回的 index 数组：index[0] 恒为 0 占位，index[i] 是第 i 帧的截取时间（秒）
  // 转换为 [[起始, 结束], ...] 形式；最后一帧以视频总时长收尾
  NormalizeTimeline(raw, duration) {
    if (!Array.isArray(raw) || raw.length < 2) {
      return []
    }
    const times = raw.slice(1)
    const result = []
    for (let i = 0; i < times.length; i++) {
      const start = times[i]
      let end = i + 1 < times.length ? times[i + 1] : start
      if (duration > start && end <= start) {
        end = duration
      }
      result.push([start, end])
    }
    return result
  },

  DownloadSprite(url, index) {
    const that = this
    return new Promise((resolve) => {
      const filename = `fvr_${that.bvid}_${index}.jpg`
      // 接口返回的图片 URL 是协议相对形式（//i0.hdslb.com/...），必须补全协议
      let fullUrl = url
      if (typeof fullUrl === "string" && fullUrl.startsWith("//")) {
        fullUrl = `https:${fullUrl}`
      }
      let retried = false
      const attempt = (useHeader) => {
        const options = {
          url: fullUrl,
          filename,
          success: (res) => {
            request.onDownloadComplete({
              token: res.token,
              success: (result) => {
                const uri = result && result.uri
                if (!uri) {
                  resolve(null)
                  return
                }
                // 下载目录（cache）对 background-image 的兼容性未经验证，
                // 统一复制到 internal://files/frameviewer/ 下再引用
                that.CopyToFiles(uri, filename).then((finalUri) => {
                  resolve(finalUri || uri)
                })
              },
              fail: (err) => {
                global.logger.error(`[frameviewer] onDownloadComplete fail(${index}): ` + JSON.stringify(err))
                resolve(null)
              }
            })
          },
          fail: (err) => {
            global.logger.error(`[frameviewer] download fail(${index}): ` + JSON.stringify(err))
            if (!useHeader && !retried) {
              retried = true
              attempt(true)
            } else {
              resolve(null)
            }
          }
        }
        if (useHeader) {
          options.header = JSON.stringify({
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:129.0) Gecko/20100101 Firefox/129.0",
            "Referer": "https://www.bilibili.com"
          })
        }
        request.download(options)
      }
      attempt(false)
    })
  },

  // 将下载的文件复制到 internal://files/frameviewer/，返回新 uri；失败返回 null（调用方回退原 uri）
  async CopyToFiles(uri, filename) {
    try {
      const dir = "internal://files/frameviewer"
      try {
        await asyncFile.mkdir({ uri: dir, recursive: true })
      } catch (e) {
        // 目录已存在等情况，忽略
      }
      const dst = `${dir}/${filename}`
      try {
        await asyncFile.delete({ uri: dst })
      } catch (e) {
        // 目标不存在，忽略
      }
      await asyncFile.copy({ srcUri: uri, dstUri: dst })
      return dst
    } catch (e) {
      global.logger.error("[frameviewer] CopyToFiles fail: " + e.toString())
      return null
    }
  },

  // ---------- 缓存 ----------
  LoadCacheManifest() {
    const that = this
    return new Promise((resolve) => {
      storage.get({
        key: `frameviewer_${that.bvid}`,
        success: async (data) => {
          if (!data) {
            resolve(null)
            return
          }
          try {
            const manifest = JSON.parse(data)
            // 版本不匹配或字段缺失的旧缓存直接弃用
            if (manifest.v !== 2 || !manifest.spriteUris || !manifest.spriteUris.length || !manifest.timeline || !manifest.timeline.length) {
              resolve(null)
              return
            }
            for (const uri of manifest.spriteUris) {
              const exists = await asyncFile.access({ uri })
              if (!exists) {
                resolve(null)
                return
              }
            }
            resolve(manifest)
          } catch (e) {
            resolve(null)
          }
        },
        fail: () => resolve(null)
      })
    })
  },
  SaveCacheManifest(manifest) {
    storage.set({
      key: `frameviewer_${this.bvid}`,
      value: JSON.stringify(manifest),
      success: () => {},
      fail: () => {}
    })
  },

  // ---------- 播放 ----------
  ApplyData(manifest) {
    this.spriteUris = manifest.spriteUris
    this.timeline = manifest.timeline
    // img_x_len/img_y_len 是雪碧图每行/每列的小图数量（一般 10x10）
    this.imgXLen = manifest.imgXLen || 10
    this.imgYLen = manifest.imgYLen || 10
    this.tilesPerSprite = this.imgXLen * this.imgYLen
    this.frameCount = this.timeline.length
    this.totalDuration = manifest.totalDuration ||
      (this.frameCount > 0 ? this.timeline[this.frameCount - 1][1] : 0)
    this.frameIndex = 0
    this.totalTimeText = this.FormatTime(this.totalDuration)
    this.UpdateFrame()
    this.loading = false
    this.loadFailed = false
    this.ready = true
    this.playing = true
    this.playIcon = "/common/icon/pause.png"
    this.ScheduleNext()
  },
  UpdateFrame() {
    if (this.frameCount === 0) {
      return
    }
    const fi = Math.min(this.frameIndex, this.frameCount - 1)
    const spriteIndex = Math.min(Math.floor(fi / this.tilesPerSprite), this.spriteUris.length - 1)
    const tileIndex = fi % this.tilesPerSprite
    const uri = this.spriteUris[spriteIndex] || ""
    const row = Math.floor(tileIndex / this.imgXLen)
    const col = tileIndex % this.imgXLen
    // 整段拼接动态样式：url() 内不嵌套插值，遵循项目内已验证的 style 绑定写法
    this.frameStyle = `background-image: url(${uri}); background-size: ${this.imgXLen * FRAME_WIDTH}px ${this.imgYLen * FRAME_HEIGHT}px; background-position: -${col * FRAME_WIDTH}px -${row * FRAME_HEIGHT}px; background-repeat: no-repeat;`
    const t = this.timeline[fi] || [0, 0]
    this.currentTimeText = this.FormatTime(t[0])
    this.progress = this.frameCount > 1 ? Math.floor((fi / (this.frameCount - 1)) * 100) : 100
  },
  ScheduleNext() {
    this.ClearTimer()
    if (!this.playing || !this.ready || this.frameCount === 0) {
      return
    }
    const t = this.timeline[Math.min(this.frameIndex, this.frameCount - 1)]
    if (!t) {
      return
    }
    const durMs = Math.max(300, ((t[1] - t[0]) * 1000) / this.speed)
    this.timerId = setTimeout(() => {
      this.Advance(1)
    }, durMs)
  },
  Advance(dir) {
    let next = this.frameIndex + dir
    if (next < 0) {
      next = 0
    }
    if (next >= this.frameCount - 1) {
      next = this.frameCount - 1
      if (this.playing) {
        // 播完自动暂停
        this.playing = false
        this.playIcon = "/common/icon/play.png"
      }
    }
    this.frameIndex = next
    this.UpdateFrame()
    if (this.playing) {
      this.ScheduleNext()
    }
  },
  TogglePlay() {
    if (!this.ready) {
      return
    }
    this.playing = !this.playing
    this.playIcon = this.playing ? "/common/icon/pause.png" : "/common/icon/play.png"
    if (this.playing) {
      if (this.frameIndex >= this.frameCount - 1) {
        this.frameIndex = 0
        this.UpdateFrame()
      }
      this.ScheduleNext()
    } else {
      this.ClearTimer()
    }
  },
  Step(dir) {
    if (!this.ready || this.frameCount === 0) {
      return
    }
    this.ClearTimer()
    this.playing = false
    this.playIcon = "/common/icon/play.png"
    let next = this.frameIndex + dir
    if (next < 0) {
      next = 0
    }
    if (next > this.frameCount - 1) {
      next = this.frameCount - 1
    }
    this.frameIndex = next
    this.UpdateFrame()
  },
  CycleSpeed() {
    const speeds = [1, 2, 4, 8]
    const idx = speeds.indexOf(this.speed)
    this.speed = speeds[(idx + 1) % speeds.length]
    if (this.playing) {
      this.ScheduleNext()
    }
    prompt.showToast({ message: `${this.speed}x`, duration: 800 })
  },
  Exit() {
    this.ClearTimer()
    router.back()
  },
  ClearTimer() {
    if (this.timerId !== null) {
      clearTimeout(this.timerId)
      this.timerId = null
    }
  },
  FormatTime(seconds) {
    if (!seconds || seconds < 0) {
      return "0:00"
    }
    const min = Math.floor(seconds / 60)
    const sec = Math.floor(seconds % 60)
    return `${min}:${sec < 10 ? "0" + sec : sec}`
  }
}
</script>

<style lang="less">
@import '@less/global.less';
@import "./frameviewer.less";
</style>
