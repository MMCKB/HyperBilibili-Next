<template>
  <div>
    <text style="position: absolute; color: rgba(0, 0, 0, 0)">{{ anims.pagediv_mgt.value }}</text>
    <div class="page" style="margin-top: {{ anims.pagediv_mgt.value }}px">
      <text style="font-weight: bold; margin-top: 35px">{{ $t("login.scanToLogin") }}</text>
      <div class="qr_code">
        <qrcode value="{{qr_value}}" show="{{show_qr}}" style="width: 210px; height: 210px"></qrcode>
        <image style="position: absolute" show="{{anims.show_loading}}" src="{{anims.loading_src.value}}"></image>
      </div>
      <text style="margin-top: 20px; font-size: 26px; font-weight: bold">{{ $t("login.goToOfficialApp") }}</text>
      <text style="font-size: 20px">{{ $t("login.doScan") }}</text>
      <!-- 已存账号快捷登录：仅在退出账号后的正常登录页显示；
           从账号切换页"添加账号"进入的二维码页不显示（那里本来就有账号列表） -->
      <div class="acctbtn" if="{{mode !== 'addaccount'}}" @click="OpenAccountPopup">
        <text class="acctbtn-text">选择已有账号</text>
      </div>

      <!-- 账号选择弹层（应用内自绘，列表支持滚动） -->
      <div class="acct-mask" if="{{showAcctPopup}}">
        <div class="acct-card">
          <text class="acct-card-title">选择要登录的账号</text>
          <scroll class="acct-scroll" scroll-y="true" bounces="true" if="{{popupAccounts.length > 0}}">
            <div class="acct-item" for="{{popupAccounts}}" @click="PickAccount($item.mid)">
              <image class="acct-item-face" src="{{$item.face}}@106w_106h"></image>
              <div class="acct-item-info">
                <text class="acct-item-name">{{$item.uname}}</text>
                <text class="acct-item-mid">UID {{$item.mid}}</text>
              </div>
              <image class="acct-item-arrow" src="/common/arrow_right.png"></image>
            </div>
            <div style="height: 10px"></div>
          </scroll>
          <div class="acct-empty" if="{{popupAccounts.length === 0}}">
            <text class="acct-empty-text">当前无账号可以登录</text>
          </div>
          <div class="acct-close" @click="CloseAcctPopup">
            <text class="acct-close-text">取消</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import prompt from "@system.prompt"
import router from "@system.router"

export default {
  props: ["mode"],
  private: {
    qr_value: "",
    show_qr: false,
    qrpoll_interval: null,
    // 轮询防重叠：网络慢时 1.5s 定时器会在上一次请求返回前再次触发
    // 两个 login() 并发执行会交错读写账号存储，可能互相覆盖
    polling: false,
    loginDone: false,
    // 账号选择弹层
    showAcctPopup: false,
    popupAccounts: [],
    anims: {
      show_loading: false,
      pagediv: null,
      pagediv_mgt: {value: "800"}
    }
  },
  async PollQR() {
    if (this.polling || this.loginDone) return
    this.polling = true
    try {
      // 二维码页只负责扫码：始终忽略本地已存账号（含激活账号）
      // 能走到这一页说明要走扫码流程，否则会立即"登录成功"跳走
      const result = await global.biliclient.login(true, this.qrpoll_interval, true)
      if (result.success) {
        this.loginDone = true
        global.logger.log("登录成功")
        // 账号已由 login() 内部 commitCurrentAccount 写入单账号键+列表+激活标记+文件镜像
        prompt.showToast({message: "登录成功"})
        clearInterval(this.qrpoll_interval)
        if (this.mode === "addaccount") {
          // 添加账号模式：清栈回账号切换页查看/继续切换
          router.clear()
          router.replace({uri: "pages/app/features/mypage/accountswitch"})
        } else {
          router.replace({uri: "pages/app/entry/introduction"})
        }
      } else if (result.message.includes("登录失败")) {
        prompt.showToast({message: result.message, duration: 5000})
      }
    } catch (error) {
      global.logger.error("轮询QR登录时出错:", error)
    } finally {
      this.polling = false
    }
  },
  async GetQR() {
    try {
      const get_result = await global.biliclient.loginQR()
      this.qr_value = get_result.url
      global.logger.log(get_result)
      this.show_qr = true
      this.anims.show_loading = false

      this.qrpoll_interval = setInterval(() => this.PollQR(), 1500)
    } catch (error) {
      global.logger.error("获取QR码时出错:", error)
      prompt.showToast({message: "无法获取QR码，请重试", duration: 3000})
      this.anims.show_loading = false
    }
  },
  // 打开账号选择弹层：先读多账号列表（退出登录后剩的就是可登的账号）
  OpenAccountPopup() {
    global.biliclient.getStoredAccountsList().then((accounts) => {
      this.popupAccounts = (accounts || []).map((a) => ({
        mid: a.mid,
        uname: a.uname || "B站用户",
        face: a.face || ""
      }))
      this.showAcctPopup = true
    }).catch((e) => {
      // 读取失败也弹窗展示空态，不让用户卡住
      global.logger.error("加载已存账号列表失败:", e.toString())
      this.popupAccounts = []
      this.showAcctPopup = true
    })
  },
  CloseAcctPopup() {
    this.showAcctPopup = false
  },
  // 选中账号直接登录：等同账号切换页的 SwitchAccount
  async PickAccount(mid) {
    this.showAcctPopup = false
    // 停掉扫码轮询：选中账号期间不再走二维码登录路径
    this.loginDone = true
    clearInterval(this.qrpoll_interval)
    prompt.showToast({message: "正在登录...", duration: 1500})

    try {
      const ok = await global.biliclient.switchToAccount(String(mid))
      if (ok) {
        // 会话已失效时 updateAccountInfo 已跳会话失效页，这里不再二次跳转
        const info = global.biliclient.accountInfo
        if (!info || !info.isLogin) return
        prompt.showToast({message: "登录成功", duration: 1500})
        if (this.mode === "addaccount") {
          router.clear()
          router.replace({uri: "pages/app/features/mypage/accountswitch"})
        } else {
          router.replace({uri: "pages/app/entry/introduction"})
        }
      } else {
        this.RestartPoll()
        prompt.showToast({message: "账号已失效，请扫码重新登录", duration: 3000})
      }
    } catch (error) {
      global.logger.error("选择账号登录失败:", error.toString())
      this.RestartPoll()
      prompt.showToast({message: "登录失败，请重试", duration: 3000})
    }
  },
  // 恢复扫码轮询（选账号失败时，二维码登录路径继续可用）
  RestartPoll() {
    this.loginDone = false
    this.qrpoll_interval = setInterval(() => this.PollQR(), 1500)
  },
  onReady() {
    const {pagediv_mgt, loading_img_src} = this.anims

    this.anims.pagediv = new global.animengine.DomAnim(
      "loginPage",
      {value: "0"},
      pagediv_mgt,
      0,
      0,
      250
    )
    if (this.anims.pagediv) this.anims.pagediv.start()

    global.animengine.defaults.loading.CreateLoadingAnimation(this, false)
    this.anims.loading.start()

    this.GetQR()
  }
}
</script>

<style lang="less">
@import '@less/global.less';

.qr_code {
  margin-top: 30px;
  width: 233px;
  height: 233px;
  align-items: center;
  justify-content: center;
  border-radius: 5%;
  background-color: white;
}

// 选择已有账号按钮：粉色描边胶囊
// 尺寸按 Redmi Watch 5 矩形屏（418×526，designWidth 432）
.acctbtn {
  margin-top: 35px;
  width: 360px;
  height: 84px;
  border-radius: 90px;
  border: 2px solid rgba(251, 114, 153, 0.6);
  align-items: center;
  justify-content: center;
}

.acctbtn-text {
  font-size: 30px;
  color: #fb7299;
  font-weight: 600;
}

// 账号选择弹层（矩形屏版：卡片近满宽，列表高、可滚动）
.acct-mask {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  justify-content: center;
  align-items: center;
}

.acct-card {
  width: 396px;
  border-radius: 36px;
  background-color: #1c1c1c;
  flex-direction: column;
  align-items: center;
  padding-top: 30px;
  padding-bottom: 26px;
}

.acct-card-title {
  font-size: 32px;
  font-weight: 600;
  color: #ffffff;
}

// 多账号时列表可滚动：约容纳 3 个账号条目，更多则滚动
.acct-scroll {
  width: 370px;
  height: 300px;
  margin-top: 15px;
}

.acct-item {
  width: 362px;
  margin-top: 12px;
  padding: 14px 18px;
  border-radius: 28px;
  background-color: rgba(44, 44, 46, 1);
  flex-direction: row;
  align-items: center;
}

.acct-item-face {
  width: 76px;
  height: 76px;
  border-radius: 38px;
}

.acct-item-info {
  flex-direction: column;
  margin-left: 16px;
  flex-size: 1;
}

.acct-item-name {
  font-size: 30px;
  color: white;
  font-weight: 600;
}

.acct-item-mid {
  font-size: 22px;
  color: #999999;
  margin-top: 4px;
}

.acct-item-arrow {
  width: 32px;
  height: 32px;
  object-fit: scale-down;
}

// 空态：无账号可登录
.acct-empty {
  width: 320px;
  height: 200px;
  margin-top: 15px;
  justify-content: center;
  align-items: center;
}

.acct-empty-text {
  font-size: 28px;
  color: #9e9e9e;
}

.acct-close {
  width: 330px;
  height: 80px;
  border-radius: 90px;
  background-color: #333333;
  justify-content: center;
  align-items: center;
  margin-top: 20px;
}

.acct-close-text {
  font-size: 30px;
  font-weight: 600;
  color: #ffffff;
}
</style>