<import name="default-button" src="@components/DefaultButton/DefaultButton.ux"></import>

<template>
  <div class="page">
    <text style="position: absolute; color: rgba(0, 0, 0, 0)">
      {{ anims.splashimg.margin_top_str }}
    </text>
    <image class="splashlogo" src="/common/logo.png"
      style="margin-top: {{ anims.splashimg.margin_top_str.value }}px; margin-left: {{ anims.splashimg.margin_left_str.value }}px">
    </image>
    <div class="first-launch-button" if="{{showFirstLaunchButton}}">
      <default-button
        primary="true"
        text="splash.start"
        @click="StartFirstLaunch">
      </default-button>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
export default {
  private: {
    showFirstLaunchButton: false,
    anims: {
      splash: null,
      splash_out: null,
      splashimg: {
        margin_top_str: {
          value: "800"
        },
        margin_left_str: {
          value: "0"
        }
      }
    }
  },
  onShow() {
    this.anims.splash = new global.animengine.DomAnim(
      "splashPage",
      this.anims.splashimg.margin_top_str,
      this.anims.splashimg.margin_left_str,
      0,
      0,
      100
    )
    this.anims.splash_out = new global.animengine.DomAnim(
      "splashPage",
      this.anims.splashimg.margin_top_str,
      this.anims.splashimg.margin_left_str,
      800,
      0,
      100
    )
    this.anims.splash.start()
    setTimeout(() => {
      this.anims.splash_out.start()
      setTimeout(() => this.FinishSplashFlow(), 500)
    }, 1000)
  },
  async FinishSplashFlow() {
    if (!(await this.$app.$def.jumpcheck.NetworkCheck())) {
      router.replace({
        uri: "pages/error/networkerror"
      })
      return
    }

    if (!global.settings.SETTINGS.agreedAllAgreements) {
      this.showFirstLaunchButton = true
      return
    }

    this.$app.$def.jumpcheck.Jump()
  },
  StartFirstLaunch() {
    this.showFirstLaunchButton = false
    router.replace({
      uri: "pages/app/entry/eularead"
    })
  },
  onDestroy() {
    global.animengine.clearPageAnims("splashPage")
  }
}
</script>

<style lang="less">
.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: absolute;
  width: 100%;
  background-color: rgb(0, 0, 0);
}

.splashlogo {
  display: flex;
  justify-content: center;
  align-items: center;
}

.first-launch-button {
  position: absolute;
  bottom: 50px;
  width: 100%;
  display: flex;
  align-items: center;
  animation-name: first-launch-button-fade-in;
  animation-duration: 350ms;
  animation-timing-function: ease-out;
  animation-fill-mode: both;
}

@keyframes first-launch-button-fade-in {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}
</style>