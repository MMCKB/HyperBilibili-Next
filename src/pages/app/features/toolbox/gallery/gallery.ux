<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>

<template>
  <div class="page">
    <scroll class="scroll {{scrclass}}" scroll-y="true" bounces="false">
      <title-bar title="gallery.title"></title-bar>
      <div class="gallery-transfer-card">
        <div class="gallery-transfer-mark"><text class="gallery-transfer-mark-text">↥</text></div>
        <div class="gallery-transfer-copy">
          <text class="gallery-transfer-title">{{ $t("gallery.transferHint") }}</text>
          <text class="gallery-transfer-status">{{ transferStatus }}</text>
        </div>
      </div>
      <text class="gallery-empty" if="{{!hasItems}}">{{ $t("gallery.empty") }}</text>
      <div class="gallery-grid" if="{{hasItems}}">
        <div class="gallery-column">
          <div class="gallery-card" for="{{leftItems}}" onclick="OpenItem($item.id)">
            <image class="gallery-card-image" src="{{ $item.uri }}"></image>
            <text class="gallery-card-name">{{ $item.name }}</text>
            <text class="gallery-card-date">{{ $item.createdAt }}</text>
          </div>
        </div>
        <div class="gallery-column gallery-right-column">
          <div class="gallery-card" for="{{rightItems}}" onclick="OpenItem($item.id)">
            <image class="gallery-card-image" src="{{ $item.uri }}"></image>
            <text class="gallery-card-name">{{ $item.name }}</text>
            <text class="gallery-card-date">{{ $item.createdAt }}</text>
          </div>
        </div>
      </div>
      <text style="height: 28px"></text>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import { interconnect } from "@src/tsimports.js"
import { abortGalleryTransfer, appendGalleryTransferChunk, beginGalleryTransfer, finishGalleryTransfer, listGalleryItems, setActiveGalleryItemId } from "@src/gallery.ts"

export default {
  private: {
    scrclass: "",
    hasItems: false,
    leftItems: [],
    rightItems: [],
    transferStatus: ""
  },
  SplitItems(items) {
    const left = []
    const right = []
    items.forEach((item, index) => {
      if (index % 2 === 0) left.push(item)
      else right.push(item)
    })
    this.leftItems = left
    this.rightItems = right
    this.hasItems = items.length > 0
  },
  async LoadItems() {
    const items = await listGalleryItems()
    this.SplitItems(items)
  },
  GetConnection() {
    try {
      return interconnect.instance()
    } catch (error) {
      return null
    }
  },
  SendBridgeMessage(data) {
    const connection = this.GetConnection()
    if (!connection) return
    connection.send({ data, success: () => {}, fail: () => {} })
  },
  ParseIncoming(raw) {
    const text = raw && raw.data !== undefined ? raw.data : raw
    try {
      return typeof text === "string" ? JSON.parse(text) : text
    } catch (error) {
      return null
    }
  },
  async HandleBridgeMessage(raw) {
    const message = this.ParseIncoming(raw)
    if (!message || !message.tag) return
    if (message.tag === "gallery-begin") {
      const transfer = await beginGalleryTransfer(message)
      if (!transfer) {
        this.transferStatus = this.$t("gallery.receiveFailed")
        this.SendBridgeMessage({ tag: "gallery-error", id: message.id, reason: "begin-failed" })
        return
      }
      this.transferStatus = this.$t("gallery.receiving") + " 0%"
      this.SendBridgeMessage({ tag: "gallery-ready", id: transfer.id })
      return
    }
    if (message.tag === "gallery-chunk") {
      const result = await appendGalleryTransferChunk(message)
      if (!result.ok) {
        this.transferStatus = this.$t("gallery.receiveFailed")
        await abortGalleryTransfer(result.id)
        this.SendBridgeMessage({ tag: "gallery-error", id: result.id, index: result.index, reason: "chunk-failed" })
        return
      }
      const total = Math.max(1, Number(message.total || 1))
      this.transferStatus = this.$t("gallery.receiving") + " " + Math.floor(((result.index + 1) / total) * 100) + "%"
      this.SendBridgeMessage({ tag: "gallery-ack", id: result.id, index: result.index })
      return
    }
    if (message.tag === "gallery-end") {
      const item = await finishGalleryTransfer(message)
      if (!item) {
        this.transferStatus = this.$t("gallery.receiveFailed")
        this.SendBridgeMessage({ tag: "gallery-error", id: message.id, reason: "finish-failed" })
        return
      }
      this.transferStatus = this.$t("gallery.received")
      prompt.showToast({ message: this.transferStatus, duration: 1800 })
      this.SendBridgeMessage({ tag: "gallery-complete", id: item.id })
      this.LoadItems()
    }
  },
  BindBridge() {
    const connection = this.GetConnection()
    this.transferStatus = this.$t("gallery.transferReady")
    if (!connection) return
    connection.onmessage = (data) => this.HandleBridgeMessage(data)
    connection.onopen = () => {
      this.transferStatus = this.$t("gallery.transferReady")
      this.SendBridgeMessage({ tag: "gallery-handshake", version: 1 })
    }
  },
  OpenItem(id) {
    setActiveGalleryItemId(id)
    router.push({ uri: "pages/app/features/toolbox/gallery/viewer" })
  },
  onShow() {
    this.LoadItems()
    this.BindBridge()
  },
  onInit() {
    global.ui.InitPage(this)
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./gallery.less";
</style>
