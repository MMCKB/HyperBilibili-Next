<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>
<import name="full-screen-input" src="@components/FullScreenInput/FullScreenInput.ux"></import>

<template>
  <div class="page">
    <scroll class="ai-config-scroll {{scrclass}}" scroll-y="true" bounces="false">
      <title-bar title="aiChat.settingsTitle"></title-bar>
      <div class="ai-config-content">
        <div class="ai-config-selector" onclick="CycleProvider">
          <text class="ai-config-label">{{ $t("aiChat.provider") }}</text>
          <div class="ai-config-selector-copy">
            <text class="ai-config-selector-value">{{ providerDisplay }}</text>
            <text class="ai-config-selector-count">{{ providerCountText }}</text>
          </div>
          <text class="ai-config-arrow">›</text>
        </div>
        <div class="ai-config-action" onclick="AddProvider"><text class="ai-config-action-text">{{ $t("aiChat.addProvider") }}</text></div>
        <div class="ai-config-action ai-config-delete" onclick="DeleteProvider"><text class="ai-config-action-text ai-config-delete-text">{{ $t("aiChat.deleteProvider") }}</text></div>
        <div class="ai-config-card" onclick="EditProvider">
          <text class="ai-config-label">{{ $t("aiChat.providerName") }}</text>
          <text class="ai-config-value">{{ providerDisplay }}</text>
          <text class="ai-config-arrow">›</text>
        </div>
        <div class="ai-config-selector" onclick="CycleModel">
          <text class="ai-config-label">{{ $t("aiChat.model") }}</text>
          <div class="ai-config-selector-copy">
            <text class="ai-config-selector-value">{{ modelDisplay }}</text>
            <text class="ai-config-selector-count">{{ modelCountText }}</text>
          </div>
          <text class="ai-config-arrow">›</text>
        </div>
        <div class="ai-config-action" onclick="StartAddModel"><text class="ai-config-action-text">{{ $t("aiChat.addModel") }}</text></div>
        <div class="ai-config-action ai-config-delete" onclick="DeleteModel"><text class="ai-config-action-text ai-config-delete-text">{{ $t("aiChat.deleteModel") }}</text></div>
        <div class="ai-config-card" onclick="EditHost">
          <text class="ai-config-label">{{ $t("aiChat.apiHost") }}</text>
          <text class="ai-config-value">{{ apiHostDisplay }}</text>
          <text class="ai-config-arrow">›</text>
        </div>
        <div class="ai-config-card" onclick="EditPath">
          <text class="ai-config-label">{{ $t("aiChat.apiPath") }}</text>
          <text class="ai-config-value">{{ apiPathDisplay }}</text>
          <text class="ai-config-arrow">›</text>
        </div>
        <div class="ai-config-card" onclick="EditApiKey">
          <text class="ai-config-label">{{ $t("aiChat.apiKey") }}</text>
          <text class="ai-config-value">{{ apiKeyDisplay }}</text>
          <text class="ai-config-arrow">›</text>
        </div>
        <div class="ai-config-card" onclick="EditHeaders">
          <text class="ai-config-label">{{ $t("aiChat.extraHeaders") }}</text>
          <text class="ai-config-value">{{ headersDisplay }}</text>
          <text class="ai-config-arrow">›</text>
        </div>
        <div class="ai-config-card" onclick="EditBody">
          <text class="ai-config-label">{{ $t("aiChat.extraBody") }}</text>
          <text class="ai-config-value">{{ bodyDisplay }}</text>
          <text class="ai-config-arrow">›</text>
        </div>
        <div class="ai-config-status" if="{{statusText}}"><text class="ai-config-status-text">{{ statusText }}</text></div>
        <div class="ai-config-save" onclick="SaveAndBack"><text class="ai-config-save-text">{{ $t("aiChat.saveConfiguration") }}</text></div>
      </div>
      <text class="ai-config-bottom-spacer"></text>
    </scroll>
    <full-screen-input style="position: absolute" if="{{showInput}}" initial-text="{{inputSeed}}" @send="FinishInput" @exit="ExitInput"></full-screen-input>
  </div>
</template>

<script>
import prompt from "@system.prompt"
import { AI_SETTINGS, addAIModel, addAIProvider, deleteActiveAIModel, deleteActiveAIProvider, getAIModelCount, getAIProviderCount, loadAISettings, saveAISettings, selectNextAIModel, selectNextAIProvider, updateActiveAIProvider } from "@src/ai.ts"

export default {
  private: {
    scrclass: "",
    providerDisplay: "--",
    providerCountText: "0/3",
    apiHostDisplay: "--",
    apiPathDisplay: "--",
    apiKeyDisplay: "--",
    modelDisplay: "--",
    modelCountText: "0/5",
    headersDisplay: "--",
    bodyDisplay: "--",
    statusText: "",
    showInput: false,
    inputTarget: "",
    inputSeed: ""
  },
  async onInit() {
    await this.RefreshSettings()
  },
  async onShow() {
    await this.RefreshSettings()
  },
  async RefreshSettings() {
    const settings = await loadAISettings()
    this.providerDisplay = settings.provider || this.$t("aiChat.notConfigured")
    this.providerCountText = String(getAIProviderCount(settings)) + "/3"
    this.apiHostDisplay = settings.apiHost || this.$t("aiChat.notConfigured")
    this.apiPathDisplay = settings.apiPath || "/chat/completions"
    this.apiKeyDisplay = settings.apiKey ? this.MaskApiKey(settings.apiKey) : this.$t("aiChat.notConfigured")
    this.modelDisplay = settings.model || this.$t("aiChat.notConfigured")
    this.modelCountText = String(getAIModelCount(settings)) + "/5"
    this.headersDisplay = settings.extraHeaders ? this.$t("aiChat.configured") : this.$t("aiChat.optional")
    this.bodyDisplay = settings.extraBody ? this.$t("aiChat.configured") : this.$t("aiChat.optional")
  },
  MaskApiKey(value) {
    const text = String(value || "")
    if (text.length <= 4) return "••••"
    return "••••••" + text.slice(-4)
  },
  StartEdit(target, value) {
    this.inputTarget = target
    this.inputSeed = value || ""
    this.showInput = true
  },
  EditProvider() { this.StartEdit("provider", AI_SETTINGS.provider) },
  EditHost() { this.StartEdit("host", AI_SETTINGS.apiHost) },
  EditPath() { this.StartEdit("path", AI_SETTINGS.apiPath) },
  EditApiKey() { this.StartEdit("key", AI_SETTINGS.apiKey) },
  EditHeaders() { this.StartEdit("headers", AI_SETTINGS.extraHeaders) },
  EditBody() { this.StartEdit("body", AI_SETTINGS.extraBody) },
  StartAddModel() { this.StartEdit("addModel", "") },
  async CycleProvider() {
    await selectNextAIProvider()
    await this.RefreshSettings()
  },
  async CycleModel() {
    await selectNextAIModel()
    await this.RefreshSettings()
  },
  async AddProvider() {
    try {
      await addAIProvider()
      this.statusText = ""
      await this.RefreshSettings()
    } catch (error) {
      this.statusText = this.$t("aiChat.providerLimit")
    }
  },
  async DeleteProvider() {
    try {
      await deleteActiveAIProvider()
      this.statusText = this.$t("aiChat.providerDeleted")
      await this.RefreshSettings()
    } catch (error) {
      this.statusText = this.$t("aiChat.noProviderToDelete")
    }
  },
  async DeleteModel() {
    try {
      await deleteActiveAIModel()
      this.statusText = this.$t("aiChat.modelDeleted")
      await this.RefreshSettings()
    } catch (error) {
      this.statusText = this.$t("aiChat.noModelToDelete")
    }
  },
  ExitInput() {
    this.showInput = false
    this.inputTarget = ""
    this.inputSeed = ""
  },
  async FinishInput(evt) {
    const value = String(evt.detail && evt.detail.content ? evt.detail.content : "").trim()
    if (!value) {
      this.ExitInput()
      return
    }
    try {
      if (this.inputTarget === "provider") await updateActiveAIProvider({ name: value })
      if (this.inputTarget === "host") await updateActiveAIProvider({ apiHost: value })
      if (this.inputTarget === "path") await updateActiveAIProvider({ apiPath: value })
      if (this.inputTarget === "key") await updateActiveAIProvider({ apiKey: value })
      if (this.inputTarget === "headers") await updateActiveAIProvider({ extraHeaders: value })
      if (this.inputTarget === "body") await updateActiveAIProvider({ extraBody: value })
      if (this.inputTarget === "addModel") await addAIModel(value)
      this.statusText = ""
    } catch (error) {
      this.statusText = this.inputTarget === "addModel" ? this.$t("aiChat.modelLimit") : this.$t("aiChat.saveFailed")
    }
    this.ExitInput()
    await this.RefreshSettings()
  },
  async SaveAndBack() {
    await saveAISettings({})
    prompt.showToast({ message: this.$t("aiChat.configurationSaved"), duration: 1600 })
    global.ui.OnBackPressTriggered()
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./aiconfig.less";
</style>
