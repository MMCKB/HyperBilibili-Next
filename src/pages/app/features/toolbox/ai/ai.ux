<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>
<import name="sendbox" src="@components/FloatingSendBox/FloatingSendBox.ux"></import>
<import name="full-screen-input" src="@components/FullScreenInput/FullScreenInput.ux"></import>

<template>
  <div class="page ai-chat-page {{scrclass}}" ontouchstart="HandlePageTouchStart" ontouchend="HandlePageTouchEnd">
    <title-bar title="aiChat.title"></title-bar>
    <div class="ai-chat-meta">
      <div class="ai-chat-provider">
        <text class="ai-chat-provider-model">{{ modelText }}</text>
        <text class="ai-chat-provider-label">{{ providerText }}</text>
      </div>
      <div class="ai-chat-meta-button ai-chat-switch" onclick="OpenProfilePicker"><text class="ai-chat-meta-button-text">{{ $t("aiChat.switch") }}</text></div>
      <div class="ai-chat-meta-button" onclick="OpenSettings"><text class="ai-chat-meta-button-text">{{ $t("aiChat.settings") }}</text></div>
      <div class="ai-chat-meta-button ai-chat-clear" onclick="ClearMessages"><text class="ai-chat-meta-button-text">{{ $t("aiChat.clear") }}</text></div>
    </div>
    <scroll class="ai-chat-scroll" scroll-y="true" id="ai-chat-scroll" bounces="false">
      <div class="ai-chat-content">
        <div if="{{!isConfigured}}" class="ai-chat-empty-card" onclick="OpenSettings">
          <text class="ai-chat-empty-title">{{ $t("aiChat.notReadyTitle") }}</text>
          <text class="ai-chat-empty-copy">{{ $t("aiChat.notReadyHint") }}</text>
          <text class="ai-chat-empty-action">{{ $t("aiChat.goToSettings") }}</text>
        </div>
        <div if="{{isConfigured && !hasMessages}}" class="ai-chat-empty-card">
          <text class="ai-chat-empty-title">{{ $t("aiChat.readyTitle") }}</text>
          <text class="ai-chat-empty-copy">{{ $t("aiChat.readyHint") }}</text>
        </div>
        <div for="{{visibleMessages}}">
          <div class="ai-chat-message-row ai-chat-user-row" if="{{ $item.role == 'user' }}">
            <div class="ai-chat-bubble ai-chat-user-bubble"><text class="ai-chat-bubble-text ai-chat-user-text">{{ $item.content }}</text></div>
          </div>
          <div class="ai-chat-message-row ai-chat-assistant-row" if="{{ $item.role == 'assistant' }}">
            <div class="ai-chat-bubble ai-chat-assistant-bubble"><text class="ai-chat-bubble-text">{{ $item.content }}</text></div>
          </div>
        </div>
        <div if="{{isSending}}" class="ai-chat-thinking"><text class="ai-chat-thinking-text">{{ $t("aiChat.thinking") }}</text></div>
        <div if="{{statusText}}" class="ai-chat-status"><text class="ai-chat-status-text">{{ statusText }}</text></div>
        <text class="ai-chat-bottom-spacer"></text>
      </div>
    </scroll>
    <sendbox input_text="{{inputPreview}}" @clickinput="OpenInput" @clicksend="OpenInput" style="position: absolute"></sendbox>
    <div class="ai-profile-picker-mask" if="{{showProfilePicker}}">
      <div class="ai-profile-picker">
        <text class="ai-profile-picker-title">{{ $t("aiChat.profilePickerTitle") }}</text>
        <scroll class="ai-profile-picker-list" scroll-y="true" bounces="false">
          <div class="ai-profile-picker-option" for="{{profileOptions}}" onclick="PickProfile($item.providerIndex, $item.modelIndex)">
            <div class="ai-profile-picker-copy">
              <text class="ai-profile-picker-model">{{ $item.modelName }}</text>
              <text class="ai-profile-picker-provider">{{ $item.providerName }}</text>
            </div>
            <text class="ai-profile-picker-active" if="{{ $item.active }}">✓</text>
          </div>
          <text class="ai-profile-picker-empty" if="{{!profileOptions.length}}">{{ $t("aiChat.noSavedModels") }}</text>
        </scroll>
        <div class="ai-profile-picker-close" onclick="CloseProfilePicker"><text class="ai-profile-picker-close-text">{{ $t("aiChat.close") }}</text></div>
      </div>
    </div>
    <full-screen-input style="position: absolute" if="{{showInput}}" initial-text="{{inputSeed}}" @send="FinishInput" @exit="ExitInput"></full-screen-input>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import { AI_SETTINGS, getAIProfileOptions, isAIReady, loadAISettings, selectAIProfile, sendAIChat } from "@src/ai.ts"

export default {
  private: {
    scrclass: "",
    messages: [],
    visibleMessages: [],
    hasMessages: false,
    isConfigured: false,
    isSending: false,
    providerText: "AI",
    modelText: "--",
    statusText: "",
    inputPreview: "",
    inputSeed: "",
    showInput: false,
    pageTouchStartX: -1,
    pageTouchStartY: -1,
    showProfilePicker: false,
    profileOptions: []
  },
  async onInit() {
    await this.RefreshSettings()
  },
  async onShow() {
    await this.RefreshSettings()
  },
  async RefreshSettings() {
    const settings = await loadAISettings()
    this.isConfigured = isAIReady(settings)
    this.providerText = settings.provider || this.$t("aiChat.customProvider")
    this.modelText = settings.model || this.$t("aiChat.notConfigured")
  },
  OpenSettings() {
    router.push({ uri: "pages/app/features/toolbox/ai/settings" })
  },
  GetTouchPoint(event) {
    const list = event && (event.changedTouches || event.touches)
    return list && list.length ? list[0] : null
  },
  HandlePageTouchStart(event) {
    if (this.showInput) return
    const point = this.GetTouchPoint(event)
    if (!point) return
    this.pageTouchStartX = Number(point.clientX)
    this.pageTouchStartY = Number(point.clientY)
  },
  HandlePageTouchEnd(event) {
    if (this.showInput || this.pageTouchStartX < 0 || this.pageTouchStartY < 0) return
    const point = this.GetTouchPoint(event)
    if (!point) return
    const deltaX = Number(point.clientX) - this.pageTouchStartX
    const deltaY = Number(point.clientY) - this.pageTouchStartY
    this.pageTouchStartX = -1
    this.pageTouchStartY = -1
    if (deltaX > 56 && Math.abs(deltaX) > Math.abs(deltaY)) global.ui.OnBackPressTriggered()
  },
  async OpenProfilePicker() {
    if (this.isSending) return
    const settings = await loadAISettings()
    this.profileOptions = getAIProfileOptions(settings)
    this.showProfilePicker = true
  },
  CloseProfilePicker() {
    this.showProfilePicker = false
  },
  async PickProfile(providerIndex, modelIndex) {
    if (this.isSending) return
    await selectAIProfile(Number(providerIndex), Number(modelIndex))
    this.showProfilePicker = false
    await this.RefreshSettings()
    this.messages = []
    this.visibleMessages = []
    this.hasMessages = false
    prompt.showToast({ message: this.$t("aiChat.switched"), duration: 1500 })
  },
  OpenInput() {
    if (!this.isConfigured) {
      this.statusText = this.$t("aiChat.configureFirst")
      return
    }
    if (this.isSending) return
    this.inputSeed = this.inputPreview || ""
    this.showInput = true
  },
  ExitInput() {
    this.showInput = false
    this.inputSeed = ""
  },
  async FinishInput(evt) {
    const content = String(evt.detail && evt.detail.content ? evt.detail.content : "").trim()
    this.ExitInput()
    if (!content) return
    await this.SendText(content)
  },
  async SendText(content) {
    if (!this.isConfigured || this.isSending) return
    this.statusText = ""
    this.inputPreview = ""
    this.AddMessage({ role: "user", content })
    this.isSending = true
    try {
      const answer = await sendAIChat(this.messages)
      this.AddMessage({ role: "assistant", content: answer })
    } catch (error) {
      const reason = error && error.message ? error.message : "request-failed"
      const failureText = this.$t("aiChat.requestFailed") + " (" + reason + ")"
      this.AddMessage({ role: "assistant", content: failureText, failed: true })
      this.statusText = failureText
      prompt.showToast({ message: this.$t("aiChat.requestFailed"), duration: 2200 })
    } finally {
      this.isSending = false
      this.hasMessages = this.messages.length > 0
      this.RefreshMessages()
    }
  },
  ClearMessages() {
    if (this.isSending) return
    this.messages = []
    this.visibleMessages = []
    this.hasMessages = false
    this.statusText = ""
    this.inputPreview = ""
    prompt.showToast({ message: this.$t("aiChat.cleared"), duration: 1600 })
  },
  AddMessage(message) {
    this.messages = this.messages.concat([message])
    this.hasMessages = this.messages.length > 0
    this.RefreshMessages()
  },
  RefreshMessages() {
    this.messages = this.messages.slice()
    this.visibleMessages = this.messages.slice(-6)
    this.visibleMessages = this.visibleMessages.slice()
    setTimeout(() => this.ScrollToEnd(), 140)
  },
  ScrollToEnd() {
    this.$element("ai-chat-scroll").getScrollRect({
      success: (rect) => this.$element("ai-chat-scroll").scrollTo({ top: rect.height })
    })
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./ai.less";
</style>
