<template>
  <div class="page github-watch5-frame" ontouchstart="StartFixedTouch" ontouchmove="MoveFixedTouch" ontouchend="EndFixedTouch">
    <div class="github-home-header">
      <div class="github-home-back" onclick="GoBack"><text class="github-home-back-text">‹</text></div>
      <text class="github-home-title">GitHub</text>
      <div class="github-home-refresh" onclick="RefreshGithub"><text class="github-home-refresh-text">{{ refreshing ? "⟳" : "↻" }}</text></div>
      <div class="github-home-menu" onclick="OpenDrawer"><text class="github-home-menu-text">☰</text></div>
    </div>

    <scroll class="github-home-scroll {{scrclass}}" scroll-y="true" bounces="false">
      <div class="github-home-content">
        <div class="github-home-overview-card">
          <text class="github-home-heading">{{ $t("github.repositories") }}</text>
          <text class="github-home-subheading">{{ $t("github.repositoriesDescription") }}</text>
        </div>
        <text class="github-home-status" if="{{statusText}}">{{ statusText }}</text>
        <text class="github-home-refreshed" if="{{refreshText && !statusText}}">{{ refreshText }}</text>
        <text class="github-home-loading" if="{{loading}}">{{ $t("github.loading") }}</text>

        <div class="github-repository-card" for="{{repositories}}" onclick="OpenRepository($item)">
          <div class="github-repository-icon"><text class="github-repository-icon-text">{{ $item.private ? "●" : "○" }}</text></div>
          <div class="github-repository-copy">
            <text class="github-repository-name">{{ $item.name }}</text>
            <text class="github-repository-owner">{{ $item.owner }}</text>
            <text class="github-repository-description" if="{{ $item.description }}">{{ $item.description }}</text>
            <text class="github-repository-meta">★ {{ $item.stars }} · {{ $item.updatedText }}</text>
          </div>
          <text class="github-repository-arrow">›</text>
        </div>

        <div class="github-load-more" if="{{canLoadMore && !loading}}" onclick="LoadMore">
          <text class="github-load-more-text">{{ $t("github.loadMore") }}</text>
        </div>
        <text class="github-home-empty" if="{{loaded && !loading && repositories.length === 0 && !statusText}}">{{ $t("github.noRepositories") }}</text>
        <text class="github-home-bottom"></text>
      </div>
    </scroll>

    <div if="{{drawerVisible}}" class="github-drawer-mask" onclick="CloseDrawer">
      <div class="github-drawer" onclick="PreventClose">
        <div class="github-drawer-profile">
          <image if="{{profileAvatar}}" class="github-drawer-avatar" src="{{profileAvatar}}"></image>
          <div if="{{!profileAvatar}}" class="github-drawer-avatar github-drawer-avatar-fallback"><text class="github-drawer-avatar-text">GH</text></div>
          <div class="github-drawer-profile-copy">
            <text class="github-drawer-name">{{ profileName || $t("github.profileUnavailable") }}</text>
            <text class="github-drawer-login">{{ profileLogin || $t("github.tokenSaved") }}</text>
          </div>
        </div>
        <div class="github-drawer-item" onclick="OpenOwnedRepositories">
          <text class="github-drawer-item-icon">▤</text>
          <text class="github-drawer-item-text">{{ $t("github.myRepositories") }}</text>
          <text class="github-drawer-item-arrow">›</text>
        </div>
        <div class="github-drawer-item" onclick="OpenGithubSettings">
          <text class="github-drawer-item-icon">⚙</text>
          <text class="github-drawer-item-text">{{ $t("github.settings") }}</text>
          <text class="github-drawer-item-arrow">›</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import { startGithubFixedTouch, moveGithubFixedTouch, endGithubFixedTouch } from "@src/githubgesture.ts"
import { getGithubProfile, hasGithubToken, listGithubRepositories, setActiveGithubRepository } from "@src/github.ts"

export default {
  private: {
    scrclass: "",
    repositories: [],
    pageNumber: 1,
    canLoadMore: true,
    loading: false,
    loaded: false,
    statusText: "",
    drawerVisible: false,
    refreshing: false,
    refreshText: "",
    profileName: "",
    profileLogin: "",
    profileAvatar: ""
  },
  FormatUpdated(value) {
    const text = String(value || "")
    return text ? text.slice(0, 10) : "--"
  },
  ToViewRepository(item) {
    return {
      id: item.id,
      name: item.name,
      fullName: item.fullName,
      owner: item.owner,
      description: item.description,
      defaultBranch: item.defaultBranch,
      stars: item.stars,
      private: item.private,
      updatedAt: item.updatedAt,
      updatedText: this.FormatUpdated(item.updatedAt)
    }
  },
  ErrorText(error) {
    const code = String(error && error.message ? error.message : "")
    if (code === "missing-token") return this.$t("github.tokenMissing")
    if (code === "http-401") return this.$t("github.tokenInvalid")
    if (code === "http-403") return this.$t("github.permissionDenied")
    if (code === "http-429") return this.$t("github.rateLimited")
    return this.$t("github.loadFailed")
  },
  async LoadProfile() {
    try {
      const profile = await getGithubProfile()
      this.profileName = profile.name
      this.profileLogin = profile.login
      this.profileAvatar = profile.avatarUrl
    } catch (error) {
      this.profileName = ""
      this.profileLogin = ""
      this.profileAvatar = ""
    }
  },
  async LoadRepositories(reset) {
    if (this.loading) return
    this.loading = true
    this.statusText = ""
    const nextPage = reset ? 1 : this.pageNumber + 1
    try {
      const received = await listGithubRepositories(nextPage, false)
      const items = received.map((item) => this.ToViewRepository(item))
      this.repositories = reset ? items : this.repositories.concat(items)
      this.pageNumber = nextPage
      this.canLoadMore = items.length === 10
      this.loaded = true
    } catch (error) {
      this.statusText = this.ErrorText(error)
      this.loaded = true
    }
    this.loading = false
  },
  async EnsureToken() {
    if (!(await hasGithubToken())) {
      router.replace({ uri: "pages/app/features/toolbox/github/connect" })
      return false
    }
    return true
  },
  StartFixedTouch(event) {
    startGithubFixedTouch(this, event)
  },
  MoveFixedTouch(event) {
    moveGithubFixedTouch(this, event)
  },
  EndFixedTouch(event) {
    endGithubFixedTouch(this, event)
  },
  async onInit() {
    global.ui.InitPage(this)
    if (!(await this.EnsureToken())) return
    this.LoadProfile()
    this.LoadRepositories(true)
  },
  GoBack() {
    global.ui.OnBackPressTriggered()
  },
  async RefreshGithub() {
    if (this.loading || this.refreshing) return
    this.refreshing = true
    this.statusText = ""
    this.refreshText = ""
    await this.LoadProfile()
    await this.LoadRepositories(true)
    if (!this.statusText) this.refreshText = this.$t("github.refreshed")
    this.refreshing = false
  },
  LoadMore() {
    this.refreshText = ""
    this.LoadRepositories(false)
  },
  OpenRepository(item) {
    if (!item || !item.owner || !item.name) return
    setActiveGithubRepository(item)
    router.push({ uri: "pages/app/features/toolbox/github/repository" })
  },
  OpenDrawer() {
    this.drawerVisible = true
  },
  CloseDrawer() {
    this.drawerVisible = false
  },
  PreventClose() {},
  OpenOwnedRepositories() {
    this.drawerVisible = false
    router.push({ uri: "pages/app/features/toolbox/github/repositories" })
  },
  OpenGithubSettings() {
    this.drawerVisible = false
    router.push({ uri: "pages/app/features/toolbox/github/settings" })
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./frame.less";
@import "./github.less";
</style>
