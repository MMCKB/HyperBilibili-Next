<template>
  <div class="page github-watch5-frame" ontouchstart="StartFixedTouch" ontouchmove="MoveFixedTouch" ontouchend="EndFixedTouch">
    <div class="github-issues-header">
      <div class="github-home-back" onclick="GoBack"><text class="github-home-back-text">‹</text></div>
      <text class="github-issues-title">{{ $t("github.issues") }}</text>
      <div class="github-home-menu"><text class="github-home-menu-placeholder"> </text></div>
    </div>
    <scroll class="github-issues-scroll {{scrclass}}" scroll-y="true" bounces="false">
      <div class="github-issues-content">
        <div class="github-issues-overview-card"><text class="github-issues-repository">{{ repositoryLabel }}</text><text class="github-issues-readonly">{{ $t("github.issuesReadonly") }}</text></div>
        <text class="github-issues-status" if="{{statusText}}">{{ statusText }}</text>
        <text class="github-issues-loading" if="{{loading}}">{{ $t("github.loading") }}</text>
        <div class="github-issue-card" for="{{issues}}" onclick="OpenIssue($item)">
          <div class="github-issue-number"><text class="github-issue-number-text">#{{ $item.number }}</text></div>
          <div class="github-issue-copy">
            <text class="github-issue-title">{{ $item.title }}</text>
            <text class="github-issue-meta">{{ $item.stateText }} · {{ $item.author || "--" }} · {{ $item.updatedText }}</text>
          </div>
          <text class="github-issue-arrow">›</text>
        </div>
        <div class="github-issues-load-more" if="{{canLoadMore && !loading}}" onclick="LoadMore"><text class="github-issues-load-more-text">{{ $t("github.loadMore") }}</text></div>
        <text class="github-issues-empty" if="{{loaded && !loading && issues.length === 0 && !statusText}}">{{ $t("github.noIssues") }}</text>
        <text class="github-issues-bottom"></text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import { startGithubFixedTouch, moveGithubFixedTouch, endGithubFixedTouch } from "@src/githubgesture.ts"
import { getActiveGithubRepository, listGithubIssues } from "@src/github.ts"

export default {
  private: {
    scrclass: "",
    repository: {},
    repositoryLabel: "",
    issues: [],
    pageNumber: 1,
    canLoadMore: true,
    loading: false,
    loaded: false,
    statusText: ""
  },
  FormatUpdated(value) {
    const text = String(value || "")
    return text ? text.slice(0, 10) : "--"
  },
  ErrorText(error) {
    const code = String(error && error.message ? error.message : "")
    if (code === "http-401") return this.$t("github.tokenInvalid")
    if (code === "http-403") return this.$t("github.permissionDenied")
    if (code === "http-404") return this.$t("github.notFound")
    return this.$t("github.loadFailed")
  },
  async LoadIssues(reset) {
    if (this.loading || !this.repository.name) return
    this.loading = true
    this.statusText = ""
    const nextPage = reset ? 1 : this.pageNumber + 1
    try {
      const received = await listGithubIssues(this.repository.owner, this.repository.name, nextPage)
      const items = received.map((item) => ({
        number: item.number,
        title: item.title,
        body: item.body,
        stateText: item.state === "closed" ? this.$t("github.issueClosed") : this.$t("github.issueOpen"),
        author: item.author,
        updatedText: this.FormatUpdated(item.updatedAt)
      }))
      this.issues = reset ? items : this.issues.concat(items)
      this.pageNumber = nextPage
      this.canLoadMore = received.length === 10
      this.loaded = true
    } catch (error) {
      this.statusText = this.ErrorText(error)
      this.loaded = true
    }
    this.loading = false
  },
  StartFixedTouch(event) {
    startGithubFixedTouch(this, event)
  },
  MoveFixedTouch(event) {
    moveGithubFixedTouch(this, event)
  },
  EndFixedTouch(event) {
    endGithubFixedTouch(this, event)
  },
  onInit() {
    global.ui.InitPage(this)
    const active = getActiveGithubRepository()
    if (!active) {
      global.ui.OnBackPressTriggered()
      return
    }
    this.repository = active
    this.repositoryLabel = active.owner + "/" + active.name
    this.LoadIssues(true)
  },
  GoBack() {
    global.ui.OnBackPressTriggered()
  },
  LoadMore() {
    this.LoadIssues(false)
  },
  OpenIssue(item) {
    if (!item) return
    const heading = "#" + item.number + " " + item.title
    const metadata = item.stateText + " · " + item.author + " · " + item.updatedText
    router.push({ uri: "pages/app/features/toolbox/github/text", params: { titletext: heading, text: metadata + "\n\n" + (item.body || this.$t("github.issueNoBody")) } })
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "../frame.less";
@import "./issues.less";
</style>
