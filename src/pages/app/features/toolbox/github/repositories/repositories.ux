<template>
  <div class="page github-watch5-frame" ontouchstart="StartFixedTouch" ontouchmove="MoveFixedTouch" ontouchend="EndFixedTouch">
    <div class="github-home-header">
      <div class="github-home-back" onclick="GoBack"><text class="github-home-back-text">‹</text></div>
      <text class="github-home-title">{{ $t("github.myRepositories") }}</text>
      <div class="github-home-menu"><text class="github-home-menu-placeholder"> </text></div>
    </div>
    <scroll class="github-home-scroll {{scrclass}}" scroll-y="true" bounces="false">
      <div class="github-home-content">
        <div class="github-home-overview-card"><text class="github-home-heading">{{ $t("github.myRepositories") }}</text><text class="github-home-subheading">{{ $t("github.chooseRepository") }}</text></div>
        <text class="github-home-status" if="{{statusText}}">{{ statusText }}</text>
        <text class="github-home-loading" if="{{loading}}">{{ $t("github.loading") }}</text>
        <div class="github-repository-card" for="{{repositories}}" onclick="OpenRepository($item)">
          <div class="github-repository-icon"><text class="github-repository-icon-text">{{ $item.private ? "●" : "○" }}</text></div>
          <div class="github-repository-copy">
            <text class="github-repository-name">{{ $item.name }}</text>
            <text class="github-repository-description" if="{{ $item.description }}">{{ $item.description }}</text>
            <text class="github-repository-meta">★ {{ $item.stars }} · {{ $item.updatedText }}</text>
          </div>
          <text class="github-repository-arrow">›</text>
        </div>
        <div class="github-load-more" if="{{canLoadMore && !loading}}" onclick="LoadMore"><text class="github-load-more-text">{{ $t("github.loadMore") }}</text></div>
        <text class="github-home-empty" if="{{loaded && !loading && repositories.length === 0 && !statusText}}">{{ $t("github.noOwnedRepositories") }}</text>
        <text class="github-home-bottom"></text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import { startGithubFixedTouch, moveGithubFixedTouch, endGithubFixedTouch } from "@src/githubgesture.ts"
import { listGithubRepositories, setActiveGithubRepository } from "@src/github.ts"

export default {
  private: {
    scrclass: "",
    repositories: [],
    pageNumber: 1,
    canLoadMore: true,
    loading: false,
    loaded: false,
    statusText: ""
  },
  FormatUpdated(value) {
    const text = String(value || "")
    return text ? text.slice(0, 10) : "--"
  },
  ErrorText(error) {
    const code = String(error && error.message ? error.message : "")
    if (code === "http-401") return this.$t("github.tokenInvalid")
    if (code === "http-403") return this.$t("github.permissionDenied")
    return this.$t("github.loadFailed")
  },
  async LoadRepositories(reset) {
    if (this.loading) return
    this.loading = true
    this.statusText = ""
    const nextPage = reset ? 1 : this.pageNumber + 1
    try {
      const received = await listGithubRepositories(nextPage, true)
      const items = received.map((item) => ({
        id: item.id,
        name: item.name,
        fullName: item.fullName,
        owner: item.owner,
        description: item.description,
        defaultBranch: item.defaultBranch,
        stars: item.stars,
        private: item.private,
        updatedAt: item.updatedAt,
        updatedText: this.FormatUpdated(item.updatedAt)
      }))
      this.repositories = reset ? items : this.repositories.concat(items)
      this.pageNumber = nextPage
      this.canLoadMore = items.length === 10
      this.loaded = true
    } catch (error) {
      this.statusText = this.ErrorText(error)
      this.loaded = true
    }
    this.loading = false
  },
  StartFixedTouch(event) {
    startGithubFixedTouch(this, event)
  },
  MoveFixedTouch(event) {
    moveGithubFixedTouch(this, event)
  },
  EndFixedTouch(event) {
    endGithubFixedTouch(this, event)
  },
  onInit() {
    global.ui.InitPage(this)
    this.LoadRepositories(true)
  },
  GoBack() {
    global.ui.OnBackPressTriggered()
  },
  LoadMore() {
    this.LoadRepositories(false)
  },
  OpenRepository(item) {
    if (!item || !item.owner || !item.name) return
    setActiveGithubRepository(item)
    router.push({ uri: "pages/app/features/toolbox/github/repository" })
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "../frame.less";
@import "../github.less";
</style>
