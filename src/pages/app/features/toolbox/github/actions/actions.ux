<template>
  <div class="page">
    <div class="github-actions-header">
      <div class="github-home-back" onclick="GoBack"><text class="github-home-back-text">‹</text></div>
      <text class="github-actions-title">{{ $t("github.actions") }}</text>
      <div class="github-home-menu"><text class="github-home-menu-placeholder"> </text></div>
    </div>
    <scroll class="github-actions-scroll {{scrclass}}" scroll-y="true" bounces="false">
      <div class="github-actions-content">
        <text class="github-actions-repository">{{ repositoryLabel }}</text>
        <text class="github-actions-subtitle">{{ $t("github.chooseWorkflow") }}</text>
        <text class="github-actions-status" if="{{statusText}}">{{ statusText }}</text>
        <text class="github-actions-loading" if="{{loading}}">{{ $t("github.loading") }}</text>
        <div class="github-workflow-card" for="{{workflows}}" onclick="OpenWorkflow($item)">
          <div class="github-workflow-icon"><text class="github-workflow-icon-text">▶</text></div>
          <div class="github-workflow-copy">
            <text class="github-workflow-name">{{ $item.name }}</text>
            <text class="github-workflow-path">{{ $item.path }}</text>
            <text class="github-workflow-state">{{ $item.stateText }}</text>
          </div>
          <text class="github-workflow-arrow">›</text>
        </div>
        <text class="github-actions-empty" if="{{loaded && !loading && workflows.length === 0 && !statusText}}">{{ $t("github.noWorkflows") }}</text>
        <text class="github-actions-bottom"></text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import { getActiveGithubRepository, listGithubWorkflows, setActiveGithubWorkflow } from "@src/github.ts"

export default {
  private: {
    scrclass: "",
    repository: {},
    repositoryLabel: "",
    workflows: [],
    loading: false,
    loaded: false,
    statusText: ""
  },
  WorkflowStateText(value) {
    return String(value || "") === "active" ? this.$t("github.workflowActive") : this.$t("github.workflowUnavailable")
  },
  ErrorText(error) {
    const code = String(error && error.message ? error.message : "")
    if (code === "http-401") return this.$t("github.tokenInvalid")
    if (code === "http-403") return this.$t("github.permissionDenied")
    if (code === "http-404") return this.$t("github.notFound")
    return this.$t("github.loadFailed")
  },
  async LoadWorkflows() {
    if (!this.repository.name) return
    this.loading = true
    this.statusText = ""
    try {
      const received = await listGithubWorkflows(this.repository.owner, this.repository.name)
      this.workflows = received.map((item) => ({ id: item.id, name: item.name, path: item.path, state: item.state, stateText: this.WorkflowStateText(item.state) }))
      this.loaded = true
    } catch (error) {
      this.statusText = this.ErrorText(error)
      this.loaded = true
    }
    this.loading = false
  },
  onInit() {
    global.ui.InitPage(this)
    const active = getActiveGithubRepository()
    if (!active) {
      global.ui.OnBackPressTriggered()
      return
    }
    this.repository = active
    this.repositoryLabel = active.owner + "/" + active.name
    this.LoadWorkflows()
  },
  GoBack() {
    global.ui.OnBackPressTriggered()
  },
  OpenWorkflow(item) {
    if (!item || !item.id || !item.path || item.state !== "active") return
    setActiveGithubWorkflow(item)
    router.push({ uri: "pages/app/features/toolbox/github/workflow" })
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./actions.less";
</style>
