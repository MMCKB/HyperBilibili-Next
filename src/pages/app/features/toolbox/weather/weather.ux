<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>
<import name="full-screen-input" src="@components/FullScreenInput/FullScreenInput.ux"></import>

<template>
  <div class="page">
    <div class="scroll weather-shell {{scrclass}}">
      <title-bar title="weather.title"></title-bar>

      <div if="{{loading}}" class="weather-loading-card">
        <text class="weather-loading-icon">☁</text>
        <text class="weather-loading-text">{{ $t("weather.loading") }}</text>
      </div>

      <div if="{{!loading && errorMessage}}" class="weather-error-card">
        <text class="weather-error-icon">!</text>
        <text class="weather-error-text">{{ errorMessage }}</text>
        <div class="weather-retry" onclick="RefreshWeather"><text class="weather-retry-text">{{ $t("weather.retry") }}</text></div>
        <div class="weather-settings-link" onclick="OpenSettings"><text class="weather-settings-link-text">{{ $t("weather.openSettings") }}</text></div>
      </div>

      <div if="{{!loading && !errorMessage}}" class="weather-pager-wrap">
        <swiper class="weather-pager" vertical="true" indicator="false" loop="false" enableswipe="true" index="{{pageIndex}}" @change="PageChanged">
          <div class="weather-page weather-page-now">
            <div class="weather-page-top">
              <div class="weather-location-copy">
                <div class="weather-location-line"><text class="weather-location">{{ locationName }}</text><text class="weather-update">{{ updateText }}</text></div>
              </div>
              <div class="weather-page-action" onclick="RefreshWeather"><text class="weather-page-action-text">↻</text></div>
              <div class="weather-page-action" onclick="OpenCityPicker"><text class="weather-page-action-text">⌖</text></div>
            </div>

            <div class="weather-now-card">
              <text class="weather-condition-icon">{{ currentIcon }}</text>
              <div class="weather-now-copy">
                <text class="weather-temperature">{{ currentTemperature }}</text>
                <text class="weather-condition">{{ currentCondition }}</text>
                <text class="weather-feels">{{ feelsLikeText }}</text>
              </div>
            </div>

            <div class="weather-metric-row">
              <div class="weather-metric-card"><text class="weather-metric-label">{{ $t("weather.humidity") }}</text><text class="weather-metric-value">{{ humidityText }}</text></div>
              <div class="weather-metric-card"><text class="weather-metric-label">{{ $t("weather.wind") }}</text><text class="weather-metric-value">{{ windText }}</text></div>
              <div class="weather-metric-card"><text class="weather-metric-label">{{ $t("weather.uv") }}</text><text class="weather-metric-value">{{ uvText }}</text></div>
            </div>

            <div class="weather-page-bottom">
              <text class="weather-swipe-hint">{{ $t("weather.swipeUp") }}</text>
              <div class="weather-page-dots"><text class="weather-page-dot weather-page-dot-active">●</text><text class="weather-page-dot">●</text><text class="weather-page-dot">●</text></div>
            </div>
          </div>

          <div class="weather-page weather-page-forecast">
            <text class="weather-page-title">{{ $t("weather.hourly") }}</text>
            <text class="weather-page-subtitle">{{ $t("weather.nextHours") }}</text>
            <scroll class="weather-hour-scroll" scroll-x="true" bounces="false"><div class="weather-hour-grid">
              <div class="weather-hour-card" for="{{hourlyItems}}">
                <text class="weather-hour-time">{{ $item.time }}</text>
                <text class="weather-hour-icon">{{ $item.icon }}</text>
                <text class="weather-hour-temperature">{{ $item.temperature }}</text>
                <text class="weather-hour-rain">{{ $item.rain }}</text>
              </div>
            </div></scroll>
            <text class="weather-page-title weather-daily-heading">{{ $t("weather.daily") }}</text>
            <div class="weather-daily-card" for="{{dailyItems}}">
              <text class="weather-daily-date">{{ $item.date }}</text>
              <text class="weather-daily-icon">{{ $item.icon }}</text>
              <text class="weather-daily-condition">{{ $item.condition }}</text>
              <text class="weather-daily-temperature">{{ $item.temperature }}</text>
              <text class="weather-daily-rain">{{ $item.rain }}</text>
            </div>
            <div class="weather-page-bottom"><div class="weather-page-dots"><text class="weather-page-dot">●</text><text class="weather-page-dot weather-page-dot-active">●</text><text class="weather-page-dot">●</text></div></div>
          </div>

          <div class="weather-page weather-page-detail">
            <div if="{{aqiText}}" class="weather-air-card"><text class="weather-air-title">{{ $t("weather.airQuality") }}</text><text class="weather-air-value">{{ aqiText }}</text><text class="weather-air-detail">{{ pollutantText }}</text></div>
            <div if="{{rainSummary}}" class="weather-rain-card"><text class="weather-rain-label">{{ $t("weather.minutely") }}</text><text class="weather-rain-value">{{ rainSummary }}</text></div>
            <div if="{{alertTitle}}" class="weather-alert-card"><text class="weather-alert-label">{{ $t("weather.alert") }}</text><text class="weather-alert-value">{{ alertTitle }}</text></div>
            <div class="weather-life-card" for="{{lifeIndexItems}}"><text class="weather-life-name">{{ $item.name }}</text><text class="weather-life-category">{{ $item.category }}</text></div>
            <div class="weather-astro-card"><div class="weather-astro-item"><text class="weather-astro-label">{{ $t("weather.sunrise") }}</text><text class="weather-astro-value">{{ sunriseText }}</text></div><div class="weather-astro-item"><text class="weather-astro-label">{{ $t("weather.sunset") }}</text><text class="weather-astro-value">{{ sunsetText }}</text></div><div class="weather-astro-item"><text class="weather-astro-label">{{ $t("weather.moon") }}</text><text class="weather-astro-value">{{ moonText }}</text></div></div>
            <div class="weather-page-bottom"><div class="weather-page-dots"><text class="weather-page-dot">●</text><text class="weather-page-dot">●</text><text class="weather-page-dot weather-page-dot-active">●</text></div></div>
          </div>
        </swiper>
      </div>
    </div>
    <div class="weather-city-mask" if="{{cityPickerOpen}}">
      <div class="weather-city-panel">
        <div class="weather-city-panel-header"><text class="weather-city-panel-title">{{ $t("weather.switchCity") }}</text><text class="weather-city-panel-close" onclick="CloseCityPicker">×</text></div>
        <text class="weather-city-panel-hint">{{ $t("weather.savedCities") }}</text>
        <div class="weather-city-row" for="{{cityItems}}" onclick="SwitchCity($item)"><div class="weather-city-row-copy"><text class="weather-city-row-name">{{ $item.name }}</text><text class="weather-city-row-id">{{ $item.locationId }}</text></div><text class="weather-city-row-active" if="{{ $item.active }}">✓</text></div>
        <div class="weather-city-add" if="{{cityItems.length < maxCities}}" onclick="OpenCityInput"><text class="weather-city-add-text">{{ $t("weather.addCity") }}</text><text class="weather-city-count">{{ cityItems.length }}/{{ maxCities }}</text></div>
        <div class="weather-city-settings" onclick="OpenSettings"><text class="weather-city-settings-text">{{ $t("weather.openSettings") }}</text></div>
      </div>
    </div>
    <full-screen-input style="position: absolute" if="{{showCityInput}}" initial-text="{{cityInputSeed}}" @send="FinishCityInput" @exit="ExitCityInput"></full-screen-input>
  </div>
</template>

<script>
import router from "@system.router"
import { loadWeatherSettings, isWeatherReady, loadWeatherBundle, weatherConditionSymbol, formatForecastTime, formatShortDate, getSavedWeatherCities, addWeatherCity, selectWeatherCity, updateWeatherCityName, MAX_WEATHER_CITIES, WEATHER_SETTINGS } from "@src/weather.ts"

export default {
  private: {
    scrclass: "",
    loading: true,
    errorMessage: "",
    pageIndex: 0,
    locationName: "",
    updateText: "",
    currentTemperature: "--",
    currentCondition: "--",
    currentIcon: "●",
    feelsLikeText: "",
    humidityText: "--",
    windText: "--",
    uvText: "--",
    hourlyItems: [],
    dailyItems: [],
    rainSummary: "",
    alertTitle: "",
    aqiText: "",
    pollutantText: "",
    lifeIndexItems: [],
    sunriseText: "--",
    sunsetText: "--",
    moonText: "--",
    cityPickerOpen: false,
    cityItems: [],
    maxCities: MAX_WEATHER_CITIES,
    showCityInput: false,
    cityInputSeed: ""
  },
  async onInit() {
    await this.LoadPage()
  },
  async onShow() {
    await this.LoadPage()
  },
  async LoadPage() {
    const settings = await loadWeatherSettings()
    if (!isWeatherReady(settings)) {
      router.replace({ uri: "pages/app/features/toolbox/weather/settings" })
      return
    }
    this.locationName = settings.locationName || settings.locationId
    this.RefreshCityItems(settings)
    this.RefreshWeather()
  },
  async RefreshWeather() {
    this.loading = true
    this.errorMessage = ""
    try {
      const bundle = await loadWeatherBundle(WEATHER_SETTINGS)
      await this.ApplyWeatherBundle(bundle)
      this.loading = false
    } catch (error) {
      this.loading = false
      const reason = error && error.message ? " (" + error.message + ")" : ""
      this.errorMessage = this.$t("weather.loadFailed") + reason
    }
  },
  PageChanged(index) {
    this.pageIndex = index.index
  },
  async ApplyWeatherBundle(bundle) {
    const current = bundle.current && bundle.current.now ? bundle.current.now : null
    if (!current) throw new Error("missing-current")
    this.currentTemperature = current.temp === undefined ? "--" : current.temp + "°"
    this.currentCondition = current.text || "--"
    this.currentIcon = weatherConditionSymbol(current.icon)
    this.feelsLikeText = current.feelsLike === undefined ? "" : this.$t("weather.feelsLike") + " " + current.feelsLike + "°"
    this.humidityText = current.humidity === undefined ? "--" : String(current.humidity) + "%"
    this.windText = current.windSpeed === undefined ? "--" : current.windSpeed + " km/h"
    this.uvText = current.uvIndex === undefined ? "--" : String(current.uvIndex)
    this.updateText = current.obsTime ? this.$t("weather.updatedAt") + formatForecastTime(current.obsTime) : ""
    const locations = bundle.location && Array.isArray(bundle.location.location) ? bundle.location.location : []
    const currentLocation = locations.length ? locations[0] : null
    if (currentLocation && currentLocation.name) {
      this.locationName = currentLocation.name
      const selectedCity = getSavedWeatherCities().find((city) => city.locationId === WEATHER_SETTINGS.locationId)
      if (!selectedCity || selectedCity.locationName !== currentLocation.name) {
        await updateWeatherCityName(WEATHER_SETTINGS.locationId, currentLocation.name)
        this.RefreshCityItems(WEATHER_SETTINGS)
      }
    }

    const hours = bundle.hourly && Array.isArray(bundle.hourly.hourly) ? bundle.hourly.hourly : []
    this.hourlyItems = hours.slice(0, 24).map((item) => ({ time: formatForecastTime(item.fxTime), icon: weatherConditionSymbol(item.icon), temperature: item.temp === undefined ? "--" : item.temp + "°", rain: item.pop === undefined ? "--" : String(item.pop) + "%" }))
    const days = bundle.daily && Array.isArray(bundle.daily.daily) ? bundle.daily.daily : []
    this.dailyItems = days.slice(0, 3).map((item) => ({ date: formatShortDate(item.fxDate), icon: weatherConditionSymbol(item.iconDay), condition: item.textDay || "--", temperature: item.tempMin === undefined || item.tempMax === undefined ? "--" : item.tempMin + "–" + item.tempMax + "°", rain: item.pop === undefined ? "" : String(item.pop) + "%" }))
    const firstDay = days.length ? days[0] : null
    this.sunriseText = firstDay ? formatForecastTime(firstDay.sunrise) : "--"
    this.sunsetText = firstDay ? formatForecastTime(firstDay.sunset) : "--"
    this.moonText = firstDay ? this.MoonLabel(firstDay.moonPhase) : "--"
    this.rainSummary = bundle.minutely && bundle.minutely.summary ? bundle.minutely.summary : ""
    const alerts = bundle.alerts && Array.isArray(bundle.alerts.warning) ? bundle.alerts.warning : []
    this.alertTitle = alerts.length && alerts[0].title ? alerts[0].title : ""
    const airNow = bundle.air && bundle.air.now ? bundle.air.now : null
    this.aqiText = airNow ? "AQI " + (airNow.aqi || "--") + " " + (airNow.category || "") : ""
    this.pollutantText = airNow ? (airNow.primary || "") : ""
    const indices = bundle.indices && Array.isArray(bundle.indices.daily) ? bundle.indices.daily : []
    this.lifeIndexItems = indices.slice(0, 3).map((item) => ({ name: item.name || "--", category: item.category || "--" }))
  },
  MoonLabel(phase) {
    const labels = { "new-moon": "新月", "waxing-crescent": "蛾眉月", "first-quarter": "上弦月", "waxing-gibbous": "盈凸月", "full-moon": "满月", "waning-gibbous": "亏凸月", "last-quarter": "下弦月", "waning-crescent": "残月" }
    return labels[phase] || phase || "--"
  },
  RefreshCityItems(settings = WEATHER_SETTINGS) {
    this.cityItems = getSavedWeatherCities(settings).map((city) => ({
      locationId: city.locationId,
      name: city.locationName || city.locationId,
      active: city.locationId === settings.locationId
    }))
  },
  OpenCityPicker() {
    this.RefreshCityItems(WEATHER_SETTINGS)
    this.cityPickerOpen = true
  },
  CloseCityPicker() {
    this.cityPickerOpen = false
  },
  OpenCityInput() {
    if (this.cityItems.length >= this.maxCities) return
    this.cityInputSeed = ""
    this.showCityInput = true
  },
  ExitCityInput() {
    this.showCityInput = false
    this.cityInputSeed = ""
  },
  async FinishCityInput(evt) {
    const locationId = String(evt.detail && evt.detail.content ? evt.detail.content : "").trim()
    this.ExitCityInput()
    if (!locationId) return
    try {
      await addWeatherCity(locationId)
      this.cityPickerOpen = false
      this.locationName = WEATHER_SETTINGS.locationName || WEATHER_SETTINGS.locationId
      this.RefreshCityItems(WEATHER_SETTINGS)
      await this.RefreshWeather()
    } catch (error) {
      this.errorMessage = error && error.message === "city-limit" ? this.$t("weather.cityLimitReached") : this.$t("weather.addCityFailed")
    }
  },
  async SwitchCity(city) {
    if (!city || !city.locationId) return
    this.cityPickerOpen = false
    try {
      await selectWeatherCity(city.locationId)
      this.locationName = WEATHER_SETTINGS.locationName || WEATHER_SETTINGS.locationId
      this.RefreshCityItems(WEATHER_SETTINGS)
      await this.RefreshWeather()
    } catch (error) {
      this.errorMessage = this.$t("weather.switchCityFailed")
    }
  },
  OpenSettings() {
    this.cityPickerOpen = false
    router.push({ uri: "pages/app/features/toolbox/weather/settings" })
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./weather.less";
</style>
