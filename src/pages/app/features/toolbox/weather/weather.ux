<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>
<import name="full-screen-input" src="@components/FullScreenInput/FullScreenInput.ux"></import>

<template>
  <div class="page">
    <div class="scroll weather-shell {{scrclass}}">
      <title-bar title="weather.title"></title-bar>

      <div if="{{loading}}" class="weather-loading-card"><text class="weather-loading-icon">☁</text><text class="weather-loading-text">{{ $t("weather.loading") }}</text></div>
      <div if="{{!loading && errorMessage}}" class="weather-error-card"><text class="weather-error-icon">!</text><text class="weather-error-text">{{ errorMessage }}</text><div class="weather-retry" onclick="RefreshWeather"><text class="weather-retry-text">{{ $t("weather.retry") }}</text></div><div class="weather-settings-link" onclick="OpenSettings"><text class="weather-settings-link-text">{{ $t("weather.openSettings") }}</text></div></div>

      <div if="{{!loading && !errorMessage}}" class="weather-pager-wrap">
        <swiper class="weather-pager" vertical="true" indicator="false" loop="false" enableswipe="true" index="{{pageIndex}}" @change="PageChanged">
          <div class="weather-page weather-page-now">
            <div class="weather-page-top"><div class="weather-location-copy"><div class="weather-location-line"><text class="weather-location">{{ locationName }}</text><text class="weather-update">{{ updateText }}</text></div></div><div class="weather-page-action" onclick="RefreshWeather"><text class="weather-page-action-text">↻</text></div><div class="weather-page-action" onclick="OpenCityPicker"><text class="weather-page-action-text">⇄</text></div></div>
            <div class="weather-now-card"><image class="weather-condition-image" src="{{currentIconSrc}}"></image><div class="weather-now-copy"><text class="weather-temperature">{{ currentTemperature }}</text><text class="weather-condition">{{ currentCondition }}</text><text class="weather-feels">{{ feelsLikeText }}</text><text class="weather-today-range">{{ todayRangeText }}</text></div></div>
            <div class="weather-metric-row"><div class="weather-metric-card"><text class="weather-metric-label">{{ $t("weather.humidity") }}</text><text class="weather-metric-value">{{ humidityText }}</text></div><div class="weather-metric-card"><text class="weather-metric-label">{{ $t("weather.wind") }}</text><text class="weather-metric-value">{{ windText }}</text></div><div class="weather-metric-card"><text class="weather-metric-label">{{ $t("weather.uv") }}</text><text class="weather-metric-value">{{ uvText }}</text></div></div>
            <div class="weather-page-bottom"><div class="weather-page-dots"><text class="weather-page-dot weather-page-dot-active">●</text><text class="weather-page-dot">●</text><text class="weather-page-dot">●</text><text class="weather-page-dot">●</text><text class="weather-page-dot">●</text></div></div>
          </div>

          <div class="weather-page weather-page-forecast">
            <scroll class="weather-hour-scroll" scroll-x="true" bounces="false"><div class="weather-hour-grid"><div class="weather-hour-card" for="{{hourlyItems}}"><text class="weather-hour-time">{{ $item.time }}</text><image class="weather-hour-image" src="{{ $item.iconSrc }}"></image><text class="weather-hour-temperature">{{ $item.temperature }}</text><text class="weather-hour-rain">{{ $item.rain }}</text></div></div></scroll>
            <div class="weather-daily-card" for="{{dailyItems}}"><text class="weather-daily-date">{{ $item.date }}</text><image class="weather-daily-image" src="{{ $item.iconSrc }}"></image><text class="weather-daily-condition">{{ $item.condition }}</text><text class="weather-daily-temperature">{{ $item.temperature }}</text><text class="weather-daily-rain">{{ $item.rain }}</text></div>
            <div class="weather-page-bottom"><div class="weather-page-dots"><text class="weather-page-dot">●</text><text class="weather-page-dot weather-page-dot-active">●</text><text class="weather-page-dot">●</text><text class="weather-page-dot">●</text><text class="weather-page-dot">●</text></div></div>
          </div>

          <div class="weather-page weather-page-insight">
            <div class="weather-rain-graph-card"><text class="weather-rain-graph-title">{{ rainGraphTitle }}</text><text class="weather-rain-graph-meta">{{ sunriseLabel }} {{ sunriseText }}　{{ sunsetLabel }} {{ sunsetText }}</text><image class="weather-rain-chart" src="/common/weather/rain-chart.png"></image></div>
            <div class="weather-aqi-card"><div class="weather-aqi-heading"><text class="weather-aqi-label">{{ $t("weather.airQuality") }}</text><text class="weather-aqi-value">{{ aqiText }}</text></div><div class="weather-aqi-bar"><div class="weather-aqi-segment weather-aqi-green"></div><div class="weather-aqi-segment weather-aqi-lime"></div><div class="weather-aqi-segment weather-aqi-yellow"></div><div class="weather-aqi-segment weather-aqi-orange"></div><div class="weather-aqi-segment weather-aqi-red"></div></div><text class="weather-pm25">{{ pm25Text }}</text></div>
            <div class="weather-warning-card" onclick="OpenAlertDetail"><div class="weather-warning-copy"><text class="weather-warning-title">{{ $t("weather.alert") }}</text><text class="weather-warning-text">{{ alertSummary }}</text></div><text class="weather-warning-arrow">›</text></div>
            <div class="weather-page-bottom"><div class="weather-page-dots"><text class="weather-page-dot">●</text><text class="weather-page-dot">●</text><text class="weather-page-dot weather-page-dot-active">●</text><text class="weather-page-dot">●</text><text class="weather-page-dot">●</text></div></div>
          </div>

          <div class="weather-page weather-page-environment">
            <div class="weather-environment-card"><text class="weather-environment-label">{{ $t("weather.humidity") }}</text><text class="weather-environment-value">{{ humidityText }}</text></div>
            <div class="weather-environment-card"><text class="weather-environment-label">{{ $t("weather.windDirection") }}</text><text class="weather-environment-value">{{ windDirectionText }}</text></div>
            <div class="weather-environment-card"><text class="weather-environment-label">{{ $t("weather.pressure") }}</text><text class="weather-environment-value">{{ pressureText }}</text></div>
            <div class="weather-astro-card"><div class="weather-astro-mini"><image class="weather-astro-icon" src="/common/weather/sunrise.png"></image><div class="weather-astro-copy"><text class="weather-astro-label">{{ sunriseLabel }}</text><text class="weather-astro-value">{{ sunriseText }}</text></div></div><div class="weather-astro-mini weather-astro-sunset"><image class="weather-astro-icon" src="/common/weather/sunset.png"></image><div class="weather-astro-copy"><text class="weather-astro-label">{{ sunsetLabel }}</text><text class="weather-astro-value">{{ sunsetText }}</text></div></div></div>
            <div class="weather-page-bottom"><div class="weather-page-dots"><text class="weather-page-dot">●</text><text class="weather-page-dot">●</text><text class="weather-page-dot">●</text><text class="weather-page-dot weather-page-dot-active">●</text><text class="weather-page-dot">●</text></div></div>
          </div>

          <div class="weather-page weather-page-life">
            <div class="weather-life-grid"><div class="weather-life-advice" for="{{lifeAdviceItems}}"><image class="weather-life-icon" src="{{ $item.iconSrc }}"></image><text class="weather-life-name">{{ $item.name }}</text><text class="weather-life-category">{{ $item.category }}</text><text class="weather-life-copy">{{ $item.copy }}</text></div></div>
            <div class="weather-page-bottom"><div class="weather-page-dots"><text class="weather-page-dot">●</text><text class="weather-page-dot">●</text><text class="weather-page-dot">●</text><text class="weather-page-dot">●</text><text class="weather-page-dot weather-page-dot-active">●</text></div></div>
          </div>
        </swiper>
      </div>
    </div>

    <div class="weather-city-mask" if="{{cityPickerOpen}}"><div class="weather-city-panel"><div class="weather-city-panel-header"><text class="weather-city-panel-title">{{ $t("weather.switchCity") }}</text><text class="weather-city-panel-close" onclick="CloseCityPicker">×</text></div><text class="weather-city-panel-hint">{{ $t("weather.savedCities") }}</text><div class="weather-city-row" for="{{cityItems}}" onclick="SwitchCity($item)"><div class="weather-city-row-copy"><text class="weather-city-row-name">{{ $item.name }}</text><text class="weather-city-row-id">{{ $item.locationId }}</text></div><text class="weather-city-row-active" if="{{ $item.active }}">✓</text></div><div class="weather-city-add" if="{{cityItems.length < maxCities}}" onclick="OpenCityInput"><text class="weather-city-add-text">{{ $t("weather.addCity") }}</text><text class="weather-city-count">{{ cityItems.length }}/{{ maxCities }}</text></div><div class="weather-city-settings" onclick="OpenSettings"><text class="weather-city-settings-text">{{ $t("weather.openSettings") }}</text></div></div></div>
    <div class="weather-alert-mask" if="{{alertDetailOpen}}"><div class="weather-alert-detail"><div class="weather-alert-detail-header"><text class="weather-alert-detail-title">{{ $t("weather.alert") }}</text><text class="weather-alert-detail-close" onclick="CloseAlertDetail">×</text></div><text class="weather-alert-detail-text">{{ alertDetailText }}</text></div></div>
    <full-screen-input style="position: absolute" if="{{showCityInput}}" initial-text="{{cityInputSeed}}" @send="FinishCityInput" @exit="ExitCityInput"></full-screen-input>
  </div>
</template>

<script>
import router from "@system.router"
import { loadWeatherSettings, isWeatherReady, loadWeatherBundle, weatherConditionAsset, formatForecastTime, formatShortDate, getSavedWeatherCities, addWeatherCity, selectWeatherCity, updateWeatherCityName, MAX_WEATHER_CITIES, WEATHER_SETTINGS } from "@src/weather.ts"

export default {
  private: {
    scrclass: "", loading: true, errorMessage: "", pageIndex: 0, locationName: "", updateText: "", currentTemperature: "--", currentCondition: "--", currentIconSrc: "/common/weather/cloudy.png", feelsLikeText: "", todayRangeText: "", humidityText: "--", windText: "--", uvText: "--", windDirectionText: "--", pressureText: "--", hourlyItems: [], dailyItems: [], rainGraphTitle: "", sunriseText: "--", sunsetText: "--", sunriseLabel: "日出", sunsetLabel: "日落", aqiText: "--", pm25Text: "PM2.5 --", aqiPointerLeft: "0px", alertSummary: "", alertDetailText: "", alertDetailOpen: false, lifeAdviceItems: [], cityPickerOpen: false, cityItems: [], maxCities: MAX_WEATHER_CITIES, showCityInput: false, cityInputSeed: ""
  },
  async onInit() { await this.LoadPage() },
  async onShow() { await this.LoadPage() },
  async LoadPage() {
    const settings = await loadWeatherSettings()
    if (!isWeatherReady(settings)) { router.replace({ uri: "pages/app/features/toolbox/weather/settings" }); return }
    this.locationName = settings.locationName || settings.locationId
    this.RefreshCityItems(settings)
    this.RefreshWeather()
  },
  async RefreshWeather() {
    this.loading = true; this.errorMessage = ""
    try { const bundle = await loadWeatherBundle(WEATHER_SETTINGS); await this.ApplyWeatherBundle(bundle); this.loading = false } catch (error) { this.loading = false; const reason = error && error.message ? " (" + error.message + ")" : ""; this.errorMessage = this.$t("weather.loadFailed") + reason }
  },
  PageChanged(index) { this.pageIndex = index.index },
  async ApplyWeatherBundle(bundle) {
    const current = bundle.current && bundle.current.now ? bundle.current.now : null
    if (!current) throw new Error("missing-current")
    this.currentTemperature = current.temp === undefined ? "--" : current.temp + "°"
    this.currentCondition = current.text || "--"
    this.currentIconSrc = weatherConditionAsset(current.icon)
    this.feelsLikeText = current.feelsLike === undefined ? "" : this.$t("weather.feelsLike") + " " + current.feelsLike + "°"
    this.humidityText = current.humidity === undefined ? "--" : String(current.humidity) + "%"
    this.windText = current.windSpeed === undefined ? "--" : current.windSpeed + " km/h"
    this.windDirectionText = current.windDir || "--"
    this.pressureText = current.pressure === undefined ? "--" : current.pressure + " hPa"
    this.uvText = current.uvIndex === undefined ? "--" : String(current.uvIndex)
    this.updateText = current.obsTime ? this.$t("weather.updatedAt") + formatForecastTime(current.obsTime) : ""
    const locations = bundle.location && Array.isArray(bundle.location.location) ? bundle.location.location : []
    const currentLocation = locations.length ? locations[0] : null
    if (currentLocation && currentLocation.name) { this.locationName = currentLocation.name; const selectedCity = getSavedWeatherCities().find((city) => city.locationId === WEATHER_SETTINGS.locationId); if (!selectedCity || selectedCity.locationName !== currentLocation.name) { await updateWeatherCityName(WEATHER_SETTINGS.locationId, currentLocation.name); this.RefreshCityItems(WEATHER_SETTINGS) } }
    const hours = bundle.hourly && Array.isArray(bundle.hourly.hourly) ? bundle.hourly.hourly : []
    this.hourlyItems = hours.slice(0, 24).map((item) => ({ time: formatForecastTime(item.fxTime), iconSrc: weatherConditionAsset(item.icon), temperature: item.temp === undefined ? "--" : item.temp + "°", rain: item.pop === undefined ? "--" : String(item.pop) + "%" }))
    const days = bundle.daily && Array.isArray(bundle.daily.daily) ? bundle.daily.daily : []
    this.dailyItems = days.slice(0, 3).map((item, index) => ({ date: index === 0 ? this.$t("weather.today") : index === 1 ? this.$t("weather.tomorrow") : this.$t("weather.dayAfterTomorrow"), iconSrc: weatherConditionAsset(item.iconDay), condition: item.textDay || "--", temperature: item.tempMin === undefined || item.tempMax === undefined ? "--" : item.tempMin + "–" + item.tempMax + "°", rain: item.pop === undefined ? "" : String(item.pop) + "%" }))
    const firstDay = days.length ? days[0] : null
    this.todayRangeText = firstDay && firstDay.tempMin !== undefined && firstDay.tempMax !== undefined ? this.$t("weather.today") + " " + firstDay.tempMin + "°–" + firstDay.tempMax + "°" : ""
    this.sunriseText = firstDay ? formatForecastTime(firstDay.sunrise) : "--"
    this.sunsetText = firstDay ? formatForecastTime(firstDay.sunset) : "--"
    const summary = bundle.minutely && bundle.minutely.summary ? bundle.minutely.summary : ""
    this.rainGraphTitle = summary || this.$t("weather.noRainSummary")
    const airNow = bundle.air && bundle.air.now ? bundle.air.now : null
    const aqiNumber = airNow && airNow.aqi !== undefined ? Number(airNow.aqi) : 0
    this.aqiText = airNow ? String(airNow.aqi || "--") + " " + (airNow.category || "") : "--"
    this.pm25Text = "PM2.5　" + (airNow && airNow.pm2p5 !== undefined ? airNow.pm2p5 + " μg/m³" : "--")
    this.aqiPointerLeft = Math.max(0, Math.min(330, Math.round((Math.min(aqiNumber || 0, 300) / 300) * 330))) + "px"
    const alerts = bundle.alerts && Array.isArray(bundle.alerts.warning) ? bundle.alerts.warning : []
    const alert = alerts.length ? alerts[0] : null
    this.alertSummary = alert && alert.title ? alert.title : this.$t("weather.noAlert")
    this.alertDetailText = alert ? [alert.title, alert.text, alert.startTime ? this.$t("weather.updatedAt") + formatForecastTime(alert.startTime) : ""].filter((item) => item).join("\n") : this.$t("weather.noAlertDetail")
    const indices = bundle.indices && Array.isArray(bundle.indices.daily) ? bundle.indices.daily : []
    this.lifeAdviceItems = this.BuildLifeAdvice(indices)
  },
  BuildLifeAdvice(indices) {
    const source = {}; indices.forEach((item) => { source[String(item.type)] = item })
    const config = [{ type: "3", name: this.$t("weather.dressingAdvice"), iconSrc: "/common/weather/clothing.png", fallback: this.$t("weather.comfortable") }, { type: "1", name: this.$t("weather.sportAdvice"), iconSrc: "/common/weather/sport.png", fallback: this.$t("weather.suitable") }, { type: "5", name: this.$t("weather.uvAdvice"), iconSrc: "/common/weather/uv.png", fallback: this.$t("weather.moderate") }, { type: "2", name: this.$t("weather.washAdvice"), iconSrc: "/common/weather/wash.png", fallback: this.$t("weather.suitable") }]
    return config.map((item) => { const sourceItem = source[item.type]; return { name: item.name, iconSrc: item.iconSrc, category: sourceItem && sourceItem.category ? sourceItem.category : item.fallback, copy: sourceItem && sourceItem.text ? sourceItem.text : this.$t("weather.adviceUnavailable") } })
  },
  OpenAlertDetail() { this.alertDetailOpen = true },
  CloseAlertDetail() { this.alertDetailOpen = false },
  RefreshCityItems(settings = WEATHER_SETTINGS) { this.cityItems = getSavedWeatherCities(settings).map((city) => ({ locationId: city.locationId, name: city.locationName || city.locationId, active: city.locationId === settings.locationId })) },
  OpenCityPicker() { this.RefreshCityItems(WEATHER_SETTINGS); this.cityPickerOpen = true },
  CloseCityPicker() { this.cityPickerOpen = false },
  OpenCityInput() { if (this.cityItems.length >= this.maxCities) return; this.cityInputSeed = ""; this.showCityInput = true },
  ExitCityInput() { this.showCityInput = false; this.cityInputSeed = "" },
  async FinishCityInput(evt) { const locationId = String(evt.detail && evt.detail.content ? evt.detail.content : "").trim(); this.ExitCityInput(); if (!locationId) return; try { await addWeatherCity(locationId); this.cityPickerOpen = false; this.locationName = WEATHER_SETTINGS.locationName || WEATHER_SETTINGS.locationId; this.RefreshCityItems(WEATHER_SETTINGS); await this.RefreshWeather() } catch (error) { this.errorMessage = error && error.message === "city-limit" ? this.$t("weather.cityLimitReached") : this.$t("weather.addCityFailed") } },
  async SwitchCity(city) { if (!city || !city.locationId) return; this.cityPickerOpen = false; try { await selectWeatherCity(city.locationId); this.locationName = WEATHER_SETTINGS.locationName || WEATHER_SETTINGS.locationId; this.RefreshCityItems(WEATHER_SETTINGS); await this.RefreshWeather() } catch (error) { this.errorMessage = this.$t("weather.switchCityFailed") } },
  OpenSettings() { this.cityPickerOpen = false; router.push({ uri: "pages/app/features/toolbox/weather/settings" }) }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./weather.less";
</style>
