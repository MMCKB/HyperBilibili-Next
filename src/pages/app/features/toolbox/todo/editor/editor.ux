<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>
<import name="full-screen-input" src="@components/FullScreenInput/FullScreenInput.ux"></import>

<template>
  <div class="page">
    <scroll class="scroll {{scrclass}}" scroll-y="true" bounces="false">
      <title-bar title="todo.edit"></title-bar>
      <div class="editor-content">
        <text class="editor-heading">{{ editing ? $t("todo.edit") : $t("todo.add") }}</text>
        <div class="form-card" onclick="OpenInput('title')"><text class="field-label">{{ $t("todo.taskName") }}</text><text class="field-value">{{ title || $t("todo.taskName") }}</text></div>
        <div class="form-card" onclick="OpenInput('date')"><text class="field-label">{{ $t("todo.date") }}</text><text class="field-value">{{ date }}</text><text class="field-hint">{{ $t("todo.dateHint") }}</text></div>
        <div class="form-card" onclick="OpenInput('time')"><text class="field-label">{{ $t("todo.time") }}</text><text class="field-value">{{ time }}</text><text class="field-hint">{{ $t("todo.timeHint") }}</text></div>
        <text class="status-text" if="{{statusText}}">{{ statusText }}</text>
        <div class="save-button" onclick="SaveTodo"><text class="save-text">{{ $t("todo.save") }}</text></div>
        <div class="delete-button" if="{{editing}}" onclick="DeleteTodo"><text class="delete-text">{{ $t("todo.delete") }}</text></div>
      </div>
      <text style="height: 28px"></text>
    </scroll>
    <full-screen-input if="{{showInput}}" initial-text="{{inputSeed}}" @send="FinishInput" @exit="CloseInput"></full-screen-input>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import { getActiveTodoId, getTodo, createTodo, updateTodo, removeTodo, todayDateText, isValidDate, isValidTime } from "@src/organizer.ts"

export default {
  private: {
    scrclass: "",
    todoId: "",
    editing: false,
    title: "",
    date: "",
    time: "09:00",
    statusText: "",
    showInput: false,
    inputTarget: "",
    inputSeed: ""
  },
  onInit() {
    global.ui.InitPage(this)
    this.LoadTodo()
  },
  async LoadTodo() {
    this.todoId = getActiveTodoId()
    if (!this.todoId) {
      this.editing = false
      this.title = ""
      this.date = todayDateText()
      this.time = "09:00"
      return
    }
    const item = await getTodo(this.todoId)
    if (!item) {
      this.editing = false
      this.todoId = ""
      this.date = todayDateText()
      return
    }
    this.editing = true
    this.title = item.title
    this.date = item.date
    this.time = item.time
  },
  OpenInput(target) {
    this.statusText = ""
    this.inputTarget = target
    this.inputSeed = target === "title" ? this.title : (target === "date" ? this.date : this.time)
    this.showInput = true
  },
  CloseInput() {
    this.showInput = false
    this.inputTarget = ""
    this.inputSeed = ""
  },
  RetryInput(target, value, message) {
    this.statusText = message
    this.showInput = false
    setTimeout(() => {
      this.inputTarget = target
      this.inputSeed = value
      this.showInput = true
    }, 60)
  },
  FinishInput(evt) {
    const value = String(evt.detail && evt.detail.content ? evt.detail.content : "").trim()
    if (!value) {
      this.CloseInput()
      return
    }
    if (this.inputTarget === "date" && !isValidDate(value)) {
      this.RetryInput("date", value, this.$t("todo.invalidDate"))
      return
    }
    if (this.inputTarget === "time" && !isValidTime(value)) {
      this.RetryInput("time", value, this.$t("todo.invalidTime"))
      return
    }
    if (this.inputTarget === "title") this.title = value
    if (this.inputTarget === "date") this.date = value
    if (this.inputTarget === "time") this.time = value
    this.CloseInput()
  },
  async SaveTodo() {
    if (!this.title.trim()) {
      this.statusText = this.$t("todo.taskName")
      return
    }
    if (!isValidDate(this.date)) {
      this.statusText = this.$t("todo.invalidDate")
      return
    }
    if (!isValidTime(this.time)) {
      this.statusText = this.$t("todo.invalidTime")
      return
    }
    try {
      if (this.editing) await updateTodo(this.todoId, { title: this.title, date: this.date, time: this.time })
      else await createTodo({ title: this.title, date: this.date, time: this.time })
      prompt.showToast({ message: this.editing ? this.$t("todo.saved") : this.$t("todo.added"), duration: 1500 })
      setTimeout(() => router.back(), 240)
    } catch (error) {
      this.statusText = this.$t("todo.invalidDate")
    }
  },
  async DeleteTodo() {
    if (!this.editing) return
    await removeTodo(this.todoId)
    prompt.showToast({ message: this.$t("todo.removed"), duration: 1400 })
    setTimeout(() => router.back(), 240)
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./editor.less";
</style>
