<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>

<template>
  <div class="page">
    <scroll class="scroll {{scrclass}}" scroll-y="true" bounces="false">
      <title-bar title="todo.title"></title-bar>
      <div class="todo-content">
        <div class="todo-header"><text class="todo-title">{{ $t("todo.title") }}</text><div class="add-circle" onclick="OpenNewTodo"><text class="add-circle-text">+</text></div></div>
        <div class="progress-card">
          <div class="progress-copy"><text class="progress-label">{{ $t("todo.todayProgress") }}</text><div class="progress-track"><div class="progress-fill" style="width: {{progressPercent}}%"></div></div></div>
          <div class="progress-number"><text class="progress-count">{{ completedCount }}</text><text class="progress-total">/ {{ totalCount }}</text><text class="progress-caption">{{ $t("todo.completed") }}</text></div>
        </div>
        <text class="section-title">{{ $t("todo.today") }}</text>
        <div class="empty-card" if="{{todayTodos.length === 0}}"><text class="empty-text">{{ $t("todo.empty") }}</text></div>
        <div class="todo-card {{ $item.completed ? 'todo-done' : '' }}" for="{{todayTodos}}">
          <div class="todo-check {{ $item.completed ? 'todo-check-done' : '' }}" onclick="ToggleTodo($item.id)"><text class="todo-check-text" if="{{ $item.completed }}">✓</text></div>
          <div class="todo-copy" onclick="OpenTodoEditor($item.id)"><text class="todo-name">{{ $item.title }}</text><text class="todo-due">{{ $item.date }} {{ $item.time }}</text></div>
          <text class="todo-remove" onclick="RemoveTodo($item.id)">×</text>
        </div>
        <text class="section-title" if="{{upcomingTodos.length > 0}}">{{ $t("todo.upcoming") }}</text>
        <div class="todo-card" for="{{upcomingTodos}}">
          <div class="todo-check {{ $item.completed ? 'todo-check-done' : '' }}" onclick="ToggleTodo($item.id)"><text class="todo-check-text" if="{{ $item.completed }}">✓</text></div>
          <div class="todo-copy" onclick="OpenTodoEditor($item.id)"><text class="todo-name">{{ $item.title }}</text><text class="todo-due">{{ $item.date }} {{ $item.time }}</text></div>
          <text class="todo-remove" onclick="RemoveTodo($item.id)">×</text>
        </div>
        <text class="status-text" if="{{statusText}}">{{ statusText }}</text>
      </div>
      <text style="height: 30px"></text>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import { loadOrganizerData, todoSort, todayDateText, toggleTodo, removeTodo, setActiveTodoId } from "@src/organizer.ts"

export default {
  private: {
    scrclass: "",
    todayTodos: [],
    upcomingTodos: [],
    completedCount: 0,
    totalCount: 0,
    progressPercent: 0,
    statusText: ""
  },
  onInit() {
    global.ui.InitPage(this)
    this.RefreshTodos()
  },
  onShow() {
    this.RefreshTodos()
  },
  async RefreshTodos() {
    const data = await loadOrganizerData()
    const todos = data.todos.slice().sort(todoSort)
    const today = todayDateText()
    this.todayTodos = todos.filter((item) => item.date <= today)
    this.upcomingTodos = todos.filter((item) => item.date > today)
    this.totalCount = todos.length
    this.completedCount = todos.filter((item) => item.completed).length
    this.progressPercent = todos.length ? Math.round(this.completedCount * 100 / todos.length) : 0
  },
  OpenNewTodo() {
    setActiveTodoId("")
    router.push({ uri: "pages/app/features/toolbox/todo/editor" })
  },
  OpenTodoEditor(id) {
    setActiveTodoId(id)
    router.push({ uri: "pages/app/features/toolbox/todo/editor" })
  },
  async ToggleTodo(id) {
    await toggleTodo(id)
    await this.RefreshTodos()
  },
  async RemoveTodo(id) {
    await removeTodo(id)
    this.statusText = this.$t("todo.removed")
    await this.RefreshTodos()
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./todo.less";
</style>
