<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>

<template>
  <div class="page">
    <scroll class="scroll {{scrclass}}" scroll-y="true" bounces="false">
      <title-bar title="toolbox.title"></title-bar>
      <div class="toolbox-content">
        <div class="toolbox-card" onclick="OpenWeather">
          <div class="toolbox-card-icon toolbox-weather-icon"><text class="toolbox-card-icon-text">☁</text></div>
          <div class="toolbox-card-copy">
            <text class="toolbox-card-title">{{ $t("toolbox.weather") }}</text>
            <text class="toolbox-card-subtitle">{{ $t("toolbox.weatherDescription") }}</text>
          </div>
          <text class="toolbox-card-arrow">›</text>
        </div>
        <div class="toolbox-card toolbox-card-next" onclick="OpenCalculator">
          <div class="toolbox-card-icon"><text class="toolbox-card-icon-text">+</text></div>
          <div class="toolbox-card-copy">
            <text class="toolbox-card-title">{{ $t("toolbox.calculator") }}</text>
            <text class="toolbox-card-subtitle">{{ $t("toolbox.calculatorDescription") }}</text>
          </div>
          <text class="toolbox-card-arrow">›</text>
        </div>
        <div class="toolbox-card toolbox-card-next" onclick="OpenGame2048">
          <div class="toolbox-card-icon"><text class="toolbox-card-game-icon">2048</text></div>
          <div class="toolbox-card-copy">
            <text class="toolbox-card-title">{{ $t("toolbox.game2048") }}</text>
            <text class="toolbox-card-subtitle">{{ $t("toolbox.game2048Description") }}</text>
          </div>
          <text class="toolbox-card-arrow">›</text>
        </div>
        <div class="toolbox-card toolbox-card-next" onclick="OpenAIChat">
          <div class="toolbox-card-icon toolbox-ai-icon"><text class="toolbox-card-ai-icon-text">AI</text></div>
          <div class="toolbox-card-copy">
            <text class="toolbox-card-title">{{ $t("toolbox.aiChat") }}</text>
            <text class="toolbox-card-subtitle">{{ $t("toolbox.aiChatDescription") }}</text>
          </div>
          <text class="toolbox-card-arrow">›</text>
        </div>
        <div class="toolbox-card toolbox-card-next" onclick="OpenGithub">
          <div class="toolbox-card-icon toolbox-github-icon"><text class="toolbox-card-github-icon-text">GH</text></div>
          <div class="toolbox-card-copy">
            <text class="toolbox-card-title">{{ $t("toolbox.github") }}</text>
            <text class="toolbox-card-subtitle">{{ $t("toolbox.githubDescription") }}</text>
          </div>
          <text class="toolbox-card-arrow">›</text>
        </div>
        <div class="toolbox-card toolbox-card-next" onclick="OpenTodo">
          <div class="toolbox-card-icon toolbox-todo-icon"><text class="toolbox-card-todo-icon-text">✓</text></div>
          <div class="toolbox-card-copy">
            <text class="toolbox-card-title">{{ $t("toolbox.todo") }}</text>
            <text class="toolbox-card-subtitle">{{ $t("toolbox.todoDescription") }}</text>
          </div>
          <text class="toolbox-card-arrow">›</text>
        </div>
        <div class="toolbox-card toolbox-card-next" onclick="OpenCountdown">
          <div class="toolbox-card-icon toolbox-countdown-icon"><text class="toolbox-card-countdown-icon-text">日</text></div>
          <div class="toolbox-card-copy">
            <text class="toolbox-card-title">{{ $t("toolbox.countdown") }}</text>
            <text class="toolbox-card-subtitle">{{ $t("toolbox.countdownDescription") }}</text>
          </div>
          <text class="toolbox-card-arrow">›</text>
        </div>
        <div class="toolbox-card toolbox-card-next" onclick="OpenNotes">
          <div class="toolbox-card-icon toolbox-notes-icon"><text class="toolbox-card-notes-icon-text">▤</text></div>
          <div class="toolbox-card-copy">
            <text class="toolbox-card-title">{{ $t("toolbox.notes") }}</text>
            <text class="toolbox-card-subtitle">{{ $t("toolbox.notesDescription") }}</text>
          </div>
          <text class="toolbox-card-arrow">›</text>
        </div>
      </div>
      <text style="height: 30px"></text>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import { lockNotesSession } from "@src/notes.ts"

export default {
  private: {
    scrclass: ""
  },
  OpenWeather() {
    router.push({
      uri: "pages/app/features/toolbox/weather"
    })
  },
  OpenCalculator() {
    router.push({
      uri: "pages/app/features/toolbox/calculator"
    })
  },
  OpenGame2048() {
    router.push({
      uri: "pages/app/features/toolbox/game2048"
    })
  },
  OpenAIChat() {
    router.push({
      uri: "pages/app/features/toolbox/ai"
    })
  },
  OpenGithub() {
    router.push({ uri: "pages/app/features/toolbox/github/connect" })
  },
  OpenTodo() {
    router.push({ uri: "pages/app/features/toolbox/todo" })
  },
  OpenCountdown() {
    router.push({ uri: "pages/app/features/toolbox/countdown" })
  },
  OpenNotes() {
    lockNotesSession()
    router.push({
      uri: "pages/app/features/toolbox/notes"
    })
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./toolbox.less";
