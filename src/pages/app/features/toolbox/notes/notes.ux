<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>
<import name="notes-pin-input" src="@components/NotesPinInput/NotesPinInput.ux"></import>

<template>
  <div class="page">
    <scroll class="scroll {{scrclass}}" scroll-y="false" bounces="false">
      <title-bar title="notes.title"></title-bar>
      <div class="notes-lock-content">
        <div class="notes-lock-icon"><text class="notes-lock-icon-text">▣</text></div>
        <text class="notes-lock-title" if="{{setupMode}}">{{ $t("notes.createPassword") }}</text>
        <text class="notes-lock-title" if="{{!setupMode}}">{{ $t("notes.unlockTitle") }}</text>
        <text class="notes-lock-description" if="{{setupMode}}">{{ $t("notes.createPasswordDescription") }}</text>
        <text class="notes-lock-description" if="{{!setupMode}}">{{ $t("notes.unlockDescription") }}</text>
        <div class="notes-lock-action" onclick="OpenPasswordInput">
          <text class="notes-lock-action-text" if="{{setupMode}}">{{ $t("notes.setPassword") }}</text>
          <text class="notes-lock-action-text" if="{{!setupMode}}">{{ $t("notes.enterPassword") }}</text>
        </div>
        <text class="notes-lock-status" if="{{statusText}}">{{ statusText }}</text>
      </div>
    </scroll>
    <notes-pin-input if="{{showInput}}" title="{{pinTitle}}" @complete="FinishInput" @exit="CloseInput"></notes-pin-input>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import { loadNotesVault, hasNotesPassword, setNotesPassword, verifyNotesPassword, isValidNotesPin } from "@src/notes.ts"

export default {
  private: {
    scrclass: "",
    setupMode: false,
    showInput: false,
    pinTitle: "notes.enterPassword",
    statusText: ""
  },
  async LoadLockState() {
    const vault = await loadNotesVault()
    this.setupMode = !hasNotesPassword(vault)
  },
  OpenPasswordInput() {
    this.statusText = ""
    this.pinTitle = this.setupMode ? "notes.createPassword" : "notes.enterPassword"
    this.showInput = true
  },
  CloseInput() {
    this.showInput = false
  },
  async FinishInput(evt) {
    this.showInput = false
    const pin = String(evt && evt.detail ? evt.detail.pin : "").trim()
    if (!isValidNotesPin(pin)) {
      this.statusText = this.$t("notes.passwordRule")
      prompt.showToast({ message: this.statusText, duration: 2000 })
      return
    }
    if (this.setupMode) {
      await setNotesPassword(pin)
      router.replace({ uri: "pages/app/features/toolbox/notes/list" })
      return
    }
    const passed = await verifyNotesPassword(pin)
    if (!passed) {
      this.statusText = this.$t("notes.passwordWrong")
      prompt.showToast({ message: this.statusText, duration: 2000 })
      return
    }
    router.replace({ uri: "pages/app/features/toolbox/notes/list" })
  },
  onInit() {
    global.ui.InitPage(this)
    this.LoadLockState()
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./notes.less";
</style>
