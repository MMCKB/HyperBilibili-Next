<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>
<import name="full-screen-input" src="@components/FullScreenInput/FullScreenInput.ux"></import>

<template>
  <div class="page">
    <scroll class="scroll {{scrclass}}" scroll-y="true" bounces="false">
      <title-bar title="notes.title"></title-bar>
      <div class="notes-list-actions">
        <div class="notes-add-button" onclick="OpenCreateInput"><text class="notes-add-button-text">＋ {{ $t("notes.add") }}</text></div>
        <div class="notes-settings-button" onclick="OpenSettings"><text class="notes-settings-button-text">{{ $t("notes.settings") }}</text></div>
      </div>
      <text class="notes-empty" if="{{!hasNotes}}">{{ $t("notes.empty") }}</text>
      <div class="notes-grid" if="{{hasNotes}}">
        <div class="notes-column">
          <div class="note-card" for="{{leftNotes}}" onclick="OpenNote($item.id)">
            <text class="note-card-title">{{ $item.title }}</text>
            <text class="note-card-date">{{ $item.createdAt }}</text>
          </div>
        </div>
        <div class="notes-column notes-right-column">
          <div class="note-card" for="{{rightNotes}}" onclick="OpenNote($item.id)">
            <text class="note-card-title">{{ $item.title }}</text>
            <text class="note-card-date">{{ $item.createdAt }}</text>
          </div>
        </div>
      </div>
      <text style="height: 34px"></text>
    </scroll>
    <full-screen-input if="{{showInput}}" style="position: absolute" initial-text="{{inputSeed}}" @send="CreateNewNote" @exit="CloseInput"></full-screen-input>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import { createNote, isNotesSessionUnlocked, loadNotesVault, setActiveNoteId } from "@src/notes.ts"

export default {
  private: {
    scrclass: "",
    hasNotes: false,
    leftNotes: [],
    rightNotes: [],
    showInput: false,
    inputSeed: ""
  },
  SplitNotes(notes) {
    const left = []
    const right = []
    notes.forEach((item, index) => {
      if (index % 2 === 0) left.push(item)
      else right.push(item)
    })
    this.leftNotes = left
    this.rightNotes = right
    this.hasNotes = notes.length > 0
  },
  async LoadNotes() {
    const vault = await loadNotesVault()
    this.SplitNotes(vault.notes)
  },
  OpenCreateInput() {
    this.inputSeed = ""
    this.showInput = true
  },
  CloseInput() {
    this.showInput = false
  },
  async CreateNewNote(evt) {
    this.showInput = false
    const title = String(evt && evt.detail ? evt.detail.content : "").trim()
    if (!title) {
      prompt.showToast({ message: this.$t("notes.nameRequired"), duration: 1800 })
      return
    }
    const note = await createNote(title)
    setActiveNoteId(note.id)
    router.push({ uri: "pages/app/features/toolbox/notes/detail" })
  },
  OpenNote(noteId) {
    setActiveNoteId(noteId)
    router.push({ uri: "pages/app/features/toolbox/notes/detail" })
  },
  OpenSettings() {
    router.push({ uri: "pages/app/features/toolbox/notes/settings" })
  },
  onShow() {
    if (!isNotesSessionUnlocked()) {
      router.replace({ uri: "pages/app/features/toolbox/notes" })
      return
    }
    this.LoadNotes()
  },
  onInit() {
    global.ui.InitPage(this)
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./list.less";
</style>
