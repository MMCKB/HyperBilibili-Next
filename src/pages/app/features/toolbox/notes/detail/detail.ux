<import name="full-screen-input" src="@components/FullScreenInput/FullScreenInput.ux"></import>

<template>
  <div class="page">
    <scroll class="scroll {{scrclass}}" scroll-y="true" bounces="false">
      <div class="note-detail-header">
        <div class="note-detail-back" onclick="GoBack"><text class="note-detail-back-text">‹</text></div>
        <text class="note-detail-header-title">{{ $t("notes.detail") }}</text>
        <div class="note-detail-edit" onclick="ToggleEdit"><text class="note-detail-edit-text">{{ editing ? $t("notes.save") : $t("notes.edit") }}</text></div>
      </div>
      <div class="note-detail-content" if="{{noteLoaded}}">
        <text class="note-detail-title">{{ draftTitle }}</text>
        <text class="note-detail-date">{{ $t("notes.createdAt") }} {{ createdAt }}</text>
        <div class="note-detail-view-card" if="{{!editing}}"><text class="note-detail-view-text">{{ draftContent || $t("notes.contentEmpty") }}</text></div>
        <div class="note-detail-edit-card" if="{{editing}}">
          <div class="note-detail-edit-row" onclick="OpenInput('title')">
            <text class="note-detail-edit-label">{{ $t("notes.name") }}</text>
            <text class="note-detail-edit-value">{{ draftTitle }}</text>
          </div>
          <div class="note-detail-edit-row note-detail-content-row" onclick="OpenInput('content')">
            <text class="note-detail-edit-label">{{ $t("notes.content") }}</text>
            <text class="note-detail-edit-value">{{ draftContent || $t("notes.contentEmpty") }}</text>
          </div>
        </div>
      </div>
    </scroll>
    <full-screen-input if="{{showInput}}" style="position: absolute" initial-text="{{inputSeed}}" @send="FinishInput" @exit="CloseInput"></full-screen-input>
  </div>
</template>

<script>
import router from "@system.router"
import { getActiveNoteId, getNote, isNotesSessionUnlocked, updateNote } from "@src/notes.ts"

export default {
  private: {
    scrclass: "",
    noteId: "",
    noteLoaded: false,
    editing: false,
    draftTitle: "",
    draftContent: "",
    createdAt: "",
    showInput: false,
    inputSeed: "",
    inputTarget: ""
  },
  async LoadNote() {
    if (!isNotesSessionUnlocked()) {
      router.replace({ uri: "pages/app/features/toolbox/notes" })
      return
    }
    this.noteId = getActiveNoteId()
    const note = await getNote(this.noteId)
    if (!note) {
      router.replace({ uri: "pages/app/features/toolbox/notes/list" })
      return
    }
    this.draftTitle = note.title
    this.draftContent = note.content
    this.createdAt = note.createdAt
    this.noteLoaded = true
  },
  GoBack() {
    global.ui.OnBackPressTriggered()
  },
  async ToggleEdit() {
    if (!this.editing) {
      this.editing = true
      return
    }
    const saved = await updateNote(this.noteId, { title: this.draftTitle, content: this.draftContent })
    if (saved) {
      this.draftTitle = saved.title
      this.draftContent = saved.content
      this.createdAt = saved.createdAt
    }
    this.editing = false
  },
  OpenInput(target) {
    this.inputTarget = target
    this.inputSeed = target === "title" ? this.draftTitle : this.draftContent
    this.showInput = true
  },
  CloseInput() {
    this.showInput = false
  },
  FinishInput(evt) {
    this.showInput = false
    const content = String(evt && evt.detail ? evt.detail.content : "")
    if (this.inputTarget === "title") {
      this.draftTitle = content.trim() || this.draftTitle
    } else if (this.inputTarget === "content") {
      this.draftContent = content
    }
  },
  onInit() {
    global.ui.InitPage(this)
    this.LoadNote()
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./detail.less";
</style>
