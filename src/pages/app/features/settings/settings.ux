<import name="switch-bar" src="@components/SwitchBar/SwitchBar.ux"></import>

<template>
  <div class="page">
    <scroll class="scroll {{scrclass}}" scroll-y="true" bounces="true">
      <switch-bar title="settings.title"></switch-bar>
      <img src="/common/settings_version.png" @click="GoAbout"></img>
      <div class="setbase" onclick="ClickCountSet('fresh_type')">
        <image class="seticon" src="/common/settings_freshtype.png"></image>
        <text class="setext_small">{{ $t("settings.videoPushRelevance") }}</text>
        <text class="countset_num">{{ fresh_type }}</text>
      </div>
      <div class="setbase" onclick="ClickCountSet('home_vid_count')">
        <image class="seticon" src="/common/settings_homevidcount.png"></image>
        <text class="setext_small">{{ $t("settings.videoPushCount") }}</text>
        <text class="countset_num">{{ home_vid_count }}</text>
      </div>
      <div class="setbase" onclick="ClickCountSet('search_vid_count')">
        <image class="seticon" src="/common/settings_searchvidcount.png"></image>
        <text class="setext_small">{{ $t("settings.searchVidCount") }}</text>
        <text class="countset_num">{{ search_vid_count }}</text>
      </div>
      <div class="setbase" onclick="SwitchSet('enable_full_anim')">
        <image class="seticon" src="/common/settings_enablefullanim.png"></image>
        <text class="setext_small">{{ $t("settings.enableFullAnimation") }}</text>
        <text class="countset_num">{{ enableFullAnimation ? "开" : "关" }}</text>
      </div>
      <div class="setbase" onclick="SwitchSet('enable_comment_pictures')">
        <image class="seticon" src="/common/settings_commentpictures.png"></image>
        <text class="setext_small">{{ $t("settings.enableCommentPictures") }}</text>
        <text class="countset_num">{{ enableCommentPictures ? "开" : "关" }}</text>
      </div>
      <div class="setbase" onclick="ItemsChangeSet('startup_page')">
        <image class="seticon" src="/common/settings_startuppage.png"></image>
        <text class="setext_small">{{ $t("settings.startupPage") }}</text>
        <text class="countset_num">{{ startupPage }}</text>
      </div>
      <div class="setbase" @click="GoPlayerAppearance()">
        <image class="seticon" src="/common/settings_playerappearance.png"></image>
        <text class="setext_small">{{ $t("settings.playerAppearance") }}</text>
        <image class="arrow" src="/common/arrow_right.png"></image>
      </div>
      <div class="setbase" @click="GoKeyboardSettings()">
        <image class="seticon" src="/common/settings_keyboard.png"></image>
        <text class="setext_small">{{ $t("settings.keyboardSettings") }}</text>
        <image class="arrow" src="/common/arrow_right.png"></image>
      </div>
      <div class="setbase" @click="ClearTmp()">
        <image class="seticon" src="/common/settings_removetmp.png"></image>
        <text class="setext_small">{{ $t("settings.clearTemp") }}</text>
        <image class="arrow" src="/common/arrow_right.png"></image>
      </div>
      <div class="setbase" @click="logout()">
        <image class="seticon" src="/common/settings_logout.png"></image>
        <text class="setext_small">{{ $t("settings.logOut") }}</text>
        <image class="arrow" src="/common/arrow_right.png"></image>
      </div>
      <div class="setbase" @click="GoDonation()">
        <image class="seticon" src="/common/donation.png"></image>
        <text class="setext_small">{{ $t("settings.donation") }}</text>
        <image class="arrow" src="/common/arrow_right.png"></image>
      </div>
      <div class="setbase" @click="GoAbout()">
        <image class="seticon" src="/common/settings_about.png"></image>
        <text class="setext_small">{{ $t("settings.about") }}</text>
        <image class="arrow" src="/common/arrow_right.png"></image>
      </div>
      <div class="setbase" @click="GoDebug()">
        <image class="seticon" src="/common/settings_debug.png"></image>
        <text class="setext_small">{{ $t("settings.debug") }}</text>
        <image class="arrow" src="/common/arrow_right.png"></image>
      </div>
      <image style="margin-top: 30px" src="/common/opensource_warning.png"></image>
      <text style="margin-top: 25px"></text>
    </scroll>
    <!-- 退出登录确认弹层（应用内自绘）
         不用 prompt.showDialog：该系统弹窗在本机引擎上点按钮后 success 回调不触发，
         表现为"点了退出没反应"，且 try/catch 无从捕获（回调根本没执行） -->
    <div class="confirm-mask" if="{{showLogoutConfirm}}">
      <div class="confirm-card">
        <text class="confirm-title">退出登录</text>
        <text class="confirm-msg">确定退出当前账号吗？退出后将从账号列表移除。</text>
        <div class="confirm-btn confirm-btn-primary" @click="ConfirmLogout">
          <text class="confirm-btn-text">退出</text>
        </div>
        <div class="confirm-btn" @click="CancelLogout">
          <text class="confirm-btn-text" style="color: #999999">取消</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
export default {
  private: {
    fresh_type: 3,
    home_vid_count: 10,
    search_vid_count: 10,
    enableFullAnimation: false,
    enableCommentPictures: false,
    startupPage: "主页",
    countset: {
      fresh_type_max: 3,
      fresh_type_min: 1,
      home_vid_count_max: 14,
      home_vid_count_min: 1,
      search_vid_count_max: 20,
      search_vid_count_min: 1
    },
    scrclass: "",
    showLogoutConfirm: false
  },
  GoDonation(){
    router.push({
      uri: "pages/app/features/settings/donation"
    })
  },
  GoAbout() {
    router.push({
      uri: "pages/app/features/settings/about"
    })
  },
  GoDebug() {
    router.push({
      uri: "pages/debug/componentstest"
    })
  },
  GoPlayerAppearance() {
    router.push({
      uri: "pages/app/features/settings/playerappearance"
    })
  },
  GoKeyboardSettings() {
    router.push({
      uri: "pages/app/features/settings/keyboard"
    })
  },
  ClearTmp() {
    router.push({
      uri: "pages/app/features/settings/cleartmp"
    })
  },
  SwitchSet(name) {
    if (name === "enable_full_anim") {
      this.enableFullAnimation = !this.enableFullAnimation;
      global.settings.saveSettings({ enableFullAnimation: this.enableFullAnimation });

      if (this.enableFullAnimation) {
        prompt.showToast({
          message: "开启此选项会导致首页等页面在低性能设备上严重卡顿，因此建议保持关闭！",
          duration: 6000
        });
      }
      this.UpdateNumView();
    } else if (name === "enable_comment_pictures") {
      this.enableCommentPictures = !this.enableCommentPictures;
      global.settings.saveSettings({ enableCommentPictures: this.enableCommentPictures });

      if (this.enableCommentPictures) {
        prompt.showToast({
          message: "已开启评论区图片显示，加载图片可能影响低性能设备流畅度。",
          duration: 4000
        });
      }
      this.UpdateNumView();
    }
  },
  ClickCountSet(name) {
    const mapping = {
      "fresh_type": {
        current: this.fresh_type,
        max: this.countset.fresh_type_max,
        min: this.countset.fresh_type_min,
        key: "fresh_type"
      },
      "home_vid_count": {
        current: this.home_vid_count,
        max: this.countset.home_vid_count_max,
        min: this.countset.home_vid_count_min,
        key: "home_vid_count"
      },
      "search_vid_count": {
        current: this.search_vid_count,
        max: this.countset.search_vid_count_max,
        min: this.countset.search_vid_count_min,
        key: "search_vid_count"
      }
    };

    if (mapping[name]) {
      const { current, max, min, key } = mapping[name];
      const newValue = current < max ? current + 1 : min;
      global.settings.saveSettings({ [key]: newValue });
      
      // 延时更新视图
      setTimeout(() => {
        this.UpdateNumView();
      }, 100);
    }
  },
  ItemsChangeSet(name) {
    if (name === "startup_page") {
      const pages = ["主页", "私信", "菜单"];
      // 新建变量 startupPage 用于存储当前启动页状态，若未初始化则默认取 "主页"
      if (!this.startupPage) {
        this.startupPage = pages[0];
      } else {
        // 获取当前 startupPage 在 pages 数组中的索引，然后切换到下一个项（循环）
        let index = pages.indexOf(this.startupPage);
        index = (index + 1) % pages.length;
        this.startupPage = pages[index];
      }
      global.settings.saveSettings({
        startupPage: this.startupPage
      });
      this.UpdateNumView();
    }
  },
  logout() {
    // 只弹出应用内确认层，实际登出在 ConfirmLogout 里做
    this.showLogoutConfirm = true
  },
  CancelLogout() {
    this.showLogoutConfirm = false
  },
  ConfirmLogout() {
    this.showLogoutConfirm = false
    // 立即反馈：如果这条 toast 都不出现，说明点击事件本身没触发（与登出逻辑无关）
    prompt.showToast({ message: "正在退出..." })

    const task = Promise.resolve()
      .then(() => global.biliclient.logOutWithList())
      .catch((e) => {
        global.logger.error(`退出登录失败: ${e && e.toString ? e.toString() : e}`)
        prompt.showToast({ message: "退出出现异常，请重试" })
      })

    // 引擎回调不可靠的兜底：登出流程 5 秒内没跑完也强制跳转，绝不卡在设置页
    const guard = new Promise((resolve) => setTimeout(resolve, 5000))

    Promise.race([task, guard]).then(() => {
      router.clear()
      router.replace({
        uri: "pages/app/entry/splash"
      })
    })
  },
  UpdateNumView() {
    this.fresh_type = global.settings.SETTINGS.fresh_type
    this.home_vid_count = global.settings.SETTINGS.home_vid_count
    this.search_vid_count = global.settings.SETTINGS.search_vid_count
    this.enableFullAnimation = global.settings.SETTINGS.enableFullAnimation
    this.enableCommentPictures = global.settings.SETTINGS.enableCommentPictures
    this.startupPage = global.settings.SETTINGS.startupPage
  },
  onInit() {
    this.UpdateNumView()
  }
}
</script>

<style lang="less">
@import '@less/global.less';
@import './settings.less';
</style>