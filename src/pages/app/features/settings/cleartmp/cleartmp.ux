<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>
<import name="default-button" src="@components/DefaultButton/DefaultButton.ux"></import>

<template>
  <div class="page">
    <scroll class="scroll {{scrclass}}" scroll-y="true" bounces="true">
      <title-bar title="cleartmp.title"></title-bar>
      <text class="cleartip" style="margin-top: 10px">请先选择类别</text>
      <text class="cleartip">随后点击按钮以进行清理</text>
      <div class="typebox" style="margin-top: 25px">
        <text if="{{tmps.length < 1}}" style="font-weight: 600; font-size: 24px; color: #9e9e9e">
          缓存文件扫描中...
        </text>
        <div style="padding: 5px; width: 77%" for="{{tmps}}">
          <div class="tmptype" onclick="SelectHandler($item.alias)" style="background-color: {{typeColors[$item.alias]}}">
            <text class="typetxt">{{ $item.name }}</text>
            <text class="typesize">{{ $item.size }}</text>
          </div>
        </div>
      </div>
      <default-button @click="ClearClick" primary="true" margin-top="25px" text="cleartmp.clear"
        disabled="{{cantClear}}"></default-button>
      <text style="margin-top: 30px"></text>
    </scroll>
    <!-- 清除确认弹层（应用内自绘）
         不用 prompt.showDialog：该系统弹窗在本机引擎上点按钮后 success 回调不触发，
         表现为"点了确定没反应"，缓存内容/视频音频将永远无法被选中清理 -->
    <div class="confirm-mask" if="{{showConfirm}}">
      <div class="confirm-card">
        <text class="confirm-title">清除确认</text>
        <text class="confirm-msg">{{ confirmMsg }}</text>
        <div class="confirm-btn confirm-btn-primary" @click="ConfirmSelect">
          <text class="confirm-btn-text">清除</text>
        </div>
        <div class="confirm-btn" @click="CancelSelect">
          <text class="confirm-btn-text" style="color: #999999">取消</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import prompt from "@system.prompt"
import {asyncFile} from "../../../../../asyncapi/file"

export default {
  private: {
    tmps: [],
    cantClear: true,
    clearControl: {
      imgs: false,
      logs: false,
      sc: false,
      videoAudio: false
    },
    typeColors: {
      imgs: "#434343",
      logs: "#434343",
      sc: "#434343",
      videoAudio: "#434343",
      others: "#222222"
    },
    // 自绘确认弹层状态（confirmType: 待确认的清理类别）
    showConfirm: false,
    confirmType: "",
    confirmMsg: "",
    // 已缓存条目引用的本地封面文件（扫描时归入"缓存内容"，避免被当作临时图片清理）
    savedCoverUrls: {},
    scrclass: ""
  },
  RefreshPage() {
    this.cantClear = true
    this.clearControl = {
      imgs: false,
      logs: false,
      sc: false,
      videoAudio: false
    }
    this.typeColors = {
      imgs: "#434343",
      logs: "#434343",
      sc: "#434343",
      videoAudio: "#434343",
      others: "#222222"
    }
  },
  async ClearClick() {
    const tasks = []

    if (this.clearControl.imgs) {
      const imgTemp = this.tmps.find((t) => t.alias === "imgs")
      if (imgTemp) {
        imgTemp.list.forEach((uri) => {
          tasks.push(asyncFile.delete({uri}).catch(() => {}))
        })
      }
    }

    if (this.clearControl.logs) {
      const logTemp = this.tmps.find((t) => t.alias === "logs")
      if (logTemp) {
        logTemp.list.forEach((uri) => {
          tasks.push(asyncFile.delete({uri}).catch(() => {}))
        })
      }
    }

    let deletedVideoAudioBvids = []

    if (this.clearControl.sc) {
      const contents = await global.savedcontent.SavedContentManager.listAllContent()
      for (const ct of contents) {
        await global.savedcontent.SavedContentManager.deleteContent(ct.id)
      }
      // 缓存内容全部清除，下载记录一并清空（其大小/状态已无对应文件）
      if (global.downloadrecords) {
        await global.downloadrecords.DownloadRecordManager.clearAll()
      }
    }

    if (this.clearControl.videoAudio) {
      const contents = await global.savedcontent.SavedContentManager.listAllContent()
      const videoAudioContents = contents.filter((ct) => ct.type === 'videoAudio')
      for (let i = 0; i < videoAudioContents.length; i++) {
        const ct = videoAudioContents[i]
        deletedVideoAudioBvids.push(ct.bvid)
        await global.savedcontent.SavedContentManager.deleteContent(ct.id)
      }
      // 对应视频的下载记录同步删除
      if (global.downloadrecords && deletedVideoAudioBvids.length > 0) {
        await global.downloadrecords.DownloadRecordManager.removeByBvids(deletedVideoAudioBvids)
      }
    }

    // 视频音频孤儿文件清扫：扫描到的 m4s 可能没有缓存记录（下载后校验失败/流程中断），
    // 只删记录会留下这些文件，导致清理后重新扫描仍显示占用
    if (this.clearControl.sc || this.clearControl.videoAudio) {
      const vaTemp = this.tmps.find((t) => t.alias === "videoAudio")
      if (vaTemp) {
        vaTemp.list.forEach((uri) => {
          tasks.push(asyncFile.delete({uri}).catch(() => {}))
        })
      }
    }

    await Promise.all(tasks)

    prompt.showToast({
      message: "清理完毕"
    })

    this.ScanTemps()
    this.RefreshPage()
  },
  SelectHandler(name) {
    switch (name) {
      case "imgs":
        this.clearControl.imgs = !this.clearControl.imgs
        this.typeColors.imgs = this.clearControl.imgs ? "#FF7DA8" : "#434343"
        break
      case "logs":
        this.clearControl.logs = !this.clearControl.logs
        this.typeColors.logs = this.clearControl.logs ? "#FF7DA8" : "#434343"
        break
      case "sc":
        if (!this.clearControl.sc) {
          // 自绘确认弹层（系统对话框按钮回调不触发）
          this.confirmType = "sc"
          this.confirmMsg =
            "清除缓存内容即意味着清除您之前缓存的专栏、音频等内容，且该操作不可逆。确定要继续吗？"
          this.showConfirm = true
        } else {
          this.clearControl.sc = false
          this.typeColors.sc = "#434343"
        }
        break
      case "videoAudio":
        if (!this.clearControl.videoAudio) {
          this.confirmType = "videoAudio"
          this.confirmMsg =
            "清除视频音频将删除所有已缓存的视频音频文件，且该操作不可逆。确定要继续吗？"
          this.showConfirm = true
        } else {
          this.clearControl.videoAudio = false
          this.typeColors.videoAudio = "#434343"
        }
        break
    }

    this.cantClear = !(this.clearControl.imgs || this.clearControl.logs || this.clearControl.sc || this.clearControl.videoAudio)
    global.logger.log("[ClearTmp.SelectHandler] cantClear: ", this.cantClear)
  },
  ConfirmSelect() {
    const type = this.confirmType
    this.showConfirm = false
    this.confirmType = ""
    if (type === "sc") {
      this.clearControl.sc = true
      this.typeColors.sc = "#FF7DA8"
    } else if (type === "videoAudio") {
      this.clearControl.videoAudio = true
      this.typeColors.videoAudio = "#FF7DA8"
    }
    this.cantClear = !(this.clearControl.imgs || this.clearControl.logs || this.clearControl.sc || this.clearControl.videoAudio)
  },
  CancelSelect() {
    this.showConfirm = false
    this.confirmType = ""
  },
  BytesToMB(bytes) {
    return (bytes / (1024 * 1024)).toFixed(2)
  },
  async getSavedContentList() {
    try {
      const contents = await global.savedcontent.SavedContentManager.listAllContent()
      // 收集缓存条目引用的本地封面文件，扫描时归入"缓存内容"而非"临时图片"，
      // 避免清理临时图片后已缓存视频的封面丢失
      const savedCoverUrls = {}
      contents.forEach((content) => {
        if (content.coverUrl && content.coverUrl.indexOf("internal://files/") === 0) {
          savedCoverUrls[content.coverUrl] = true
        }
      })
      this.savedCoverUrls = savedCoverUrls
      const ret = await Promise.all(
        contents.map(async (content) => {
          try {
            const fileExists = await asyncFile.access({uri: content.fileUri})
            if (!fileExists) {
              return null
            }
            const data = await asyncFile.get({uri: content.fileUri})
            return {
              uri: content.fileUri,
              length: data.length,
              _labelIsSavedContent: true
            }
          } catch (e) {
            global.logger.log("缓存文件不存在，跳过：" + content.fileUri)
            return null
          }
        })
      )
      return ret.filter(item => item !== null)
    } catch (e) {
      global.logger.error("在扫描临时文件（统计缓存内容）时出错：", e.toString())
      return []
    }
  },
  async ScanTemps() {
    try {
      // 准备统计对象
      const totalStats = {
        images: {count: 0, size: 0, list: []},
        logs: {count: 0, size: 0, list: []},
        savedContent: {count: 0, size: 0},
        videoAudio: {count: 0, size: 0, list: []},
        others: {count: 0, size: 0}
      }

      // 并行获取文件列表
      // logs 目录容错：日志已改为不落盘，新安装设备上该目录可能不存在
      // 单独 catch 按空列表处理，避免整个扫描因一处失败而中止
      const [rootFiles, logFiles, savedContentFiles] = await Promise.all([
        asyncFile.list({uri: "internal://files/"}),
        asyncFile.list({uri: "internal://files/logs"}).catch(() => ({fileList: []})),
        this.getSavedContentList()
      ])

      const fileList = [...rootFiles.fileList, ...logFiles.fileList, ...savedContentFiles]

      for (const file of fileList) {
        const {uri, length, _labelIsSavedContent} = file

        if (this.savedCoverUrls[uri]) {
          // 缓存条目的本地封面：计入"缓存内容"，不参与临时图片清理
          totalStats.savedContent.count++
          totalStats.savedContent.size += length
        } else if (/\.m4s$/i.test(uri)) {
          totalStats.videoAudio.count++
          totalStats.videoAudio.size += length
          totalStats.videoAudio.list.push(uri)
        } else if (/\.(jpg|png|avif|gif)/i.test(uri)) {
          totalStats.images.count++
          totalStats.images.size += length
          totalStats.images.list.push(uri)
        } else if (/\.log$/i.test(uri)) {
          totalStats.logs.count++
          totalStats.logs.size += length
          totalStats.logs.list.push(uri)
        } else if (_labelIsSavedContent) {
          totalStats.savedContent.count++
          totalStats.savedContent.size += length
        } else {
          totalStats.others.count++
          totalStats.others.size += length
        }
      }

      this.tmps = [
        {
          name: "临时图片",
          alias: "imgs",
          size: `${this.BytesToMB(totalStats.images.size)} MB`,
          list: totalStats.images.list
        },
        {
          name: "日志文件",
          alias: "logs",
          size: `${this.BytesToMB(totalStats.logs.size)} MB`,
          list: totalStats.logs.list
        },
        {
          name: "缓存内容",
          alias: "sc",
          size: `${this.BytesToMB(totalStats.savedContent.size)} MB`
        },
        {
          name: "视频音频",
          alias: "videoAudio",
          size: `${this.BytesToMB(totalStats.videoAudio.size)} MB`,
          list: totalStats.videoAudio.list
        },
        {
          name: "其它",
          alias: "others",
          size: `${this.BytesToMB(totalStats.others.size)} MB`
        }
      ]
    } catch (e) {
      global.logger.error("在扫描临时文件时出错：", e.toString())
    }
  },
  onInit() {
    this.ScanTemps()
  }
}
</script>

<style lang="less">
@import "@less/global.less";
@import "./cleartmp.less";
</style>