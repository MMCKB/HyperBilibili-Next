<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>
<import name="default-button" src="@components/DefaultButton/DefaultButton.ux"></import>

<template>
  <div class="page">
    <scroll class="scroll {{scrclass}}" scroll-y="true" bounces="true">
      <title-bar title="playerAppearance.title"></title-bar>

      <div class="preview-panel">
        <text class="section-title">{{ $t("playerAppearance.preview") }}</text>
        <div class="preview-background">
          <div class="toolbar-preview" style="background-color: {{toolbarBackgroundColor}}; border-radius: {{toolbarRadius}}px;">
            <image class="preview-icon" src="/common/icon/volume.png"></image>
            <image class="preview-icon" src="/common/icon/play-list.png"></image>
            <image class="preview-icon" src="/common/icon/repeat.png"></image>
            <image class="preview-icon" src="/common/icon/progress.png"></image>
            <image class="preview-icon" src="/common/icon/exit.png"></image>
          </div>
        </div>
      </div>

      <div class="setting-card">
        <div class="setting-heading">
          <text class="setting-title">{{ $t("playerAppearance.opacity") }}</text>
          <text class="setting-value">{{ toolbarOpacity }}%</text>
        </div>
        <div class="slider-wrapper">
          <slider class="appearance-slider" min="0" max="100" step="1" value="{{ toolbarOpacity }}" onchange="onOpacityChange"></slider>
        </div>
        <div class="adjust-buttons">
          <div class="adjust-button" onclick="adjustOpacity(-1)"><text class="adjust-button-text">−</text></div>
          <div class="adjust-button" onclick="adjustOpacity(1)"><text class="adjust-button-text">+</text></div>
        </div>
      </div>

      <div class="setting-card">
        <div class="setting-heading">
          <text class="setting-title">{{ $t("playerAppearance.radius") }}</text>
          <text class="setting-value">{{ toolbarRadius }}px</text>
        </div>
        <div class="slider-wrapper">
          <slider class="appearance-slider" min="0" max="50" step="1" value="{{ toolbarRadius }}" onchange="onRadiusChange"></slider>
        </div>
        <div class="adjust-buttons">
          <div class="adjust-button" onclick="adjustRadius(-1)"><text class="adjust-button-text">−</text></div>
          <div class="adjust-button" onclick="adjustRadius(1)"><text class="adjust-button-text">+</text></div>
        </div>
      </div>

      <default-button @click="restoreDefaults" primary="true" margin-top="20px" text="playerAppearance.restoreDefaults"></default-button>
      <text style="margin-top: 30px"></text>
    </scroll>
  </div>
</template>

<script>
export default {
  private: {
    toolbarOpacity: 30,
    toolbarRadius: 30,
    toolbarBackgroundColor: "rgba(0, 0, 0, 0.3)",
    scrclass: ""
  },
  clampValue(value, min, max, fallback) {
    const numericValue = Number(value);
    if (isNaN(numericValue)) {
      return fallback;
    }
    return Math.max(min, Math.min(max, Math.round(numericValue)));
  },
  updatePreview() {
    this.toolbarOpacity = this.clampValue(this.toolbarOpacity, 0, 100, 30);
    this.toolbarRadius = this.clampValue(this.toolbarRadius, 0, 50, 30);
    this.toolbarBackgroundColor = `rgba(0, 0, 0, ${this.toolbarOpacity / 100})`;
  },
  saveAppearance() {
    this.updatePreview();
    global.settings.saveSettings({
      playerToolbarOpacity: this.toolbarOpacity,
      playerToolbarRadius: this.toolbarRadius
    });
  },
  onOpacityChange(event) {
    this.toolbarOpacity = event.progress;
    this.saveAppearance();
  },
  onRadiusChange(event) {
    this.toolbarRadius = event.progress;
    this.saveAppearance();
  },
  adjustOpacity(delta) {
    this.toolbarOpacity = Number(this.toolbarOpacity) + delta;
    this.saveAppearance();
  },
  adjustRadius(delta) {
    this.toolbarRadius = Number(this.toolbarRadius) + delta;
    this.saveAppearance();
  },
  restoreDefaults() {
    this.toolbarOpacity = 30;
    this.toolbarRadius = 30;
    this.saveAppearance();
  },
  onInit() {
    this.toolbarOpacity = global.settings.SETTINGS.playerToolbarOpacity;
    this.toolbarRadius = global.settings.SETTINGS.playerToolbarRadius;
    this.updatePreview();
  }
}
</script>

<style lang="less">
@import '@less/global.less';
@import './playerappearance.less';
</style>
