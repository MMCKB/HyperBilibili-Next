<import name="switch-bar" src="@components/SwitchBar/SwitchBar.ux"></import>
<import name="videoshow" src="@components/Video/Video.ux"></import>

<template>
  <div class="page">
    <stack style="width: 100%; height: 100%">
    <image style="position: absolute; left: 0px" src="{{getBgImg}}"></image>
    <scroll scroll-y="true" class="zoomscroll {{scrclass}}" bounces="true">
      <switch-bar title="main.title" show-pill="{{true}}"></switch-bar>
      <text class="tip">{{ funnytip }}</text>
      <image
        style="position: absolute; margin-top: 265px"
        if="{{anims.show_loading}}"
        src="{{anims.loading_src.value}}">
      </image>
      <div class="recommend_div" if="{{show_recommend_div}}">
        <videoshow for="{{recommend_vids}}" video="{{$item}}" tid="vids"></videoshow>
        <text style="margin-top: 25px" static></text>
      </div>
    </scroll>
    <div style="position: absolute; bottom: 0px; left: 166px" @click="Refresh()">
      <image src="/common/main_floatingrefresh.png" static></image>
    </div>
    <text style="position: absolute; color: rgba(0, 0, 0, 0); width: 0px; top: 50px">
      {{ anims.refresh_bottom.value }}
    </text>
    <div
      if="{{anims.showRefreshFX}}"
      style="position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; flex-direction: column; align-items: center">
      <image style="position: absolute; bottom: {{anims.refresh_bottom.value}}px" src.static="/common/TranslateFX/refreshFX.png"></image>
    </div>
    <!-- 弹层：充电与播放共用一层遮罩，可同时显示 -->
    <div if="{{popupVisible || chargeVisible}}" class="popup-overlay" @click="ClosePopups">
      <div if="{{popupVisible}}" class="play-popup" style="{{playStyle}}" @click="StopPropagation">
        <div class="popup-cover">
          <text if="{{!popupCover}}" class="cover-note">♪</text>
          <image if="{{popupCover}}" class="popup-cover-img" src="{{popupCover}}"></image>
        </div>
        <div class="popup-content">
          <text class="popup-title">{{popupTitle}}</text>
          <div class="popup-buttons">
            <div class="popup-btn" @click="TogglePlay">
              <image if="{{popupPlaying}}" class="popup-btn-icon" src="/common/icon/pause.png"></image>
              <image else class="popup-btn-icon" src="/common/icon/play.png"></image>
            </div>
            <div class="popup-btn volume-btn" @click="ToggleVolume">
              <image class="popup-btn-icon" src="/common/icon/volume.png"></image>
            </div>
          </div>
        </div>
      </div>
      <div if="{{chargeVisible}}" class="charge-popup" @click="StopPropagation">
        <div class="charge-popup-iconbox">
          <image class="charge-popup-bolt" src="/common/icon/charging_green.png"></image>
        </div>
        <div class="charge-popup-content">
          <text class="charge-popup-label">正在充电</text>
          <text class="charge-popup-pct">{{chargePercent}}%</text>
        </div>
      </div>
      <div if="{{popupVisible && showVolume}}" class="volume-panel" style="{{volumeStyle}}" @click="StopPropagation">
        <image class="volume-icon" src="/common/icon/volume.png"></image>
        <slider class="volume-slider" min="0" max="100" value="{{volumePercent}}" @change="OnVolumeChange"></slider>
        <text class="volume-value">{{volumePercent}}%</text>
      </div>
    </div>
    </stack>
  </div>
</template>

<script>
import audio from "@system.audio"
import prompt from "@system.prompt"
import storage from "@system.storage"

export default {
  private: {
    scrclass: "",
    // 初始化推荐视频数组为空，后续采用原地更新方式
    recommend_vids: [],
    show_recommend_div: false,
    funnytip: "",
    anims: {
      show_loading: false,
      refresh: null,
      showRefreshFX: false,
      refresh_bottom: { value: "-350" }
    },
    bgimg: "",
    // 播放弹层
    popupVisible: false,
    popupPlaying: false,
    popupTitle: "",
    popupCover: "",
    showVolume: false,
    volumePercent: 50,
    chargeVisible: false,
    chargePercent: 0,
    playStyle: { top: "60px" },
    volumeStyle: { top: "156px" },
    popupTimer: null
  },
  computed: {
    getBgImg() {
      return this.$app.$def.bgimg.GetBackgroundImageSrc();
    }
  },
  async Refresh() {
    if (!this.anims.showRefreshFX) {
      this.recommend_vids.splice(0, this.recommend_vids.length);
      this.anims.show_loading = true;
      this.show_recommend_div = false;
      this.anims.showRefreshFX = true;

      this.anims.loading.start();

      this._timerRefreshStart = setTimeout(() => {
        this.anims.refresh.start();
      }, 200);

      this._timerRefreshStop = setTimeout(async () => {
        this.anims.refresh_bottom.value = "-350px";
        this.anims.refresh.stop();
        this.anims.showRefreshFX = false;
        await this.GetVids();
      }, 1200);
    } else {
      prompt.showToast({ message: "你先别急。" });
    }
  },
  async GetVids() {
    try {
      const { fresh_type, home_vid_count } = global.settings.SETTINGS;

      const vids = await global.biliclient.getMainPageRecommendVideos(fresh_type, home_vid_count);
      this.recommend_vids.splice(0, this.recommend_vids.length, ...vids);
    } catch (error) {
      global.logger.error("获取推荐视频时出错:", error);
      prompt.showToast({ message: "获取推荐视频失败，请重试。" });
    } finally {
      this.anims.loading.stop();
      this.anims.show_loading = false;
      this.show_recommend_div = true;
    }
  },
  async checkUpdates() {
    try {
      const result = await global.biliclient.checkHyperbilibiliUpdates();
      if (result.update) {
        prompt.showToast({ message: result.msg, duration: 6000 });
      }
    } catch (error) {
      global.logger.error("检查更新时出错:", error);
    }
  },
  SyncPlayStatus() {
    const status = global.playStatus;
    if (!status) {
      this.popupVisible = false;
      this.showVolume = false;
      return;
    }
    const visible = !!status.popupOpen && !!status.hasTrack;
    const chargeVisible = !!status.chargePopupOpen && !!status.charging;

    if (!visible) {
      this.showVolume = false;
    }
    this.popupVisible = visible;
    this.chargeVisible = chargeVisible;
    this.chargePercent = typeof status.batteryPercent === "number" ? status.batteryPercent : 0;

    // 充电弹层在上，播放弹层在下，音量面板再往下，互不遮挡
    const both = visible && chargeVisible;
    this.playStyle["top"] = both ? "156px" : "60px";
    this.volumeStyle["top"] = both ? "252px" : "156px";

    this.popupPlaying = !!status.playing;
    this.popupTitle = status.title || "正在播放";

    let cover = status.cover || "";
    if (cover.indexOf("//") === 0) {
      cover = "https:" + cover;
    } else if (cover.indexOf("http://") === 0) {
      cover = "https://" + cover.substring(7);
    }
    if (!cover) {
      this.popupCover = "";
    } else if (cover.indexOf("internal://") === 0 || cover.indexOf("@") >= 0) {
      this.popupCover = cover;
    } else {
      this.popupCover = cover + "@160w_160h";
    }
  },
  ClosePopups() {
    const status = global.playStatus;
    if (status) {
      status.popupOpen = false;
      status.chargePopupOpen = false;
    }
    this.popupVisible = false;
    this.chargeVisible = false;
    this.showVolume = false;
  },
  StopPropagation(e) {
    if (e && e.stopPropagation) e.stopPropagation();
  },
  TogglePlay() {
    const status = global.playStatus;
    if (!status) return;
    if (!audio.src) {
      prompt.showToast({ message: "当前没有可播放的音频" });
      return;
    }
    if (status.playing) {
      audio.pause();
      status.playing = false;
      this.popupPlaying = false;
      this.SyncStoredPlaying(false);
    } else {
      audio.play();
      status.playing = true;
      this.popupPlaying = true;
      this.SyncStoredPlaying(true);
    }
  },
  // 同步播放页的持久化状态，避免重新进入播放页时自动恢复成错误状态
  SyncStoredPlaying(playing) {
    storage.get({
      key: "playerState",
      success: (data) => {
        if (!data) return;
        try {
          const state = JSON.parse(data);
          state.isPlaying = playing;
          if (audio.duration > 0) {
            state.progress = (audio.currentTime / audio.duration) * 100;
          }
          storage.set({
            key: "playerState",
            value: JSON.stringify(state)
          });
        } catch (e) {}
      },
      fail: () => {}
    });
  },
  ToggleVolume() {
    this.showVolume = !this.showVolume;
    if (this.showVolume) {
      this.RefreshVolume();
    }
  },
  RefreshVolume() {
    audio.getPlayState({
      success: (state) => {
        this.volumePercent = Math.round((state.volume || 0) * 100);
      },
      fail: () => {
        this.volumePercent = 50;
      }
    });
  },
  OnVolumeChange(e) {
    const value = Math.max(0, Math.min(100, Math.round(e.progress)));
    this.volumePercent = value;
    audio.volume = value / 100;
    if (global.playStatus) {
      global.playStatus.volume = value;
    }
  },
  onInit() {
    this.GetVids();
    this.funnytip = this.$app.$def.funnytips.getTips();
    this.checkUpdates();
    this.SyncPlayStatus();
    this.popupTimer = setInterval(() => {
      this.SyncPlayStatus();
    }, 200);
  },
  onReady() {
    const { refresh_bottom } = this.anims;

    global.animengine.defaults.loading.CreateLoadingAnimation(this);
    this.anims.loading.start();

    this.anims.refresh = new global.animengine.DomAnim(
      "mainPage",
      { value: "0px" },
      refresh_bottom,
      0,
      450,
      1000
    );
  },
  onDestroy() {
    global.animengine.clearPageAnims("mainPage");
    if (this._timerRefreshStart) {
      clearTimeout(this._timerRefreshStart);
      this._timerRefreshStart = null;
    }
    if (this._timerRefreshStop) {
      clearTimeout(this._timerRefreshStop);
      this._timerRefreshStop = null;
    }
    if (this.popupTimer) {
      clearInterval(this.popupTimer);
      this.popupTimer = null;
    }
  }
}
</script>

<style lang="less">
@import '@less/global.less';
@import './main.less';
</style>