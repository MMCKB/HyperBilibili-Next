<import name="title-bar" src="@components/TitleBar/TitleBar.ux"></import>
<import name="user-info" src="@components/UserInfo/UserInfo.ux"></import>
<import name="online-image" src="@components/BetterOnlineImage/BetterOnlineImage.ux"></import>
<import name="default-button" src="@components/DefaultButton/DefaultButton.ux"></import>

<template>
  <div class="page">
    <scroll scroll-y="true" class="scroll {{scrclass}}" bounces="true">
      <title-bar title="user.title"></title-bar>
      <user-info account-info="{{user}}" stat="{{stat}}" if="{{loaded}}" @viewfollowings="GoFollowings" @viewfollowers="GoFollowers"></user-info>
      <div class="followbtn-wrap" if="{{loaded && !isSelf}}">
        <div class="followbtn {{followed ? 'followbtn-on' : ''}}" @click="ToggleFollow">
          <text class="followbtn-text">{{ $t(followBtnKey) }}</text>
        </div>
      </div>
      <div class="ctxcard" style="margin-top: 25px" if="{{loaded}}" @click="GoUserVideos">
        <div class="ctxdesc">
          <div style="width: 290px;">
            <text class="desctxt">{{ $t("user.videos") }}</text>
            <text class="desctxt gs" style="margin-left: 15px">{{navnum.video}}</text>
          </div>
          <text class="desctxt gs">></text>
        </div>
        <scroll class="mp-scroll" scroll-x="true">
          <div if="{{masterpiece.length > 0}}" class="mp">
            <online-image for="{{masterpiece}}" src="{{$item.pic}}@90h" style="padding-right: 10px"></online-image>
          </div>
        </scroll>
      </div>
      <div class="ctxcard" style="margin-top: 10px" if="{{loaded}}" @click="GoUserDynamics">
        <div class="ctxdesc">
          <div style="width: 290px;">
            <text class="desctxt">{{ $t("user.dynamices") }}</text>
            <text class="desctxt gs" style="margin-left: 15px">{{dynamiclist.items.length}}+</text>
          </div>
          <text class="desctxt gs">></text>
        </div>
      </div>
      <default-button @click="GoDMPage" if="{{loaded}}" margin-top="25px" primary="true" text="user.senddm"></default-button>
      <text style="margin-top: 30px"></text>
    </scroll>
    <image style="position: absolute; margin-top: 245px" if="{{anims.show_loading}}" src="{{anims.loading_src.value}}"></image>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"

export default {
  public: {
    uid: 1
  },
  private: {
    user: {},
    stat: {},
    navnum: {},
    masterpiece: {},
    dynamiclist: {},
    followed: false,
    followBtnKey: "user.follow",
    isSelf: false,
    followBusy: false,
    anims: {
      show_loading: false
    },
    loaded: false,
    scrclass: ""
  },
  async LoadUserInfo(){
    this.anims.loading.start()

    this.user = await global.biliclient.getUserInfoByUID(this.uid)
    const stat = await global.biliclient.getUserStatByUID(this.uid)
    // 获赞数单独取：直接改 stat 的属性不会触发子组件 watcher，必须整体替换对象
    let likes = 0
    try{
      const upstat = await global.biliclient.getUserUpstatByUID(this.uid)
      likes = (upstat && upstat.likes) ? upstat.likes : 0
    }catch(e){
      global.logger.error("load upstat failed:", e.toString())
    }
    this.stat = { ...stat, likes: likes }
    this.navnum = await global.biliclient.getUserNavnumByUID(this.uid)
    this.masterpiece = await global.biliclient.getUserMasterPieceByUID(this.uid)
    this.dynamiclist = await global.biliclient.getUserDynamicListByUID(this.uid)

    // 判断是否为自己
    const myUid = global.biliclient.accountInfo.mid
    this.isSelf = (this.uid.toString() === myUid.toString())

    // 通过专用关系接口查询关注状态（比 user.relation 字段更可靠）
    // attribute: 0=未关注 2=已关注 6=互粉 128=已拉黑
    if (!this.isSelf) {
      try {
        const relation = await global.biliclient.getRelation(this.uid)
        const attr = relation ? relation.attribute : 0
        this.followed = (attr === 2 || attr === 6)
      } catch (e) {
        global.logger.error("getRelation failed:", e.toString())
        this.followed = false
      }
      this.followBtnKey = this.followed ? "user.followed" : "user.follow"
    }

    this.anims.loading.stop()
    this.anims.show_loading = false
    this.loaded = true
  },
  async ToggleFollow(){
    if(this.followBusy){
      return
    }
    this.followBusy = true
    try{
      const act = this.followed ? 2 : 1
      const resp = await global.biliclient.modifyRelation(this.uid, act)
      if(resp && resp.code === 0){
        this.followed = !this.followed
        this.followBtnKey = this.followed ? "user.followed" : "user.follow"
        prompt.showToast({
          message: this.followed ? this.$t("user.followSuccess") : this.$t("user.unfollowSuccess"),
          duration: 1500
        })
        // 刷新粉丝统计（同样整体替换对象以触发子组件更新）
        try{
          const stat2 = await global.biliclient.getUserStatByUID(this.uid)
          let likes2 = 0
          try{
            const upstat2 = await global.biliclient.getUserUpstatByUID(this.uid)
            likes2 = (upstat2 && upstat2.likes) ? upstat2.likes : 0
          }catch(e2){
            global.logger.error("refresh upstat failed:", e2.toString())
          }
          this.stat = { ...stat2, likes: likes2 }
        }catch(e){
          global.logger.error("refresh stat failed:", e.toString())
        }
      }else{
        prompt.showToast({
          message: this.$t("user.followFailed"),
          duration: 1500
        })
      }
    }catch(error){
      global.logger.error("ToggleFollow error:", error.toString())
      prompt.showToast({
        message: this.$t("user.followFailed"),
        duration: 1500
      })
    }
    this.followBusy = false
  },
  GoUserVideos(){
    router.push({
      uri: "pages/user/uservideos",
      params: {
        uid: this.uid
      }
    })
  },
  GoDMPage(){
    router.push({
      uri: "pages/message/dmpage",
      params: {
        myId: global.biliclient.accountInfo.mid,
        targetId: this.uid,
        myPic: global.biliclient.accountInfo.face,
        targetPic: this.user.face
      }
    })
  },
  GoUserDynamics(){
    router.push({
      uri: "pages/user/userdynamic",
      params: {
        uid: this.uid
      }
    })
  },
  GoFollowings(){
    router.push({
      uri: "pages/user/userlist",
      params: {
        uid: this.uid,
        type: "followings"
      }
    })
  },
  GoFollowers(){
    router.push({
      uri: "pages/user/userlist",
      params: {
        uid: this.uid,
        type: "followers"
      }
    })
  },
  onInit(){
    global.animengine.defaults.loading.CreateLoadingAnimation(this)
    this.LoadUserInfo()
  }
}
</script>

<style lang="less">
@import '@less/global.less';
@import './user.less';
</style>